PORT=8080
siteAddress=http://localhost:8080
TZ=Australia/Sydney

discordAPIKey=APIKEY
discordClientId=CLIENTID
discordClientSecret=CLIENTSECRET
# Credential this app presents when calling its own API. Create a client named
# `zander-web-internal` at /dashboard/apikeys and paste its key here. Give it
# the scopes for the API areas the site calls itself (in practice every scope
# except `compass`, which is only for the Compass bot).
INTERNAL_API_KEY=zdr_xxxxxxxx_...

# Twitch OAuth — register at https://dev.twitch.tv/console/apps
twitchClientId=CLIENTID
twitchClientSecret=CLIENTSECRET

# Google/YouTube OAuth & API — register at https://console.cloud.google.com
# OAuth 2.0 client: Web application, redirect URI = siteAddress/profile/social/youtube/callback
# Enable: YouTube Data API v3
googleClientId=CLIENTID
googleClientSecret=CLIENTSECRET
youtubeApiKey=APIKEY

# Signs the session cookie. Generate your own, e.g. `openssl rand -hex 32`;
# the app refuses to start with a short or well-known value.
sessionCookieSecret=
# Leave UNSET on an https deployment (Render, etc.): the app then trusts the
# platform proxy, so the session cookie is issued and req.ip is the real client.
# A numeric hop count can make the app think requests are plain http, which
# stops the Secure session cookie being set and breaks every login. Only set an
# exact integer if your proxy chain is fixed and the boot log shows
# protocol=https with it.
# TRUST_PROXY_HOPS=

DATABASE_URL=mysql://root:root@database.example.com:3306/zander
LUCKPERMS_URL=mysql://luckperms-user:password@luckperms.example.com:3306/luckperms
QUICKSHOP_URL=mysql://quickshop-user:password@quickshop.example.com:3306/quickshop
PUNISHMENTS_URL=mysql://litebans-user:password@litebans.example.com:3306/litebans

# ── Compass SSO (Zander as an OIDC provider) ─────────────────────────────────
# Issuer identifier. Defaults to siteAddress + /oidc if unset.
OIDC_ISSUER=
# Signing keys (JWKS JSON with a private key). Generate with:
#   node scripts/generate-oidc-jwks.mjs
# Leave blank in local dev to use an ephemeral key (tokens drop on restart).
OIDC_JWKS=
# The Compass OAuth client. Redirect URIs are comma-separated absolute URLs.
OIDC_COMPASS_CLIENT_ID=compass
OIDC_COMPASS_CLIENT_SECRET=
OIDC_COMPASS_REDIRECT_URIS=https://compass.example.com/auth/callback
OIDC_COMPASS_POST_LOGOUT_URIS=https://compass.example.com/

# ── Email (SMTP) ────────────────────────────────────────────────────────────
smtpHost=smtp.example.com
smtpPort=587
smtpSecure=false
smtpRequireTLS=true
smtpUser=
smtpPass=
smtpIdentityDisplayName=Zander
smtpIdentityEmailAddress=noreply@example.com

# Web Push (VAPID) — generate keys with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Stripe — obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret — from the Stripe dashboard webhook endpoint config
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly server goal in cents (e.g. 5000 = $50.00)
WEBSTORE_MONTHLY_GOAL_CENTS=5000

# Cloudinary — register at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry — error/performance monitoring. Leave blank to disable.
SENTRY_DSN=

# ── MineMonitor ─────────────────────────────────────────────────────────────
# Connection token from MineMonitor's Connections page. Scopes:
#   wrapped.read  — Wrapped's Discord/voice/reputation slides
#   filter.check  — the text filter for profiles and proxy chat (api/routes/filter.js)
# Leave blank to disable both (Wrapped still builds from Zander data alone;
# text filtering is off). The base URL can also be set in Settings → Automation.
MINEMONITOR_BASE_URL=https://minemonitor.example.com
MINEMONITOR_CONNECTION_TOKEN=

# ── Credential Vault ────────────────────────────────────────────────────────
# Key-encryption keys for the credential vault: comma-separated id:base64 pairs,
# each exactly 32 bytes. Generate one with `node admin/credential-vault.mjs keygen`.
# Keep an offline escrow copy: losing every copy of a key loses every secret it
# protects. Leave blank and the vault stays unavailable. Never commit real keys.
# See docs/credential-vault-architecture.md for rotation.
CREDENTIAL_VAULT_KEKS=
# The id (from CREDENTIAL_VAULT_KEKS) that new data keys are wrapped with.
CREDENTIAL_VAULT_ACTIVE_KEK=
