PORT=8080
siteAddress=http://localhost:8080
TZ=Australia/Sydney

discordAPIKey=APIKEY
discordClientId=CLIENTID
discordClientSecret=CLIENTSECRET
apiKey=KEY

# Twitch OAuth — register at https://dev.twitch.tv/console/apps
twitchClientId=CLIENTID
twitchClientSecret=CLIENTSECRET

# Google/YouTube OAuth & API — register at https://console.cloud.google.com
# OAuth 2.0 client: Web application, redirect URI = siteAddress/profile/social/youtube/callback
# Enable: YouTube Data API v3
googleClientId=CLIENTID
googleClientSecret=CLIENTSECRET
youtubeApiKey=APIKEY

sessionCookieSecret=THISISNOTVERYSECRETANDITHINKYOUSHOULDCHANGEIT

DATABASE_URL=mysql://root:root@database.example.com:3306/zander
LUCKPERMS_URL=mysql://luckperms-user:password@luckperms.example.com:3306/luckperms
QUICKSHOP_URL=mysql://quickshop-user:password@quickshop.example.com:3306/quickshop
PUNISHMENTS_URL=mysql://litebans-user:password@litebans.example.com:3306/litebans

# ── Email (SMTP) ────────────────────────────────────────────────────────────
smtpHost=smtp.example.com
smtpPort=587
smtpSecure=false
smtpRequireTLS=true
smtpUser=
smtpPass=
smtpIdentityDisplayName=Zander
smtpIdentityEmailAddress=noreply@example.com

# Global error alerts — every console.error / console.warn, uncaught exception,
# unhandled rejection and Fastify 5xx is emailed here. Leave adminErrorEmail
# blank to disable. Requires smtpHost above.
adminErrorEmail=
errorEmailLevels=error,warn
errorEmailCooldownMinutes=15
errorEmailHourlyCap=30
# Comma-separated substrings; a match anywhere in the message suppresses the
# email. Node DeprecationWarning/ExperimentalWarning/FSTDEP notices are always
# ignored; this list is added on top.
errorEmailIgnore=

# Web Push (VAPID) — generate keys with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Stripe — obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret — from the Stripe dashboard webhook endpoint config
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly server goal in cents (e.g. 5000 = $50.00)
WEBSTORE_MONTHLY_GOAL_CENTS=5000

# ── Mixed module ────────────────────────────────────────────────────────────
# The zander-pgm plugin authenticates using the app-wide apiKey above — no
# separate Mixed plugin token is needed.
# Stripe Price IDs for the Map Token store products (create these in Stripe).
STRIPE_PRICE_MAP_TOKEN_1=price_...
STRIPE_PRICE_MAP_TOKEN_5=price_...
STRIPE_PRICE_MAP_TOKEN_10=price_...
STRIPE_PRICE_SUPPORTER_MONTHLY=price_...

# Cloudinary — register at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry — error/performance monitoring. Leave blank to disable.
SENTRY_DSN=

# ── Wrapped (MineMonitor) ──────────────────────────────────────────────────
# Read-only MineMonitor API for the Discord/voice/reputation slides. Leave the
# token blank to disable — Wrapped still builds from Zander data alone.
MINEMONITOR_BASE_URL=https://minemonitor.example.com
MINEMONITOR_CONNECTION_TOKEN=
# Optional: how start/end are sent — date (YYYY-MM-DD, default) | iso | epoch | epochms
MINEMONITOR_DATE_FORMAT=date
