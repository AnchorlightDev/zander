// =============================================================================
// Prisma Schema for Zander Web — Minecraft Community Website
// Database: MySQL (utf8mb4)
// =============================================================================
//
// NOTE: The following cross-database views are NOT modeled here because they
// reference external databases and cannot be represented in Prisma models:
//   - luckPermsPlayers
//   - ranks
//   - userRanks
//   - userPermissions
//   - rankRanks
//   - rankPermissions
//   - punishments
//   - shoppingDirectory
//
// These must be accessed via prisma.$queryRawUnsafe() at the application layer.
//
// NOTE: Set DATABASE_URL in .env as a full MySQL connection string:
//   mysql://USER:PASSWORD@HOST:PORT/DATABASE
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum users_profilePicture_type {
  CRAFTATAR
  GRAVATAR
}

enum servers_serverType {
  INTERNAL
  EXTERNAL
  VERIFICATION
}

enum announcements_type {
  motd
  tip
  web
  popup
}

enum scheduledDiscordMessages_status {
  scheduled
  sent
  failed
}

enum discord_punishments_type {
  WARN
  DISCORD_KICK
  TEMP_BAN
  PERM_BAN
  TEMP_MUTE
  PERM_MUTE
}

enum discord_punishments_status {
  ACTIVE
  EXPIRED
  LIFTED
  APPEALED
  APPEAL_PENDING
  APPEAL_REJECTED
}

enum discord_punishments_dm_status {
  SENT
  FAILED_CLOSED_DMS
  FAILED_UNKNOWN
  NOT_APPLICABLE
}

enum discord_punishment_appeals_status {
  PENDING
  APPROVED
  REJECTED
}

enum player_command_queue_execute_as {
  console
  player
}

enum player_command_queue_status {
  pending
  claimed
  completed
  failed
}

enum supportTickets_status {
  open
  closed
  in_progress @map("in-progress")
}

// =============================================================================
// Models
// =============================================================================

model users {
  userId                       Int                        @id @default(autoincrement())
  uuid                         String                     @unique @db.VarChar(36)
  username                     String                     @db.VarChar(16)
  discordId                    String?                    @db.VarChar(32)
  email                        String?                    @unique @db.VarChar(254)
  password_hash                String?                    @db.VarChar(255)
  email_verified               Boolean                    @default(false)
  email_verified_at            DateTime?
  joined                       DateTime                   @default(now())
  profilePicture_type          users_profilePicture_type? @default(CRAFTATAR)
  profilePicture_email         String?                    @db.VarChar(70)
  account_registered           DateTime?
  account_disabled             Boolean                    @default(false)
  is_placeholder               Boolean                    @default(false)
  social_aboutMe               String?                    @db.MediumText
  social_interests             String?                    @db.VarChar(50)
  social_discord               String?                    @db.VarChar(32)
  social_steam                 String?                    @db.VarChar(100)
  social_twitch                String?                    @db.VarChar(25)
  social_youtube               String?                    @db.VarChar(100)
  social_twitter_x             String?                    @db.VarChar(15)
  social_instagram             String?                    @db.VarChar(30)
  social_reddit                String?                    @db.VarChar(38)
  social_spotify               String?                    @db.VarChar(100)
  audit_lastDiscordMessage     DateTime?
  audit_lastDiscordVoice       DateTime?
  audit_lastMinecraftLogin     DateTime?
  audit_lastMinecraftMessage   DateTime?
  audit_lastMinecraftPunishment DateTime?
  audit_lastDiscordPunishment  DateTime?
  audit_lastWebsiteLogin       DateTime?

  /// IANA zone name. Decides which day "today" is for this user.
  timezone                     String?                    @db.VarChar(64)
  /// Day and month only -- deliberately no year. See 0058.
  birthdayDay                  Int?                       @db.UnsignedTinyInt
  birthdayMonth                Int?                       @db.UnsignedTinyInt
  /// Local year the birthday rank last fired, so the hourly job grants once.
  birthdayLastGrantedYear      Int?                       @db.UnsignedSmallInt

  emailVerifications           userEmailVerifications[]
  passwordResets               userPasswordResets[]

  @@index([username])
  @@index([discordId])
  @@index([birthdayMonth, birthdayDay], map: "users_birthday_idx")
}

model userEmailVerifications {
  verificationId Int      @id @default(autoincrement())
  userId         Int
  codeHash       String   @db.VarChar(255)
  expiresAt      DateTime
  consumed       Boolean  @default(false)
  createdAt      DateTime @default(now())
  consumedAt     DateTime?

  user           users    @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model userPasswordResets {
  resetId    Int      @id @default(autoincrement())
  userId     Int
  codeHash   String   @db.VarChar(255)
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  consumedAt DateTime?

  user       users    @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model userVerifyLink {
  verifyId   Int       @id @default(autoincrement())
  uuid       String    @unique @db.VarChar(36)
  username   String    @db.Text
  linkCode   String?   @db.VarChar(6)
  codeExpiry DateTime
}

model forumCategories {
  categoryId       Int               @id @default(autoincrement())
  parentCategoryId Int?
  name             String            @db.VarChar(120)
  slug             String            @unique @db.VarChar(150)
  description      String?           @db.Text
  position         Int               @default(0)
  viewPermission   String?           @db.VarChar(150)
  postPermission   String?           @db.VarChar(150)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  parent           forumCategories?  @relation("CategoryChildren", fields: [parentCategoryId], references: [categoryId], onDelete: SetNull)
  children         forumCategories[] @relation("CategoryChildren")
  discussions      forumDiscussions[]
}

model forumDiscussions {
  discussionId Int             @id @default(autoincrement())
  categoryId   Int
  title        String          @db.VarChar(200)
  slug         String          @db.VarChar(200)
  createdBy    Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lastPostAt   DateTime        @default(now())
  lastPostBy   Int?
  isLocked     Int             @default(0) @db.TinyInt
  isSticky     Int             @default(0) @db.TinyInt
  isArchived   Int             @default(0) @db.TinyInt

  category     forumCategories @relation(fields: [categoryId], references: [categoryId])
  posts        forumPosts[]
  poll         forumPolls?

  @@unique([categoryId, slug])
}

model forumPosts {
  postId       Int                  @id @default(autoincrement())
  discussionId Int
  parentPostId Int?
  userId       Int
  replyToPostId Int?
  content      String               @db.MediumText
  isOriginal   Int                  @default(0) @db.TinyInt
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  discussion   forumDiscussions     @relation(fields: [discussionId], references: [discussionId])
  parentPost   forumPosts?          @relation("PostReplies", fields: [parentPostId], references: [postId])
  replies      forumPosts[]         @relation("PostReplies")
  revisions    forumPostRevisions[]
  replyToPost  forumPosts?          @relation("ForumPostReplies", fields: [replyToPostId], references: [postId], onDelete: SetNull)
  replyToReplies forumPosts[]       @relation("ForumPostReplies")

  @@index([replyToPostId])
}

model forumPostRevisions {
  revisionId      Int      @id @default(autoincrement())
  postId          Int
  editorId        Int?
  previousContent String   @db.MediumText
  createdAt       DateTime @default(now())

  post            forumPosts @relation(fields: [postId], references: [postId])
}

model forumPolls {
  pollId          Int               @id @default(autoincrement())
  discussionId    Int               @unique
  question        String            @db.VarChar(500)
  allowMultiple   Boolean           @default(false)
  allowVoteChange Boolean           @default(false)
  showVoters      Boolean           @default(false)
  expiresAt       DateTime?
  createdByUserId Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  discussion      forumDiscussions  @relation(fields: [discussionId], references: [discussionId], onDelete: Cascade)
  options         forumPollOptions[]
  votes           forumPollVotes[]
}

model forumPollOptions {
  optionId    Int              @id @default(autoincrement())
  pollId      Int
  label       String           @db.VarChar(300)
  imageUrl    String?          @db.VarChar(2000)
  orderIndex  Int              @default(0)
  createdAt   DateTime         @default(now())

  poll        forumPolls       @relation(fields: [pollId], references: [pollId], onDelete: Cascade)
  votes       forumPollVotes[]

  @@index([pollId])
}

model forumPollVotes {
  voteId    Int              @id @default(autoincrement())
  pollId    Int
  optionId  Int
  userId    Int
  createdAt DateTime         @default(now())

  poll      forumPolls       @relation(fields: [pollId], references: [pollId], onDelete: Cascade)
  option    forumPollOptions @relation(fields: [optionId], references: [optionId], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
  @@index([pollId, userId])
}

model servers {
  serverId              Int                 @id @default(autoincrement())
  displayName           String?             @db.Text
  serverConnectionAddress String?           @db.Text
  serverType            servers_serverType?
  position              Int?
}

model serverStatus {
  serverStatusId Int       @id @default(autoincrement())
  statusInfo     Json?
  lastUpdated    DateTime?
}

model gameSessions {
  sessionId    Int       @id @default(autoincrement())
  userId       Int
  sessionStart DateTime  @default(now())
  sessionEnd   DateTime?
  ipAddress    String?   @db.VarChar(45)
  server       String?   @db.Text
}

model announcements {
  announcementId     Int                  @id @default(autoincrement())
  /// NULL for rows that predate 0057_announcement_created_at; see that migration.
  createdAt          DateTime?
  enabled            Boolean              @default(true)
  announcementType   announcements_type?
  body               String?              @db.Text
  colourMessageFormat String?             @db.Text
  link               String?              @db.Text
  popupButtonText    String?              @db.VarChar(60)
  popupImageUrl      String?              @db.Text
  startDate          DateTime?
  endDate            DateTime?
  updatedDate        DateTime?
}

model scheduledDiscordMessages {
  scheduleId        Int                             @id @default(autoincrement())
  channelId         String                          @db.VarChar(50)
  embedTitle        String?                         @db.VarChar(255)
  embedDescription  String?                         @db.Text
  embedColor        String?                         @db.VarChar(20)
  scheduledFor      DateTime
  createdBy         Int
  createdAt         DateTime                        @default(now())
  sentAt            DateTime?
  status            scheduledDiscordMessages_status @default(scheduled)
  lastError         String?                         @db.Text
}

model applications {
  applicationId        Int     @id @default(autoincrement())
  displayName          String? @db.VarChar(30)
  description          String? @db.Text
  displayIcon          String? @db.VarChar(40)
  requirementsMarkdown String? @db.Text
  redirectUrl          String? @db.Text
  position             Int?
  applicationStatus    Boolean @default(false)
  applicationType      String  @default("external") @db.VarChar(20)
  linkedFormId         Int?

  linkedForm           forms?  @relation(fields: [linkedFormId], references: [formId], onDelete: SetNull)

  @@index([linkedFormId], map: "applications_linkedFormId_fkey")
}

model forms {
  formId           Int      @id @default(autoincrement())
  name             String   @db.VarChar(100)
  slug             String   @unique(map: "forms_slug_key") @db.VarChar(100)
  description      String?  @db.Text
  status           Boolean  @default(false)
  successMessage   String?  @db.Text
  discordChannelId String?  @db.VarChar(255)
  discordForumChannelId String? @db.VarChar(255)
  notifyDiscordUserIds  Json?
  allowMultiple    Boolean  @default(false)
  requiresReview   Boolean  @default(true)
  accessCode          String?  @db.VarChar(190)
  requirements        Json?
  useGlobalRequirements Boolean @default(false)
  reapplyCooldownDays Int?
  createTicket     Boolean  @default(false)
  ticketCategoryId Int?
  ticketPendingMessage  String? @db.Text
  ticketApprovedMessage String? @db.Text
  ticketDeniedMessage   String? @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  fields           formFields[]
  submissions      formSubmissions[]
  drafts           formDrafts[]
  applications     applications[]
  ticketCategory   supportTicketCategories? @relation(fields: [ticketCategoryId], references: [categoryId], onDelete: SetNull)

  @@index([ticketCategoryId], map: "forms_ticketCategoryId_fkey")
}

model formFields {
  fieldId     Int     @id @default(autoincrement())
  formId      Int
  label       String  @db.VarChar(255)
  fieldKey    String  @db.VarChar(64)
  fieldType   String  @default("text") @db.VarChar(32)
  placeholder String? @db.VarChar(255)
  helpText    String? @db.Text
  options     Json?
  isRequired  Boolean @default(false)
  maxLength   Int?
  config      Json?
  position    Int     @default(0)

  form        forms   @relation(fields: [formId], references: [formId], onDelete: Cascade)

  @@unique([formId, fieldKey], map: "formFields_formId_fieldKey_key")
  @@index([formId, position], map: "formFields_formId_position_idx")
}

/// Autosaved, unsubmitted answers -- one row per person per form, overwritten
/// in place and deleted once the form is actually submitted.
model formDrafts {
  draftId   Int      @id @default(autoincrement())
  formId    Int
  userId    Int
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  form      forms    @relation(fields: [formId], references: [formId], onDelete: Cascade)

  @@unique([formId, userId], map: "formDrafts_formId_userId_key")
  @@index([userId], map: "formDrafts_userId_idx")
}

model formSubmissions {
  submissionId     Int       @id @default(autoincrement())
  formId           Int
  userId           Int
  status           String    @default("pending") @db.VarChar(16)
  answers          Json
  reviewedBy       Int?
  reviewNotes      String?   @db.Text
  commentIsPublic  Boolean   @default(false)
  reviewedAt       DateTime?
  discordMessageId String?   @db.VarChar(255)
  discordThreadId  String?   @db.VarChar(255)
  ticketId         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  form             forms           @relation(fields: [formId], references: [formId], onDelete: Cascade)
  ticket           supportTickets? @relation(fields: [ticketId], references: [ticketId], onDelete: SetNull)

  @@index([ticketId], map: "formSubmissions_ticketId_idx")

  @@index([formId, status], map: "formSubmissions_formId_status_idx")
  @@index([userId], map: "formSubmissions_userId_idx")
}

/// Daily Discord message counts. A rollup, not a message log: no content and
/// no per-message timestamps are kept -- see 0050_discord_activity_daily.
model discordActivityDaily {
  id            Int      @id @default(autoincrement())
  discordUserId String   @db.VarChar(24)
  activityDate  DateTime @db.Date
  messageCount  Int      @default(0)

  @@unique([discordUserId, activityDate], map: "discordActivityDaily_user_date_key")
  @@index([discordUserId, activityDate], map: "discordActivityDaily_user_date_idx")
}

/// Generic site-wide settings, one JSON value per named key. See
/// 0056_site_settings_and_global_requirements.
model siteSettings {
  settingKey   String   @id @db.VarChar(100)
  settingValue Json?
  updatedAt    DateTime @default(now()) @updatedAt
}

model reports {
  reportId              Int      @id @default(autoincrement())
  reporterId            Int
  reportedUser          String   @db.VarChar(30)
  reportReason          String   @db.VarChar(100)
  reportReasonEvidence  String?  @db.MediumText
  reportPlatform        String   @db.VarChar(10)
  reportDateTime        DateTime @default(now())
}

model vault {
  vaultId     Int     @id @default(autoincrement())
  displayName String? @db.VarChar(30)
  description String? @db.MediumText
  redirectUrl String? @db.Text
  position    Int?
}

model bridge {
  bridgeId       Int      @id @default(autoincrement())
  command        String?  @db.Text
  targetServer   String?  @db.VarChar(30)
  processed      Boolean  @default(false)
  bridgeDateTime DateTime @default(now())
}

model executorTasks {
  executorTaskId Int       @id @default(autoincrement())
  slug           String    @db.VarChar(64)
  command        String    @db.Text
  status         String    @default("pending") @db.VarChar(16)
  routineSlug    String?   @db.VarChar(64)
  metadata       String?   @db.Text
  result         String?   @db.Text
  priority       Int       @default(0)
  executedBy     String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  processedAt    DateTime?
}

model executorRoutines {
  executorRoutineId Int                    @id @default(autoincrement())
  routineSlug       String                 @unique @db.VarChar(64)
  displayName       String?                @db.VarChar(120)
  description       String?                @db.Text
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  steps             executorRoutineSteps[]
}

model executorRoutineSteps {
  executorRoutineStepId Int              @id @default(autoincrement())
  executorRoutineId     Int
  stepOrder             Int              @default(0)
  slug                  String           @db.VarChar(64)
  command               String           @db.Text
  metadata              String?          @db.Text
  createdAt             DateTime         @default(now())

  routine               executorRoutines @relation(fields: [executorRoutineId], references: [executorRoutineId])
}

model logs {
  logId           Int      @id @default(autoincrement())
  creatorId       Int
  logFeature      String?  @db.VarChar(30)
  logType         String?  @db.VarChar(30)
  description     String?  @db.Text
  actionedDateTime DateTime @default(now())
}

model discord_punishments {
  id                     Int                            @id @default(autoincrement())
  type                   discord_punishments_type
  platform               String                         @default("DISCORD") @db.VarChar(16)
  target_discord_user_id String?                        @db.VarChar(24)
  target_discord_tag     String?                        @db.VarChar(100)
  target_player_id       Int?
  actor_discord_user_id  String?                        @db.VarChar(24)
  actor_player_id        Int?
  actor_name_snapshot    String?                        @db.VarChar(100)
  reason                 String                         @db.Text
  created_at             DateTime                       @default(now())
  expires_at             DateTime?
  lifted_at              DateTime?
  status                 discord_punishments_status     @default(ACTIVE)
  appeal_id              Int?
  context                Json?
  dm_status              discord_punishments_dm_status  @default(NOT_APPLICABLE)

  appeals                discord_punishment_appeals[]
}

model discord_punishment_appeals {
  id                     Int                                @id @default(autoincrement())
  punishment_id          Int
  discord_user_id        String                             @db.VarChar(24)
  appeal_reason          String                             @db.Text
  status                 discord_punishment_appeals_status  @default(PENDING)
  reviewer_discord_user_id String?                          @db.VarChar(24)
  reviewer_notes         String?                            @db.Text
  created_at             DateTime                           @default(now())
  reviewed_at            DateTime?

  punishment             discord_punishments                @relation(fields: [punishment_id], references: [id], onDelete: Cascade)
}

model user_platform_connections {
  id                     Int       @id @default(autoincrement()) @db.UnsignedInt
  user_id                Int
  platform               String    @db.VarChar(32)
  platform_account_id    String    @db.VarChar(128)
  platform_channel_id    String?   @db.VarChar(128)
  platform_username      String?   @db.VarChar(128)
  platform_display_name  String?   @db.VarChar(128)
  avatar_url             String?   @db.VarChar(512)
  access_token           String?   @db.Text
  refresh_token          String?   @db.Text
  token_expires_at       DateTime?
  is_active              Int       @default(1) @db.TinyInt
  last_successful_sync_at DateTime?
  last_sync_error        String?   @db.VarChar(255)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  @@unique([user_id, platform])
}

model creator_content_items {
  id                   Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id              Int
  platform             String   @db.VarChar(32)
  external_content_id  String   @db.VarChar(128)
  external_channel_id  String?  @db.VarChar(128)
  content_type         String   @db.VarChar(32)
  title                String?  @db.VarChar(512)
  description          String?  @db.Text
  thumbnail_url        String?  @db.VarChar(512)
  watch_url            String?  @db.VarChar(512)
  viewer_count         Int?     @db.UnsignedInt
  tags_json            String?  @db.Text
  is_live              Int      @default(0) @db.TinyInt
  published_at         DateTime?
  started_at           DateTime?
  ended_at             DateTime?
  matched_rule         String?  @db.VarChar(128)
  is_cfc_related       Int      @default(0) @db.TinyInt
  is_publicly_visible  Int      @default(0) @db.TinyInt
  last_seen_at         DateTime @default(now())
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@unique([platform, external_content_id])
}

model creator_content_notifications {
  id                   Int      @id @default(autoincrement()) @db.UnsignedInt
  platform             String   @db.VarChar(32)
  external_content_id  String   @db.VarChar(128)
  notification_type    String   @db.VarChar(64)
  discord_message_id   String?  @db.VarChar(32)
  created_at           DateTime @default(now())

  @@unique([platform, external_content_id, notification_type])
}

/// Session store table used by @quixo3/prisma-session-store
model session {
  id        String   @id @db.VarChar(128)
  sid       String   @unique @db.VarChar(128)
  data      String   @db.MediumText
  expiresAt DateTime

  @@map("sessions")
}

model player_command_queue {
  id             Int                             @id @default(autoincrement()) @db.UnsignedInt
  player_uuid    String                          @db.VarChar(36)
  player_name    String                          @db.VarChar(16)
  source         String                          @db.VarChar(64)
  command_text   String                          @db.VarChar(512)
  execute_as     player_command_queue_execute_as @default(console)
  status         player_command_queue_status     @default(pending)
  server_scope   String                          @default("any") @db.VarChar(64)
  dedupe_key     String                          @unique @db.VarChar(128)
  available_at   DateTime                        @default(now())
  claimed_at     DateTime?
  completed_at   DateTime?
  failure_reason String?                         @db.VarChar(512)
  retry_count    Int                             @default(0) @db.UnsignedInt
  created_at     DateTime                        @default(now())
  updated_at     DateTime                        @updatedAt
}

model supportTicketCategories {
  categoryId  Int                              @id @default(autoincrement())
  name        String                           @db.VarChar(255)
  description String?                          @db.Text
  enabled     Boolean                          @default(true)

  tickets     supportTickets[]
  permissions supportTicketCategoryPermissions[]
  forms       forms[]
}

model supportTickets {
  ticketId         Int                     @id @default(autoincrement())
  userId           Int
  categoryId       Int
  title            String                  @db.VarChar(255)
  status           supportTickets_status   @default(open)
  discordChannelId String?                 @db.VarChar(255)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  category         supportTicketCategories @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  messages         supportTicketMessages[]
  formSubmissions  formSubmissions[]
}

model supportTicketMessages {
  messageId   Int            @id @default(autoincrement())
  ticketId    Int
  userId      Int
  message     String         @db.Text
  attachments Json?
  isInternal  Int            @default(0) @db.TinyInt
  createdAt   DateTime       @default(now())

  ticket      supportTickets @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade)
}

model supportTicketCategoryPermissions {
  permissionId Int                     @id @default(autoincrement())
  categoryId   Int
  roleId       String                  @db.VarChar(255)

  category     supportTicketCategories @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
}

model userNotifications {
  notificationId   Int      @id @default(autoincrement())
  userId           Int
  ticketId         Int?
  notificationType String   @db.VarChar(32)
  title            String   @db.VarChar(255)
  message          String   @db.Text
  url              String   @db.VarChar(255)
  isRead           Int      @default(0) @db.TinyInt
  createdAt        DateTime @default(now())
}

model pushSubscriptions {
  subscriptionId Int      @id @default(autoincrement())
  userId         Int
  endpoint       String   @unique @db.VarChar(2048)
  p256dh         String   @db.VarChar(512)
  auth           String   @db.VarChar(128)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// =============================================================================
// Events Calendar Module
// =============================================================================

model events {
  eventId             Int       @id @default(autoincrement())
  title               String    @db.VarChar(255)
  slug                String    @unique @db.VarChar(300)
  description         String?   @db.LongText
  /// Shown in place of `description` to anyone who cannot see a rank-locked
  /// event -- website, Discord embed and Discord scheduled event alike.
  /// NULL falls back to generated lock copy.
  teaserDescription   String?   @db.LongText
  eventType           String    @default("once") @db.VarChar(32)
  startAt             DateTime
  endAt               DateTime
  timezone            String    @default("UTC") @db.VarChar(64)
  status              String    @default("draft") @db.VarChar(32)
  /// "public" | "private" | "rank" — "rank" restricts the detail view to the
  /// LuckPerms groups listed in rankAccess.
  visibility          String    @default("public") @db.VarChar(32)
  /// Rank-locked events only: show a locked teaser publicly, or hide entirely.
  teaserPublic        Boolean   @default(true)
  locationLabel       String?   @db.VarChar(255)
  locationType        String?   @db.VarChar(32)
  locationDiscordChannelId String? @db.VarChar(64)
  serverName          String?   @db.VarChar(255)
  serverIp            String?   @db.VarChar(255)
  externalLinks       Json?
  bannerUrl           String?   @db.VarChar(512)
  logoUrl             String?   @db.VarChar(512)
  tags                Json?
  featured            Boolean   @default(false)
  creatorId           Int
  reviewerId          Int?
  templateId          Int?
  rejectionNote       String?   @db.Text
  discordMessageId    String?   @db.VarChar(32)
  discordGuildEventId String?   @db.VarChar(32)
  discordChannelId    String?   @db.VarChar(32)
  discordSyncStatus   String?   @db.VarChar(16)
  discordSyncError    String?   @db.Text
  websiteSyncStatus   String?   @db.VarChar(16)
  websiteSyncError    String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  approvedAt          DateTime?
  publishedAt         DateTime?
  cancelledAt         DateTime?
  deletedAt           DateTime?

  template            event_templates?      @relation(fields: [templateId], references: [templateId], onDelete: SetNull)
  hosts               event_hosts[]
  actions             event_actions[]
  announcements       event_announcements[]
  auditLogs           event_audit_logs[]
  rankAccess          event_rank_access[]
}

model event_rank_access {
  id       Int    @id @default(autoincrement())
  eventId  Int
  rankSlug String @db.VarChar(64)

  event    events @relation(fields: [eventId], references: [eventId], onDelete: Cascade)

  @@unique([eventId, rankSlug])
  @@index([rankSlug])
}

model event_templates {
  templateId          Int       @id @default(autoincrement())
  title               String    @db.VarChar(255)
  description         String?   @db.LongText
  teaserDescription   String?   @db.LongText
  defaultStartTime    String?   @db.VarChar(8)
  defaultEndTime      String?   @db.VarChar(8)
  defaultDurationMins Int?
  timezone            String    @default("UTC") @db.VarChar(64)
  recurrenceType      String    @default("weekly") @db.VarChar(32)
  recurrenceDays      Json?
  recurrenceEveryDays Int?
  draftAdvanceDays    Int       @default(7)
  autoGenerateDrafts  Boolean   @default(true)
  lastGeneratedAt     DateTime?
  nextGenerateAt      DateTime?
  locationLabel       String?   @db.VarChar(255)
  locationType        String?   @db.VarChar(32)
  locationDiscordChannelId String? @db.VarChar(64)
  serverName          String?   @db.VarChar(255)
  serverIp            String?   @db.VarChar(255)
  bannerUrl           String?   @db.VarChar(512)
  logoUrl             String?   @db.VarChar(512)
  tags                Json?
  creatorId           Int
  isActive            Boolean   @default(true)
  /// Defaults applied to every draft this template generates — see events.
  visibility          String    @default("public") @db.VarChar(32)
  teaserPublic        Boolean   @default(true)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  events              events[]
  defaultHosts        event_template_hosts[]
  announcements       event_template_announcements[]
  rankAccess          event_template_rank_access[]
}

model event_template_rank_access {
  id         Int             @id @default(autoincrement())
  templateId Int
  rankSlug   String          @db.VarChar(64)

  template   event_templates @relation(fields: [templateId], references: [templateId], onDelete: Cascade)

  @@unique([templateId, rankSlug])
}

model event_template_announcements {
  id                  Int      @id @default(autoincrement())
  templateId          Int
  label               String?  @db.VarChar(100)
  announcementType    String   @default("reminder") @db.VarChar(32)
  platform            String   @default("discord") @db.VarChar(32)
  channelId           String?  @db.VarChar(32)
  contentTemplate     String?  @db.Text
  body                String?  @db.Text
  colourMessageFormat String?  @db.Text
  link                String?  @db.Text
  popupButtonText     String?  @db.VarChar(60)
  popupImageUrl       String?  @db.Text
  triggerType         String   @default("before_event") @db.VarChar(32)
  offsetMinutes       Int?
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  template            event_templates @relation(fields: [templateId], references: [templateId], onDelete: Cascade)
}

model event_template_hosts {
  id            Int             @id @default(autoincrement())
  templateId    Int
  userId        Int?
  discordUserId String?         @db.VarChar(32)
  displayName   String?         @db.VarChar(100)
  role          String          @default("host") @db.VarChar(32)

  template      event_templates @relation(fields: [templateId], references: [templateId], onDelete: Cascade)
}

model event_hosts {
  id            Int     @id @default(autoincrement())
  eventId       Int
  userId        Int?
  discordUserId String? @db.VarChar(32)
  displayName   String? @db.VarChar(100)
  role          String  @default("host") @db.VarChar(32)

  event         events  @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
}

model event_actions {
  id            Int      @id @default(autoincrement())
  eventId       Int
  actionType    String   @db.VarChar(32)
  trigger       String   @default("on_publish") @db.VarChar(32)
  enabled       Boolean  @default(true)
  config        Json?
  lastRunAt     DateTime?
  lastRunStatus String?  @db.VarChar(16)
  lastRunError  String?  @db.Text

  event         events   @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
}

model event_announcements {
  id                  Int      @id @default(autoincrement())
  eventId             Int
  label               String?  @db.VarChar(100)
  announcementType    String   @default("reminder") @db.VarChar(32)
  platform            String   @default("discord") @db.VarChar(32)
  channelId           String?  @db.VarChar(32)
  contentTemplate     String?  @db.Text
  body                String?  @db.Text
  colourMessageFormat String?  @db.Text
  link                String?  @db.Text
  popupButtonText     String?  @db.VarChar(60)
  popupImageUrl       String?  @db.Text
  triggerType         String   @default("before_event") @db.VarChar(32)
  offsetMinutes       Int?
  scheduledFor    DateTime?
  enabled         Boolean  @default(true)
  status          String   @default("pending") @db.VarChar(16)
  sentAt          DateTime?
  lastError       String?  @db.Text
  discordMessageId String? @db.VarChar(32)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           events   @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
}

model event_audit_logs {
  id             Int      @id @default(autoincrement())
  eventId        Int
  actorId        Int?
  actorName      String?  @db.VarChar(100)
  action         String   @db.VarChar(64)
  details        String?  @db.Text
  beforeSnapshot Json?
  afterSnapshot  Json?
  createdAt      DateTime @default(now())

  event          events   @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
}

// =============================================================================
// Webstore Module
// =============================================================================

enum webstorePurchases_status {
  pending
  paid
  fulfilled
  failed
  refunded
}

enum webstorePurchases_purchaseType {
  one_time
  subscription
}

enum webstoreSubscriptions_status {
  active
  past_due
  cancelled
  expired
  unpaid
}

enum webstoreStripeCommands_action {
  grant
  revoke
}

enum webstoreCommandRuns_status {
  queued
  processing
  completed
  failed
}

/// One row per Stripe checkout session.
model webstorePurchases {
  purchaseId                   Int                              @id @default(autoincrement())
  userId                       Int
  itemSlug                     String                           @db.VarChar(120)
  itemName                     String                           @db.VarChar(180)
  purchaseType                 webstorePurchases_purchaseType
  purchaserMinecraftUsername   String                           @db.VarChar(16)
  recipientMinecraftUsername   String                           @db.VarChar(16)
  status                       webstorePurchases_status         @default(pending)
  stripeSessionId              String                           @unique @db.VarChar(255)
  stripePaymentIntentId        String?                          @db.VarChar(255)
  stripeSubscriptionId         String?                          @db.VarChar(255)
  stripeCustomerId             String?                          @db.VarChar(255)
  amountCents                  Int
  currency                     String                           @db.VarChar(10)
  isGift                       Int                              @default(0) @db.TinyInt
  createdAt                    DateTime                         @default(now())
  updatedAt                    DateTime                         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([stripeSubscriptionId])
}

/// Tracks the lifecycle of every active subscription.
model webstoreSubscriptions {
  subscriptionId               Int                           @id @default(autoincrement())
  purchaseId                   Int
  stripeSubscriptionId         String                        @unique @db.VarChar(255)
  stripeCustomerId             String?                       @db.VarChar(255)
  stripePriceId                String                        @db.VarChar(120)
  recipientMinecraftUsername   String                        @db.VarChar(16)
  purchaserMinecraftUsername   String                        @db.VarChar(16)
  purchaserUserId              Int
  status                       webstoreSubscriptions_status  @default(active)
  currentPeriodStart           DateTime?
  currentPeriodEnd             DateTime?
  cancelAtPeriodEnd            Int                           @default(0) @db.TinyInt
  cancelledAt                  DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@index([purchaseId])
  @@index([recipientMinecraftUsername])
  @@index([status])
}

/// Idempotency log for Stripe webhook events.
model webstoreWebhookEvents {
  webhookEventId  Int      @id @default(autoincrement())
  stripeEventId   String   @unique @db.VarChar(255)
  purchaseId      Int?
  eventType       String   @db.VarChar(80)
  payload         Json?
  processedAt     DateTime @default(now())

  @@index([purchaseId])
}

/// Maps Stripe price IDs to in-game command templates.
model webstoreStripeCommands {
  commandId       Int                            @id @default(autoincrement())
  stripePriceId   String                         @db.VarChar(120)
  action          webstoreStripeCommands_action  @default(grant)
  commandTemplate String                         @db.Text
  sortOrder       Int                            @default(0)
  createdAt       DateTime                       @default(now())

  @@index([stripePriceId])
  @@index([action])
}

/// Tracks each individual command dispatched to executorTasks.
model webstoreCommandRuns {
  commandRunId         Int                         @id @default(autoincrement())
  purchaseId           Int
  stripeSubscriptionId String?                     @db.VarChar(255)
  action               webstoreStripeCommands_action @default(grant)
  commandTemplate      String                      @db.Text
  resolvedCommand      String                      @db.Text
  executorTaskId       Int?
  status               webstoreCommandRuns_status  @default(queued)
  attempts             Int                         @default(0)
  lastError            String?                     @db.Text
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([purchaseId])
  @@index([executorTaskId])
  @@index([status])
}

/// Audit ledger — records both sides of every completed payment.
model webstoreTransactions {
  transactionId                  Int      @id @default(autoincrement())
  purchaseId                     Int
  userId                         Int
  direction                      String   @db.VarChar(16)
  counterpartyMinecraftUsername  String   @db.VarChar(16)
  amountCents                    Int
  currency                       String   @db.VarChar(10)
  createdAt                      DateTime @default(now())

  @@index([userId])
  @@index([purchaseId])
}

// =============================================================================
// Badge System
// =============================================================================

model badges {
  badgeId         Int           @id @default(autoincrement())
  name            String        @db.VarChar(100)
  description     String?       @db.Text
  backgroundColor String        @default("#1a1a2e") @db.VarChar(7)
  textColor       String        @default("#ffffff") @db.VarChar(7)
  luckpermsGroup  String?       @db.VarChar(64)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userBadges      user_badges[]
}

model user_badges {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  earnedAt  DateTime @default(now())
  isManual  Boolean  @default(false)

  badge     badges   @relation(fields: [badgeId], references: [badgeId], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// =============================================================================
// Finance Module
// =============================================================================

enum financeAccounts_accountType {
  bank
  credit_card
  paypal
  stripe
  crypto
  other
}

enum financeCategories_type {
  income
  expense
}

enum financeTransactions_type {
  income
  expense
  transfer
}

enum financeInvoices_status {
  pending
  partial
  paid
  overdue
  cancelled
}

/// Bank / payment accounts that money flows in and out of.
model financeAccounts {
  accountId            Int                            @id @default(autoincrement())
  name                 String                         @db.VarChar(150)
  accountType          financeAccounts_accountType    @default(bank)
  openingBalanceCents  Int                            @default(0)
  currency             String                         @default("USD") @db.VarChar(3)
  isActive             Int                            @default(1) @db.TinyInt
  notes                String?                        @db.Text
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  transactions         financeTransactions[]          @relation("AccountTransactions")
  transfersTo          financeTransactions[]          @relation("AccountTransfersTo")
  payments             financePayments[]
  balances             financeAccountBalances[]
}

/// Dated snapshots of the real balance reported by Stripe / the bank, recorded
/// by staff so the transaction ledger can be reconciled for the monthly report.
model financeAccountBalances {
  balanceId        Int      @id @default(autoincrement())
  accountId        Int
  asOfDate         DateTime @db.Date
  balanceCents     Int      @default(0)
  source           String   @default("manual") @db.VarChar(20)
  note             String?  @db.VarChar(255)
  createdByUserId  Int      @default(0)
  createdAt        DateTime @default(now())

  account          financeAccounts @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, asOfDate])
}

/// Hierarchical income / expense categories.
model financeCategories {
  categoryId         Int                    @id @default(autoincrement())
  parentId           Int?
  name               String                 @db.VarChar(100)
  type               financeCategories_type @default(expense)
  color              String                 @default("#6c757d") @db.VarChar(7)
  isActive           Int                    @default(1) @db.TinyInt
  isPublic           Int                    @default(0) @db.TinyInt
  publicName         String?                @db.VarChar(100)
  publicDescription  String?                @db.VarChar(255)
  publicSortOrder    Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  parent    financeCategories?   @relation("CategoryParent", fields: [parentId], references: [categoryId], onDelete: SetNull)
  children  financeCategories[]  @relation("CategoryParent")

  transactions         financeTransactions[]
  vendors              financeVendors[]
  budgetEntries        financeOperationsBudget[]
  monthlyBudgetEntries financeOperationsBudgetMonthly[]

  @@index([parentId])
  @@index([isPublic])
}

/// Free-form tags that can be attached to transactions.
model financeTags {
  tagId     Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(60)
  color     String   @default("#0d6efd") @db.VarChar(7)
  createdAt DateTime @default(now())

  transactionTags financeTransactionTags[]
}

/// Vendors / suppliers that money is paid to or received from.
model financeVendors {
  vendorId          Int       @id @default(autoincrement())
  name              String    @db.VarChar(150)
  website           String?   @db.VarChar(255)
  contactEmail      String?   @db.VarChar(180)
  notes             String?   @db.Text
  categoryId        Int?
  faviconUrl        String?   @db.VarChar(500)
  logoUrl           String?   @db.VarChar(500)
  logoPublicId      String?   @db.VarChar(255)
  isActive          Int       @default(1) @db.TinyInt
  faviconFetchedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  category     financeCategories?        @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  transactions financeTransactions[]
  invoices     financeInvoices[]
  payments     financePayments[]
  attachments  financeAttachments[]
  budgetEntries financeOperationsBudget[]

  @@index([categoryId])
}

/// Individual income, expense and transfer transactions.
model financeTransactions {
  transactionId    Int                       @id @default(autoincrement())
  type             financeTransactions_type  @default(expense)
  amountCents      Int                       @default(0)
  currency         String                    @default("USD") @db.VarChar(3)
  accountId        Int
  toAccountId      Int?
  categoryId       Int?
  vendorId         Int?
  description      String                    @default("") @db.VarChar(500)
  notes            String?                   @db.Text
  transactionDate  DateTime                  @db.Date
  isLocked         Int                       @default(0) @db.TinyInt
  createdByUserId  Int
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  account     financeAccounts   @relation("AccountTransactions", fields: [accountId], references: [accountId], onDelete: Restrict)
  toAccount   financeAccounts?  @relation("AccountTransfersTo", fields: [toAccountId], references: [accountId], onDelete: SetNull)
  category    financeCategories? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  vendor      financeVendors?   @relation(fields: [vendorId], references: [vendorId], onDelete: SetNull)
  tags        financeTransactionTags[]
  payments    financePayments[]
  attachments financeAttachments[]

  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([vendorId])
  @@index([transactionDate])
  @@index([type])
  @@index([isLocked])
}

/// Junction table: transactions ↔ tags (many-to-many).
model financeTransactionTags {
  id            Int @id @default(autoincrement())
  transactionId Int
  tagId         Int

  transaction financeTransactions @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)
  tag         financeTags         @relation(fields: [tagId], references: [tagId], onDelete: Cascade)

  @@unique([transactionId, tagId])
}

/// Vendor invoices — represent money owed to or from a vendor.
model financeInvoices {
  invoiceId        Int                    @id @default(autoincrement())
  vendorId         Int
  invoiceNumber    String                 @default("") @db.VarChar(100)
  issueDate        DateTime?              @db.Date
  dueDate          DateTime?              @db.Date
  amountCents      Int                    @default(0)
  paidAmountCents  Int                    @default(0)
  currency         String                 @default("USD") @db.VarChar(3)
  status           financeInvoices_status @default(pending)
  description      String?                @db.Text
  createdByUserId  Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  vendor      financeVendors      @relation(fields: [vendorId], references: [vendorId], onDelete: Restrict)
  payments    financePayments[]
  attachments financeAttachments[]

  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
}

/// Payments recorded against invoices or ad-hoc vendor payments.
model financePayments {
  paymentId       Int      @id @default(autoincrement())
  vendorId        Int
  invoiceId       Int?
  transactionId   Int?
  accountId       Int
  amountCents     Int      @default(0)
  currency        String   @default("USD") @db.VarChar(3)
  paidDate        DateTime @db.Date
  notes           String?  @db.Text
  createdByUserId Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor      financeVendors      @relation(fields: [vendorId], references: [vendorId], onDelete: Restrict)
  invoice     financeInvoices?    @relation(fields: [invoiceId], references: [invoiceId], onDelete: SetNull)
  transaction financeTransactions? @relation(fields: [transactionId], references: [transactionId], onDelete: SetNull)
  account     financeAccounts     @relation(fields: [accountId], references: [accountId], onDelete: Restrict)

  @@index([vendorId])
  @@index([invoiceId])
  @@index([transactionId])
  @@index([accountId])
  @@index([paidDate])
}

/// File attachments (PDFs, images) for transactions, invoices, or vendors.
model financeAttachments {
  attachmentId      Int      @id @default(autoincrement())
  transactionId     Int?
  invoiceId         Int?
  vendorId          Int?
  fileName          String   @default("") @db.VarChar(255)
  fileUrl           String   @default("") @db.VarChar(500)
  filePublicId      String   @default("") @db.VarChar(255)
  mimeType          String   @default("application/pdf") @db.VarChar(100)
  fileSizeBytes     Int      @default(0)
  label             String?  @db.VarChar(100)
  uploadedByUserId  Int      @default(0)
  createdAt         DateTime @default(now())

  transaction financeTransactions? @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)
  invoice     financeInvoices?     @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  vendor      financeVendors?      @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)

  @@index([transactionId])
  @@index([invoiceId])
  @@index([vendorId])
}

/// Monthly budget targets, optionally tied to a vendor or category.
model financeOperationsBudget {
  budgetId            Int      @id @default(autoincrement())
  vendorId            Int?
  categoryId          Int?
  label               String   @default("") @db.VarChar(150)
  publicDescription   String?  @db.VarChar(300)
  monthlyBudgetCents  Int      @default(0)
  currency            String   @default("USD") @db.VarChar(3)
  cadence             String   @default("monthly") @db.VarChar(10)
  annualMonth         Int?     @db.TinyInt
  iconName            String?  @db.VarChar(50)
  iconImageUrl        String?  @db.VarChar(500)
  notes               String?  @db.Text
  isActive            Int      @default(1) @db.TinyInt
  removedFromYear     Int?     @db.SmallInt
  removedFromMonth    Int?     @db.TinyInt
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vendor   financeVendors?    @relation(fields: [vendorId], references: [vendorId], onDelete: SetNull)
  category financeCategories? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)

  monthlyOverrides financeOperationsBudgetMonthly[]

  @@index([vendorId])
  @@index([categoryId])
}

/// Per-month deviations from the financeOperationsBudget template: either an
/// override of a template item's amount for one specific month
/// (budgetItemId set), or a one-off item that only exists that month
/// (budgetItemId null). A month with no rows here inherits the template as-is.
model financeOperationsBudgetMonthly {
  monthlyBudgetItemId Int      @id @default(autoincrement())
  year                Int      @db.SmallInt
  month               Int      @db.TinyInt
  budgetItemId        Int?
  categoryId          Int?
  label               String   @default("") @db.VarChar(150)
  publicDescription   String?  @db.VarChar(300)
  monthlyBudgetCents  Int      @default(0)
  currency            String   @default("USD") @db.VarChar(3)
  iconName            String?  @db.VarChar(50)
  iconImageUrl        String?  @db.VarChar(500)
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  budgetItem financeOperationsBudget? @relation(fields: [budgetItemId], references: [budgetId], onDelete: Cascade)
  category   financeCategories?       @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)

  @@unique([year, month, budgetItemId])
  @@index([year, month])
  @@index([categoryId])
}

/// Published monthly financial summary reports.
model financeMonthlyReports {
  reportId            Int       @id @default(autoincrement())
  year                Int       @db.SmallInt
  month               Int       @db.TinyInt
  totalIncomeCents    Int       @default(0)
  totalExpensesCents  Int       @default(0)
  netAmountCents      Int       @default(0)
  isPublished         Int       @default(0) @db.TinyInt
  isLocked            Int       @default(0) @db.TinyInt
  publishedAt         DateTime?
  publishedByUserId   Int?
  notes               String?   @db.Text
  reportData          Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([year, month])
  @@index([isPublished])
}

/// Per-client API credentials.  Replaces the single app-wide `apiKey`: each
/// caller (Minecraft server, uptime monitor, this app's own internal calls)
/// gets its own key with an explicit scope list so it can be revoked alone.
/// Only the SHA-256 hash of the full key is stored.
model apiClients {
  clientId        Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  description     String?   @db.VarChar(255)
  keyPrefix       String    @unique @db.VarChar(20)
  keyHash         String    @db.Char(64)
  scopes          String    @db.Text
  isRevoked       Int       @default(0) @db.TinyInt
  lastUsedAt      DateTime?
  lastUsedIp      String?   @db.VarChar(45)
  createdAt       DateTime  @default(now())
  createdByUserId Int?
  revokedAt       DateTime?

  @@index([isRevoked])
}
