<%#
  Password input with a show/hide toggle.

  id, name, label     -- the field
  autocomplete        -- "current-password" or "new-password"
  showRules           -- list the password rules and tick them off as typed
                         (matches passwordRequirements in routes/sessionRoutes.js)
  labelExtra          -- optional HTML shown at the right of the label (e.g. a link)
%>
<% const _rules = typeof showRules !== "undefined" && showRules; %>
<div class="mb-3">
  <div class="form-label-row">
    <label for="<%= id %>" class="form-label"><%= label %></label>
    <% if (typeof labelExtra !== "undefined" && labelExtra) { %><span class="small"><%- labelExtra %></span><% } %>
  </div>
  <div class="input-group password-field">
    <input type="password" class="form-control" id="<%= id %>" name="<%= name %>"
           autocomplete="<%= autocomplete %>" required
           <% if (_rules) { %>aria-describedby="<%= id %>Rules"<% } %>>
    <button class="btn btn-toggle-password" type="button" data-toggle-password="<%= id %>"
            aria-label="Show password" aria-pressed="false">
      <i class="fa-regular fa-eye" aria-hidden="true"></i>
    </button>
  </div>
  <% if (_rules) { %>
    <ul class="password-rules" id="<%= id %>Rules" data-password-rules="<%= id %>">
      <li data-rule="length">At least 8 characters</li>
      <li data-rule="upper">An uppercase letter</li>
      <li data-rule="lower">A lowercase letter</li>
      <li data-rule="number">A number</li>
    </ul>
  <% } %>
</div>
<script>
  (function () {
    if (window.__passwordFieldReady) return;
    window.__passwordFieldReady = true;

    var RULES = {
      length: function (v) { return v.length >= 8; },
      upper: function (v) { return /[A-Z]/.test(v); },
      lower: function (v) { return /[a-z]/.test(v); },
      number: function (v) { return /\d/.test(v); },
    };

    document.addEventListener("click", function (e) {
      var button = e.target.closest("[data-toggle-password]");
      if (!button) return;
      var input = document.getElementById(button.getAttribute("data-toggle-password"));
      var show = input.type === "password";
      input.type = show ? "text" : "password";
      button.setAttribute("aria-pressed", String(show));
      button.setAttribute("aria-label", show ? "Hide password" : "Show password");
      button.querySelector("i").className = show ? "fa-regular fa-eye-slash" : "fa-regular fa-eye";
    });

    document.addEventListener("input", function (e) {
      var list = e.target.id && document.querySelector('[data-password-rules="' + e.target.id + '"]');
      if (!list) return;
      list.querySelectorAll("[data-rule]").forEach(function (item) {
        item.classList.toggle("met", RULES[item.getAttribute("data-rule")](e.target.value));
      });
    });
  })();
</script>
