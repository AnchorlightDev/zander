<input 
    type="text" 
    class="form-control input-default"
    name="<%= elementName %>"
    <% if (elementValue) { %>
        value="<%= elementValue %>"
    <% } %>
    <% if (required) { %>
        required
    <% } %>
    <%# Optional — guarded with typeof so callers that omit it still render. %>
    <% if (typeof maxLength !== "undefined" && maxLength) { %>
        maxlength="<%= maxLength %>"
    <% } %>
>