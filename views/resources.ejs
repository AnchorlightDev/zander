<%- include("modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: pageDescription
}) %>

<%- include("modules/navigationBar.ejs") %>

<%- include("partials/miniHeader.ejs", {
  headerTitle: "Resources",
  backgroundImage: globalImage
}) %>

<%
  const hostOf = (url) => { try { return new URL(url).hostname.replace(/^www\./, ""); } catch { return ""; } };
  const signedIn = Boolean(req.session?.user);
  const discordLinked = Boolean(req.session?.user?.discordID);
  const canSuggest = allCategories.length > 0;
%>

<section class="section py-5 resources-page">
  <div class="container">
    <p class="resources-intro">Helpful links, apps and tools suggested by the community and approved by staff.</p>

    <div class="row g-5">
      <!-- Resources -->
      <div class="<%= canSuggest ? 'col-lg-8' : 'col-12' %>">
        <% if (!categories) { %>
          <%- include("partials/alert.ejs", {
            alertType: "warning",
            content: "The resources could not be loaded right now. Please try again later."
          }) %>
        <% } else if (!categories.length) { %>
          <div class="resources-empty text-center">
            <i class="fa-solid fa-book-open fa-2x mb-3" aria-hidden="true"></i>
            <h4 class="mb-2">No resources yet</h4>
            <p class="mb-0">
              <% if (canSuggest) { %>
                Know something helpful? Be the first to suggest it<span class="d-none d-lg-inline"> using the form</span>.
              <% } else { %>
                Check back soon.
              <% } %>
            </p>
          </div>
        <% } else { %>
          <ul class="nav nav-pills resources-tabs mb-4" id="resourceTabs" role="tablist">
            <% categories.forEach((category, index) => { %>
              <li class="nav-item" role="presentation">
                <button
                  class="nav-link <%= index === 0 ? 'active' : '' %>"
                  id="tab-<%= category.slug %>"
                  data-bs-toggle="tab"
                  data-bs-target="#content-<%= category.slug %>"
                  type="button"
                  role="tab"
                  aria-controls="content-<%= category.slug %>"
                  aria-selected="<%= index === 0 ? 'true' : 'false' %>">
                  <%= category.name %> <span class="resources-count"><%= category.resources.length %></span>
                </button>
              </li>
            <% }); %>
          </ul>

          <div class="tab-content" id="resourceTabsContent">
            <% categories.forEach((category, index) => { %>
              <div
                class="tab-pane fade <%= index === 0 ? 'show active' : '' %>"
                id="content-<%= category.slug %>"
                role="tabpanel"
                aria-labelledby="tab-<%= category.slug %>">
                <% if (category.description) { %>
                  <p class="mb-3"><%= category.description %></p>
                <% } %>

                <div class="resources-list">
                  <% category.resources.forEach((resource) => { %>
                    <a class="resource-item" href="<%= resource.url %>" target="_blank" rel="noopener noreferrer nofollow">
                      <div class="resource-item-body">
                        <h5 class="resource-item-title"><%= resource.title %></h5>
                        <p class="resource-item-description"><%= resource.description %></p>
                        <span class="resource-item-host"><%= hostOf(resource.url) %></span>
                      </div>
                      <i class="fa-solid fa-arrow-up-right-from-square resource-item-icon" aria-hidden="true"></i>
                      <span class="visually-hidden">(opens in a new tab)</span>
                    </a>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>

      <!-- Suggest a resource -->
      <% if (canSuggest) { %>
        <div class="col-lg-4">
          <div class="resources-suggest" id="suggest">
            <h4 class="mb-2">Suggest a resource</h4>
            <p class="small mb-3">Staff review every suggestion before it is added.</p>

            <% if (req.cookies.alertType) { %>
              <%- include("partials/alert.ejs", {
                alertType: req.cookies.alertType,
                content: req.cookies.alertContent
              }) %>
            <% } %>

            <% if (!signedIn) { %>
              <p class="mb-3">Sign in to suggest a resource.</p>
              <a class="btn btn-primary w-100" href="/login">Sign in</a>
              <% if (config.siteConfiguration.platforms?.discord) { %>
                <p class="small mt-3 mb-0">
                  Members with a linked account can also use <code>/resources submit</code> in our
                  <a href="<%= config.siteConfiguration.platforms.discord %>" target="_blank" rel="noopener noreferrer">Discord</a>.
                </p>
              <% } %>
            <% } else { %>
              <form method="post" action="/resources/submit">
                <div class="mb-3">
                  <label for="title" class="form-label">Name</label>
                  <input type="text" class="form-control" id="title" name="title" maxlength="<%= limits.title %>" required>
                </div>
                <div class="mb-3">
                  <label for="url" class="form-label">Link</label>
                  <input type="url" class="form-control" id="url" name="url" maxlength="<%= limits.url %>" inputmode="url" aria-describedby="urlHelp" required>
                  <div id="urlHelp" class="form-text">The full address, starting with https://</div>
                </div>
                <div class="mb-3">
                  <label for="categoryId" class="form-label">Category</label>
                  <select class="form-select" id="categoryId" name="categoryId" required>
                    <option value="" selected disabled>Choose a category</option>
                    <% allCategories.forEach((c) => { %>
                      <option value="<%= c.categoryId %>"><%= c.name %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="description" class="form-label">Why is it helpful?</label>
                  <textarea class="form-control" id="description" name="description" rows="4" maxlength="<%= limits.description %>" aria-describedby="descriptionHelp" required></textarea>
                  <div id="descriptionHelp" class="form-text d-flex justify-content-between">
                    <span>A sentence or two.</span>
                    <span><span id="descriptionCount">0</span>/<%= limits.description %></span>
                  </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Send for review</button>
                <p class="small mt-3 mb-0">
                  <% if (discordLinked) { %>
                    We'll DM you on Discord when staff decide.
                  <% } else { %>
                    <a href="/profile/<%= encodeURIComponent(req.session.user.username) %>/edit">Link your Discord</a> to hear when staff decide.
                  <% } %>
                </p>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<script>
  (function () {
    var field = document.getElementById("description");
    var count = document.getElementById("descriptionCount");
    if (!field || !count) return;
    field.addEventListener("input", function () { count.textContent = field.value.length; });
  })();
</script>

<%- include("modules/footer.ejs") %>
