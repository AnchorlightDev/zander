      form.action = '/dashboard/finance/accounts/' + btn.dataset.accountId + '/edit';
      document.getElementById('editAccountName').value = btn.dataset.name || '';
      document.getElementById('editAccountType').value = btn.dataset.accountType || 'bank';
      document.getElementById('editAccountCurrency').value = btn.dataset.currency || 'USD';
      document.getElementById('editAccountOpening').value = btn.dataset.opening || '0.00';
      document.getElementById('editAccountNotes').value = btn.dataset.notes || '';
      document.getElementById('editAccountActive').checked = btn.dataset.active === '1';
    });
  </script>
<% } %>
