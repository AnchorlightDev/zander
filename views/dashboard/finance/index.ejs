  <script>
    // Convert the dollar-amount input to integer cents right before submit —
    // the backend expects monthlyBudgetCents.
    document.querySelectorAll('.budget-entry-form').forEach(function (form) {
      form.addEventListener('submit', function () {
        const dollars = parseFloat(form.querySelector('.budget-amount-input').value) || 0;
        form.querySelector('.budget-cents-input').value = Math.round(dollars * 100);
      });
    });

    function updateAnnualMonthField(cadenceInput) {
      const field = cadenceInput.closest('form').querySelector('.budget-annual-month-field');
      if (!field) return;
      const isAnnual = cadenceInput.value === 'annual';
      field.classList.toggle('d-none', !isAnnual);
      field.querySelector('select').required = isAnnual;
    }

    document.querySelectorAll('.budget-cadence-input').forEach(function (input) {
      input.addEventListener('change', function () { updateAnnualMonthField(input); });
      updateAnnualMonthField(input);
    });

    function refreshBudgetIconEditor(editor) {
      const selected = editor.querySelector('.budget-icon-select').value;
      const imageUrl = editor.querySelector('.budget-icon-image-url').value;
      const iconPreview = editor.querySelector('.budget-icon-preview');
      const imagePreview = editor.querySelector('.budget-image-preview');
      const removeButton = editor.querySelector('.budget-icon-image-remove');

      iconPreview.innerHTML = selected ? '<i class="fa-solid fa-' + selected + '"></i>' : '';
      iconPreview.classList.toggle('d-none', !selected || Boolean(imageUrl));
      imagePreview.src = imageUrl || '';
      imagePreview.classList.toggle('d-none', !imageUrl);
      removeButton.classList.toggle('d-none', !imageUrl);
    }

    document.querySelectorAll('.budget-icon-editor').forEach(function (editor) {
      const select = editor.querySelector('.budget-icon-select');
      const fileInput = editor.querySelector('.budget-icon-file');
      const hiddenUrl = editor.querySelector('.budget-icon-image-url');
      const status = editor.querySelector('.budget-icon-status');

      select.addEventListener('change', function () { refreshBudgetIconEditor(editor); });
      editor.querySelector('.budget-icon-image-remove').addEventListener('click', function () {
        hiddenUrl.value = '';
        status.textContent = '';
        refreshBudgetIconEditor(editor);
      });
      fileInput.addEventListener('change', async function () {
        const file = fileInput.files[0];
        if (!file) return;
        fileInput.value = '';
        status.textContent = 'Uploading...';
        status.className = 'budget-icon-status small text-muted';
        const body = new FormData();
        body.append('file', file, file.name);
        body.append('folder', 'finance-budget-icons');
        try {
          const response = await fetch('/dashboard/upload/image', { method: 'POST', body });
          const result = await response.json();
          if (!result.success) throw new Error(result.message || 'Upload failed.');
          hiddenUrl.value = result.data.url;
          status.textContent = 'Uploaded';
          status.className = 'budget-icon-status small text-success';
          refreshBudgetIconEditor(editor);
        } catch (error) {
          status.textContent = error.message || 'Upload failed.';
          status.className = 'budget-icon-status small text-danger';
        }
      });
      refreshBudgetIconEditor(editor);
    });

    document.getElementById('editBudgetModal')?.addEventListener('show.bs.modal', function (e) {
      const btn = e.relatedTarget;
      const form = document.getElementById('editBudgetForm');
      form.action = '/dashboard/finance/budget/' + btn.dataset.id + '/edit';
      document.getElementById('editBudgetLabel').value = btn.dataset.label || '';
      document.getElementById('editBudgetDescription').value = btn.dataset.publicDescription || '';
      document.getElementById('editBudgetCategoryId').value = btn.dataset.categoryId || '';
      document.getElementById('editBudgetAmount').value = btn.dataset.amount || '';
      document.getElementById('editBudgetCurrency').value = btn.dataset.currency || 'USD';
      document.getElementById('editBudgetCadence').value = btn.dataset.cadence || 'monthly';
      document.getElementById('editBudgetAnnualMonth').value = btn.dataset.annualMonth || '1';
      updateAnnualMonthField(document.getElementById('editBudgetCadence'));
      document.getElementById('editBudgetIcon').value = btn.dataset.iconName || '';
      const iconEditor = form.querySelector('.budget-icon-editor');
      iconEditor.querySelector('.budget-icon-image-url').value = btn.dataset.iconImageUrl || '';
      iconEditor.querySelector('.budget-icon-status').textContent = '';
      refreshBudgetIconEditor(iconEditor);
      document.getElementById('editBudgetNotes').value = btn.dataset.notes || '';
    });

    document.getElementById('overrideBudgetModal')?.addEventListener('show.bs.modal', function (e) {
      const btn = e.relatedTarget;
      document.getElementById('overrideBudgetItemId').value = btn.dataset.budgetItemId || '';
      document.getElementById('overrideBudgetLabel').textContent = btn.dataset.label || '';
      document.getElementById('overrideBudgetAmount').value = btn.dataset.amount || '';
    });
  </script>

