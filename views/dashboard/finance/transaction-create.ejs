<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><i class="fa-solid fa-right-left fa-fw me-2"></i>New Transaction</h1>
        <a href="/dashboard/finance/transactions" class="btn btn-sm btn-outline-secondary">
          <i class="fa-solid fa-arrow-left me-1"></i>Back to Transactions
        </a>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-sm">
            <div class="card-body">
              <form method="post" action="/dashboard/finance/transactions/create">

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label for="type" class="form-label fw-semibold">Type <span class="text-danger">*</span></label>
                    <select class="form-select" id="type" name="type" required onchange="updateCategoryFilter(this.value)">
                      <option value="">— Select Type —</option>
                      <option value="income">Income</option>
                      <option value="expense">Expense</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label for="transactionDate" class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" id="transactionDate" name="transactionDate" required>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="description" name="description" required maxlength="500" placeholder="e.g. AWS monthly bill, Stripe payout">
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-7">
                    <label for="amountCents" class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text">$</span>
                      <input type="number" class="form-control" id="amountCents" name="amountCents" required min="0.01" step="0.01" placeholder="0.00">
                    </div>
                  </div>
                  <div class="col-md-5">
                    <label for="currency" class="form-label fw-semibold">Currency</label>
                    <select class="form-select" id="currency" name="currency">
                      <% ['USD','AUD','EUR','GBP','CAD'].forEach(function(c) { %>
                        <option value="<%= c %>" <%= c === 'USD' ? 'selected' : '' %>><%= c %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="categoryId" class="form-label fw-semibold">Category</label>
                  <select class="form-select" id="categoryId" name="categoryId">
                    <option value="">— None —</option>
                    <% categories.forEach(function(cat) { %>
                      <option value="<%= cat.categoryId %>" data-type="<%= cat.type %>"><%= cat.name %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="notes" class="form-label fw-semibold">Notes</label>
                  <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="2000" placeholder="Additional details..."></textarea>
                </div>

                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i>Create Transaction</button>
                  <a href="/dashboard/finance/transactions" class="btn btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>

<script>
function updateCategoryFilter(type) {
  const sel = document.getElementById('categoryId');
  Array.from(sel.options).forEach(opt => {
    if (!opt.value) return;
    opt.hidden = type && opt.dataset.type && opt.dataset.type !== type;
  });
  if (sel.selectedOptions[0] && sel.selectedOptions[0].hidden) sel.value = '';
}
</script>
