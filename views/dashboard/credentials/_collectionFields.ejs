<%# Locals: c (collection or {}) , idPrefix %>
<div class="row g-2">
  <div class="col-md-4"><label class="form-label small" for="<%= idPrefix %>-name">Name</label>
    <input class="form-control form-control-sm" id="<%= idPrefix %>-name" name="name" maxlength="100" required value="<%= c.name || '' %>"></div>
  <div class="col-md-8"><label class="form-label small" for="<%= idPrefix %>-desc">Description</label>
    <input class="form-control form-control-sm" id="<%= idPrefix %>-desc" name="description" maxlength="500" value="<%= c.description || '' %>"></div>
  <div class="col-md-5"><label class="form-label small" for="<%= idPrefix %>-icon">Icon (Font Awesome class)</label>
    <input class="form-control form-control-sm" id="<%= idPrefix %>-icon" name="icon" maxlength="64" value="<%= c.icon || '' %>" placeholder="fa-solid fa-code"></div>
  <div class="col-md-3"><label class="form-label small" for="<%= idPrefix %>-colour">Colour</label>
    <input class="form-control form-control-sm form-control-color" type="color" id="<%= idPrefix %>-colour" name="colour" value="<%= c.colour || '#6c757d' %>"></div>
  <div class="col-md-4 d-flex align-items-end"><div class="form-check">
    <input class="form-check-input" type="checkbox" id="<%= idPrefix %>-req" name="isRequestable" value="1" <%= c.isRequestable ? 'checked' : '' %>>
    <label class="form-check-label small" for="<%= idPrefix %>-req">Staff can request access</label></div></div>
</div>
