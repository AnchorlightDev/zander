<% const actor = null; const activeTab = ""; %>
<%- include("_top.ejs") %>
<div class="alert alert-secondary" role="status">
  <h2 class="h5">The credential vault is not set up on this server</h2>
  <p class="mb-1">No secrets can be stored or read until a key-encryption key is configured.</p>
  <% if (req.session && req.session.user && req.session.user.permissions && req.session.user.permissions.some && req.session.user.permissions.some(p => ["*", "zander.web.*", "zander.web.modules"].includes(String(p).toLowerCase()))) { %>
    <p class="mb-0 small">Server administrators: set <code>CREDENTIAL_VAULT_KEKS</code> and <code>CREDENTIAL_VAULT_ACTIVE_KEK</code> (generate one with <code>node admin/credential-vault.mjs keygen</code>) and restart. Detail: <%= reason %></p>
  <% } %>
</div>
<%- include("_bottom.ejs") %>
