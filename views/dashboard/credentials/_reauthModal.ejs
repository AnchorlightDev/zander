<%# The one place a password for secret access is typed. Nothing in it is
    pre-filled, and credentialVault.js empties it on every close. %>
<div class="modal fade" id="cvReauthModal" tabindex="-1" aria-labelledby="cvReauthTitle" aria-describedby="cvReauthIntro" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" id="cvReauthForm" autocomplete="off" novalidate>
      <div class="modal-header">
        <h2 class="modal-title h5" id="cvReauthTitle"><i class="fa-solid fa-user-shield me-2" aria-hidden="true"></i>Verify your identity</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"></button>
      </div>
      <div class="modal-body">
        <p id="cvReauthIntro" class="mb-2">For security, please verify your identity before accessing this credential.</p>
        <dl class="cv-reauth-target small mb-3">
          <div><dt>Credential</dt><dd id="cvReauthCredential"></dd></div>
          <div><dt>Action</dt><dd id="cvReauthAction"></dd></div>
        </dl>
        <label for="cvReauthPassword" class="form-label" id="cvReauthLabel">Password</label>
        <div class="input-group">
          <input type="password" class="form-control" id="cvReauthPassword" name="cv-reauth" required
                 autocapitalize="off" spellcheck="false" maxlength="256" aria-describedby="cvReauthHelp cvReauthError">
          <button class="btn btn-outline-secondary" type="button" id="cvReauthToggle" aria-pressed="false" aria-label="Show password">
            <i class="fa-regular fa-eye" aria-hidden="true"></i>
          </button>
        </div>
        <div class="form-text" id="cvReauthHelp"></div>
        <div class="text-danger small mt-2" id="cvReauthError" role="alert" aria-live="assertive"></div>
        <div class="small text-muted mt-2" id="cvReauthExpiry" aria-live="polite"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" id="cvReauthSubmit">Verify</button>
      </div>
    </form>
  </div>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div class="toast align-items-center text-bg-dark border-0" id="cvToast" role="status" aria-live="polite" aria-atomic="true">
    <div class="d-flex"><div class="toast-body" id="cvToastBody"></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
  </div>
</div>
