<%- include("_top.ejs") %>
<p><a href="<%= BASE %>/<%= credential.credentialId %>"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i><%= credential.name %></a></p>
<h2 class="h5">Secret versions</h2>
<p class="small text-muted">Older values stay encrypted. Revealing or restoring one asks for verification, like any secret.</p>
<div class="table-responsive">
<table class="table table-sm align-middle cv-table">
  <thead><tr><th scope="col">Version</th><th scope="col">Saved</th><th scope="col">By</th><th scope="col">Fields changed</th><th scope="col" class="text-end">Actions</th></tr></thead>
  <tbody>
  <% versions.forEach(function (v, idx) { %>
    <tr>
      <td>v<%= v.version %><% if (v.version === credential.currentVersion) { %> <span class="badge text-bg-success">Current</span><% } %><% if (v.restoredFromVersion) { %> <span class="small text-muted">(restored from v<%= v.restoredFromVersion %>)</span><% } %></td>
      <td class="text-nowrap"><%= new Date(v.createdAt).toISOString().slice(0, 16).replace('T', ' ') %> UTC</td>
      <td><%= names.get(v.createdBy) || "—" %></td>
      <td class="small"><%= (v.changedFields || []).map(f => f.startsWith('custom:') ? 'custom field' : f).join(", ") || "—" %></td>
      <td class="text-end">
        <% if (v.version !== credential.currentVersion) { %>
          <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
          <% if (caps.has("reveal")) { v.fieldNames.forEach(function (f) { %>
            <button class="btn btn-sm btn-outline-primary" type="button" data-cv-action="reveal_version" data-credential-id="<%= credential.credentialId %>" data-version-id="<%= v.versionId %>" data-field="<%= f %>" data-target="cvVer<%= v.versionId %>" data-label="<%= f.startsWith('custom:') ? 'custom field' : f %> (v<%= v.version %>)">Reveal <%= f.startsWith('custom:') ? 'custom field' : f %></button>
          <% }) } %>
          <% if (caps.has("edit")) { %>
            <button class="btn btn-sm btn-outline-warning" type="button" data-cv-action="restore_version" data-credential-id="<%= credential.credentialId %>" data-version-id="<%= v.versionId %>" data-field="*" data-label="Restore v<%= v.version %>">Restore</button>
          <% } %>
          </div>
          <pre class="cv-secret-value mt-2 text-start" id="cvVer<%= v.versionId %>" hidden></pre>
          <div class="small text-muted cv-countdown" id="cvVer<%= v.versionId %>-countdown"></div>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>

<h2 class="h5 mt-4">Recent activity</h2>
<%- include("_events.ejs", { events, showCredential: false }) %>
<%- include("_bottom.ejs") %>
