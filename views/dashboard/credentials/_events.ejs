<%# Audit rows. Locals: events, showCredential %>
<div class="table-responsive">
<table class="table table-sm align-middle cv-table small">
  <thead><tr><th scope="col">When (UTC)</th><th scope="col">Event</th><th scope="col">Outcome</th><th scope="col">Who</th><% if (showCredential) { %><th scope="col">Credential</th><% } %><th scope="col">Details</th><th scope="col">From</th></tr></thead>
  <tbody>
  <% if (!events.length) { %><tr><td colspan="7" class="text-muted">No activity.</td></tr><% } %>
  <% events.forEach(function (e) { %>
    <tr>
      <td class="text-nowrap"><%= new Date(e.occurredAt).toISOString().slice(0, 19).replace('T', ' ') %></td>
      <td><code><%= e.eventType %></code></td>
      <td><span class="badge <%= e.outcome === 'success' ? 'text-bg-success' : e.outcome === 'denied' ? 'text-bg-warning' : 'text-bg-danger' %>"><%= e.outcome %></span></td>
      <td><%= e.actorName || (e.actorUserId ? '#' + e.actorUserId : 'System') %><% if (e.subjectName && e.subjectName !== e.actorName) { %> <span class="text-muted">→ <%= e.subjectName %></span><% } %></td>
      <% if (showCredential) { %><td><% if (e.credentialId) { %><a href="<%= BASE %>/<%= e.credentialId %>"><%= e.credentialName || '#' + e.credentialId %></a><% } else if (e.collectionName) { %><%= e.collectionName %><% } else { %>—<% } %></td><% } %>
      <td class="text-break"><% if (e.metadata) { Object.entries(e.metadata).forEach(function ([k, v]) { %><span class="me-2"><span class="text-muted"><%= k %>:</span> <%= Array.isArray(v) ? v.join(', ') : String(v) %></span><% }) } %></td>
      <td class="text-nowrap text-muted" title="<%= e.userAgent || '' %>"><%= e.ip || '' %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
