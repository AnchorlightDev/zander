<%- include("_top.ejs") %>
<ul class="list-group">
  <% if (!deleted.length) { %><li class="list-group-item text-muted">No deleted credentials you can restore.</li><% } %>
  <% deleted.forEach(function (c) { %>
    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
      <span><%= c.name %> <span class="small text-muted">deleted <%= new Date(c.deletedAt).toISOString().slice(0, 10) %></span></span>
      <form method="POST" action="<%= BASE %>/<%= c.credentialId %>/restore"><button class="btn btn-sm btn-outline-primary" type="submit">Restore</button></form>
    </li>
  <% }) %>
</ul>
<%- include("_bottom.ejs") %>
