<%#
  Permission list + add form. Locals: grants, groups, grantScope,
  grantCollectionId, grantCredentialId, scopeCapabilities, returnTo, canManage.
%>
<div class="table-responsive mb-3">
  <table class="table table-sm align-middle cv-table">
    <thead><tr><th scope="col">Who</th><th scope="col">Effect</th><th scope="col">Capabilities</th><th scope="col">Expires</th><th scope="col">Granted by</th><th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
      <% if (!grants.length) { %><tr><td colspan="6" class="text-muted">No permissions at this level.</td></tr><% } %>
      <% grants.forEach(function (g) { %>
        <tr>
          <td><i class="fa-solid <%= g.principalType === 'group' ? 'fa-users' : 'fa-user' %> me-1 text-secondary" aria-hidden="true"></i><%= g.principalName %></td>
          <td><span class="badge <%= g.effect === 'deny' ? 'text-bg-danger' : 'text-bg-success' %>"><%= g.effect === 'deny' ? 'Deny' : 'Allow' %></span></td>
          <td><% g.capabilities.forEach(function (cap) { %><span class="badge text-bg-light border me-1"><%= CAPABILITY_LABELS[cap] || cap %></span><% }) %></td>
          <td class="text-nowrap"><%= g.expiresAt ? new Date(g.expiresAt).toISOString().slice(0, 16).replace('T', ' ') + ' UTC' : 'Never' %></td>
          <td class="small text-muted"><%= g.grantedByName || (g.requestId ? 'Access request' : '—') %></td>
          <td class="text-end">
            <% if (canManage && !(g.principalType === 'user' && typeof actor !== 'undefined' && actor && g.userId === actor.userId)) { %>
            <form method="POST" action="<%= BASE %>/grants/<%= g.grantId %>/revoke" data-cv-confirm="Revoke this permission? It takes effect immediately.">
              <input type="hidden" name="returnTo" value="<%= returnTo %>">
              <button class="btn btn-sm btn-outline-danger" type="submit">Revoke</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (canManage) { %>
<details class="cv-add-grant">
  <summary class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add permission</summary>
  <form method="POST" action="<%= BASE %>/grants" class="border rounded p-3 mt-2">
    <input type="hidden" name="scope" value="<%= grantScope %>">
    <% if (grantCollectionId) { %><input type="hidden" name="collectionId" value="<%= grantCollectionId %>"><% } %>
    <% if (grantCredentialId) { %><input type="hidden" name="credentialId" value="<%= grantCredentialId %>"><% } %>
    <input type="hidden" name="returnTo" value="<%= returnTo %>">
    <div class="row g-2">
      <div class="col-md-3">
        <label class="form-label small" for="g-ptype-<%= grantScope %>">Grant to</label>
        <select class="form-select form-select-sm" name="principalType" id="g-ptype-<%= grantScope %>" data-cv-principal>
          <option value="user">A staff member</option>
          <option value="group">A permission group</option>
        </select>
      </div>
      <div class="col-md-4" data-cv-principal-user>
        <label class="form-label small" for="g-user-<%= grantScope %>">Username</label>
        <input class="form-control form-control-sm" name="username" id="g-user-<%= grantScope %>" maxlength="32" autocomplete="off">
      </div>
      <div class="col-md-4" data-cv-principal-group hidden>
        <label class="form-label small" for="g-group-<%= grantScope %>">Group</label>
        <select class="form-select form-select-sm" name="groupId" id="g-group-<%= grantScope %>">
          <% groups.forEach(function (gr) { %><option value="<%= gr.groupId %>"><%= gr.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small" for="g-effect-<%= grantScope %>">Effect</label>
        <select class="form-select form-select-sm" name="effect" id="g-effect-<%= grantScope %>">
          <option value="allow">Allow</option>
          <option value="deny">Deny (restriction)</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small" for="g-exp-<%= grantScope %>">Duration</label>
        <select class="form-select form-select-sm" name="expiresInHours" id="g-exp-<%= grantScope %>">
          <option value="">Permanent</option>
          <option value="1">1 hour</option><option value="4">4 hours</option><option value="24">1 day</option>
          <option value="72">3 days</option><option value="168">1 week</option><option value="720">30 days</option>
        </select>
      </div>
      <fieldset class="col-12">
        <legend class="form-label small mb-1">Capabilities</legend>
        <div class="d-flex flex-wrap gap-3">
          <% scopeCapabilities.forEach(function (cap) { %>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="capabilities" value="<%= cap %>" id="g-cap-<%= grantScope %>-<%= cap %>">
              <label class="form-check-label small" for="g-cap-<%= grantScope %>-<%= cap %>"><%= CAPABILITY_LABELS[cap] %></label>
            </div>
          <% }) %>
        </div>
      </fieldset>
      <div class="col-md-8">
        <label class="form-label small" for="g-reason-<%= grantScope %>">Reason (recorded in the audit log)</label>
        <input class="form-control form-control-sm" name="reason" id="g-reason-<%= grantScope %>" maxlength="500">
      </div>
      <div class="col-md-4 d-flex align-items-end"><button class="btn btn-sm btn-primary w-100" type="submit">Save permission</button></div>
    </div>
    <p class="small text-muted mt-2 mb-0">You cannot grant yourself or a group you belong to. Reveal and copy are never implied by administrative capabilities.</p>
  </form>
</details>
<% } %>
