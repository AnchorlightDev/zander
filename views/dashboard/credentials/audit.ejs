<%
  const _qs = (over) => { const p = new URLSearchParams(); for (const [k, v] of Object.entries({ ...query, ...over })) if (v) p.set(k, v); return BASE + "/audit?" + p.toString(); };
  const pages = Math.max(1, Math.ceil(total / 50));
  const headerActions = (actor.vaultCaps.has('view_audit') || actor.vaultCaps.has('manage_vault'))
    ? `<form method="POST" action="${BASE}/audit/verify"><button class="btn btn-sm btn-outline-secondary" type="submit"><i class="fa-solid fa-link me-1" aria-hidden="true"></i>Verify integrity</button></form>` : "";
%>
<%- include("_top.ejs", { headerActions }) %>
<form class="row g-2 align-items-end mb-3" method="GET" action="<%= BASE %>/audit">
  <div class="col-6 col-md-2"><label class="form-label small" for="a-user">Staff member</label><input class="form-control form-control-sm" id="a-user" name="user" value="<%= query.user || '' %>" maxlength="32"></div>
  <div class="col-6 col-md-2"><label class="form-label small" for="a-cred">Credential ID</label><input class="form-control form-control-sm" id="a-cred" name="credential" inputmode="numeric" value="<%= query.credential || '' %>"></div>
  <div class="col-6 col-md-2"><label class="form-label small" for="a-col">Collection</label>
    <select class="form-select form-select-sm" id="a-col" name="collection"><option value="">Any</option>
      <% collections.forEach(function (c) { %><option value="<%= c.collectionId %>" <%= String(query.collection) === String(c.collectionId) ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
  <div class="col-6 col-md-2"><label class="form-label small" for="a-ev">Activity</label>
    <select class="form-select form-select-sm" id="a-ev" name="event"><option value="">Any</option>
      <% eventTypes.forEach(function (e) { %><option value="<%= e %>" <%= query.event === e ? 'selected' : '' %>><%= e.replace(/_/g, ' ') %></option><% }) %></select></div>
  <div class="col-6 col-md-1"><label class="form-label small" for="a-out">Outcome</label>
    <select class="form-select form-select-sm" id="a-out" name="outcome"><option value="">Any</option>
      <% ["success", "failure", "denied"].forEach(function (o) { %><option value="<%= o %>" <%= query.outcome === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
  <div class="col-6 col-md-1"><label class="form-label small" for="a-from">From</label><input class="form-control form-control-sm" type="date" id="a-from" name="from" value="<%= query.from || '' %>"></div>
  <div class="col-6 col-md-1"><label class="form-label small" for="a-to">To</label><input class="form-control form-control-sm" type="date" id="a-to" name="to" value="<%= query.to || '' %>"></div>
  <div class="col-6 col-md-1"><button class="btn btn-sm btn-outline-secondary w-100" type="submit">Filter</button></div>
</form>
<%- include("_events.ejs", { events, showCredential: true }) %>
<nav class="d-flex justify-content-between align-items-center small" aria-label="Audit pages">
  <span class="text-muted"><%= total %> event<%= total === 1 ? '' : 's' %></span>
  <span class="d-flex gap-2">
    <% if (page > 1) { %><a href="<%= _qs({ page: page - 1 }) %>">← Newer</a><% } %>
    <span>Page <%= page %> of <%= pages %></span>
    <% if (page < pages) { %><a href="<%= _qs({ page: page + 1 }) %>">Older →</a><% } %>
  </span>
</nav>
<%- include("_bottom.ejs") %>
