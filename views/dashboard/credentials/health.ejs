<%
  const sections = [
    ["rotation", "Requires rotation", "Open rotation tasks or a rotation date within " + settings.rotationReminderDays + " days."],
    ["expired", "Expired", "Past their expiry date."],
    ["expiring", "Expiring soon", "Expire within " + settings.rotationReminderDays + " days."],
    ["weak", "Weak passwords", "Estimated at save time on the server; the password itself is never sent anywhere."],
    ["reused", "Reused passwords", "The same password stored on more than one credential (compared with a keyed fingerprint, not the password)."],
    ["duplicates", "Possible duplicates", "Same website and username."],
    ["broad", "Broad access", "More than " + settings.broadAccessThreshold + " people can reveal or copy."],
    ["noOwner", "No owner", "Nobody is responsible for these."],
    ["inactiveOwner", "Inactive owner", "The owner is disabled or no longer has vault access."],
    ["unreviewed", "Not reviewed recently", "No review in " + settings.reviewIntervalDays + " days."],
  ];
  const headerActions = `<a class="btn btn-sm btn-outline-secondary" href="${BASE}/admin/rotation"><i class="fa-solid fa-rotate me-1" aria-hidden="true"></i>Rotation tasks</a>`;
%>
<%- include("_top.ejs", { headerActions }) %>
<div class="cv-stats mb-4">
  <% sections.forEach(function ([key, label]) { %>
    <a class="cv-stat <%= health[key].length ? 'cv-stat-alert' : '' %>" href="#h-<%= key %>"><span class="cv-stat-n"><%= health[key].length %></span><span class="cv-stat-l"><%= label %></span></a>
  <% }) %>
</div>
<% sections.forEach(function ([key, label, help]) { if (!health[key].length) return; %>
  <section class="mb-4" id="h-<%= key %>" aria-labelledby="h-<%= key %>-t">
    <h2 class="h6 mb-0" id="h-<%= key %>-t"><%= label %> <span class="badge text-bg-light border"><%= health[key].length %></span></h2>
    <p class="small text-muted mb-1"><%= help %></p>
    <ul class="list-group list-group-flush">
      <% health[key].forEach(function (r) { %>
        <li class="list-group-item d-flex justify-content-between align-items-center px-0 gap-2 flex-wrap">
          <span><a href="<%= BASE %>/<%= r.credentialId %>"><%= r.name %></a>
            <span class="small text-muted">
              <% if (key === 'expired' || key === 'expiring') { %>· <%= new Date(r.expiresAt).toISOString().slice(0, 10) %><% } %>
              <% if (key === 'rotation' && r.nextRotationAt) { %>· due <%= new Date(r.nextRotationAt).toISOString().slice(0, 10) %><% } %>
              <% if (key === 'broad') { %>· <%= r.reach %> people<% } %>
              <% if (key === 'inactiveOwner') { %>· <%= r.ownerName || '#' + r.ownerUserId %><% } %>
              <% if (key === 'duplicates' && r.url) { %>· <%= displayHost(r.url) %> / <%= r.username %><% } %>
            </span></span>
          <% if (key === 'unreviewed' || key === 'noOwner' || key === 'inactiveOwner') { %>
            <form method="POST" action="<%= BASE %>/<%= r.credentialId %>/review"><input type="hidden" name="returnTo" value="<%= BASE %>/health"><button class="btn btn-sm btn-outline-secondary" type="submit">Mark reviewed</button></form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </section>
<% }) %>
<% if (sections.every(([k]) => !health[k].length)) { %><p class="text-muted">Nothing needs attention.</p><% } %>
<%- include("_bottom.ejs") %>
