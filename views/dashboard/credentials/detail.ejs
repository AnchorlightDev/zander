<%
  const c = credential;
  const t = CREDENTIAL_TYPES[c.type];
  const canReveal = caps.has("reveal");
  const canCopy = caps.has("copy");
  const _d = (d) => (d ? new Date(d).toISOString().slice(0, 10) : "—");
  const custom = (c.details && Array.isArray(c.details.customFields)) ? c.details.customFields : [];
  const fields = [
    ...secretFields.filter(f => secretFieldNames.includes(f.key)).map(f => ({ key: f.key, label: f.label, multiline: f.multiline })),
    ...custom.filter(f => f.secret && secretFieldNames.includes('custom:' + f.key)).map(f => ({ key: 'custom:' + f.key, label: f.label, multiline: false })),
  ];
  let headerActions = "";
  if (caps.has("edit")) headerActions += `<a class="btn btn-sm btn-primary" href="${BASE}/${c.credentialId}/edit"><i class="fa-solid fa-pen me-1" aria-hidden="true"></i>Edit</a>`;
  if (caps.has("view_history")) headerActions += `<a class="btn btn-sm btn-outline-secondary" href="${BASE}/${c.credentialId}/history"><i class="fa-solid fa-clock-rotate-left me-1" aria-hidden="true"></i>History</a>`;
  if (caps.has("manage_access") || actor.vaultCaps.has("manage_vault")) headerActions += `<a class="btn btn-sm btn-outline-secondary" href="${BASE}/${c.credentialId}/access"><i class="fa-solid fa-user-lock me-1" aria-hidden="true"></i>Access</a>`;
%>
<%- include("_top.ejs", { headerActions }) %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
      <span class="badge rounded-pill text-bg-light border"><i class="<%= t.icon %> me-1" aria-hidden="true"></i><%= t.label %></span>
      <% if (collection) { %><a class="badge rounded-pill text-bg-light border text-decoration-none" href="<%= BASE %>?collection=<%= collection.collectionId %>"><span class="cv-dot" style="background:<%= collection.colour || '#6c757d' %>" aria-hidden="true"></span><%= collection.name %></a><% } %>
      <% c.tags.forEach(function (tag) { %><a class="badge rounded-pill text-bg-secondary-subtle text-secondary-emphasis text-decoration-none" href="<%= BASE %>?q=<%= encodeURIComponent(tag) %>">#<%= tag %></a><% }) %>
      <form method="POST" action="<%= BASE %>/<%= c.credentialId %>/favourite" class="ms-auto">
        <input type="hidden" name="on" value="<%= favourite ? '0' : '1' %>">
        <button class="btn btn-sm btn-link text-decoration-none" type="submit" aria-pressed="<%= favourite %>">
          <i class="<%= favourite ? 'fa-solid text-warning' : 'fa-regular' %> fa-star me-1" aria-hidden="true"></i><%= favourite ? "Favourite" : "Add to favourites" %>
        </button>
      </form>
    </div>

    <dl class="cv-fields">
      <% if (c.url) { %>
        <div class="cv-field">
          <dt>Website</dt>
          <dd class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-break"><%= c.url %></span>
            <a class="btn btn-sm btn-outline-secondary" href="<%= c.url %>" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-arrow-up-right-from-square me-1" aria-hidden="true"></i>Open website</a>
          </dd>
        </div>
      <% } %>
      <% if (c.username) { %>
        <div class="cv-field">
          <dt>Username</dt>
          <dd class="d-flex align-items-center gap-2 flex-wrap">
            <code class="cv-plain text-break" id="cvUsername"><%= c.username %></code>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-cv-copy-plain="cvUsername"><i class="fa-regular fa-copy me-1" aria-hidden="true"></i>Copy username</button>
          </dd>
        </div>
      <% } %>
      <% if (c.email) { %><div class="cv-field"><dt>Associated email</dt><dd class="text-break"><%= c.email %></dd></div><% } %>
      <% metadataFields.forEach(function (f) { if (c.details && c.details[f.key]) { %>
        <div class="cv-field"><dt><%= f.label %></dt><dd class="text-break"><%= c.details[f.key] %></dd></div>
      <% } }) %>
      <% custom.filter(f => !f.secret && f.value).forEach(function (f) { %>
        <div class="cv-field"><dt><%= f.label %></dt><dd class="text-break"><%= f.value %></dd></div>
      <% }) %>

      <% fields.forEach(function (f, i) { %>
        <div class="cv-field cv-secret-field">
          <dt><i class="fa-solid fa-lock fa-xs me-1 text-secondary" aria-hidden="true"></i><%= f.label %></dt>
          <dd>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="cv-mask" id="cvMask<%= i %>" aria-label="Hidden">••••••••••••••••</span>
              <% if (canReveal) { %>
                <button class="btn btn-sm btn-outline-primary" type="button"
                        data-cv-action="reveal" data-credential-id="<%= c.credentialId %>" data-field="<%= f.key %>"
                        data-target="cvSecret<%= i %>" data-mask="cvMask<%= i %>" data-label="<%= f.label %>">
                  <i class="fa-regular fa-eye me-1" aria-hidden="true"></i>Reveal
                </button>
              <% } %>
              <% if (canCopy) { %>
                <button class="btn btn-sm btn-outline-primary" type="button"
                        data-cv-action="copy" data-credential-id="<%= c.credentialId %>" data-field="<%= f.key %>" data-label="<%= f.label %>">
                  <i class="fa-regular fa-copy me-1" aria-hidden="true"></i>Copy
                </button>
              <% } %>
              <button class="btn btn-sm btn-outline-secondary" type="button" data-cv-hide="cvSecret<%= i %>" data-mask="cvMask<%= i %>" hidden>Hide</button>
            </div>
            <pre class="cv-secret-value mt-2" id="cvSecret<%= i %>" hidden aria-live="polite"></pre>
            <div class="small text-muted cv-countdown" id="cvSecret<%= i %>-countdown" aria-live="off"></div>
          </dd>
        </div>
      <% }) %>
      <% if (!fields.length) { %><div class="cv-field"><dt>Secrets</dt><dd class="text-muted">No secret values stored.</dd></div><% } %>
    </dl>

    <% if (fields.length && !canReveal && !canCopy) { %>
      <p class="small text-muted"><i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>You can see this credential's details but not its secrets.
        <% if (c.isRequestable || (collection && collection.isRequestable)) { %><a href="<%= BASE %>/requests?scope=credential&target=<%= c.credentialId %>">Request access</a>.<% } %></p>
    <% } else if ((canReveal || canCopy) && !security.method) { %>
      <p class="small"><i class="fa-solid fa-key me-1" aria-hidden="true"></i><a href="<%= BASE %>/security">Set your vault password</a> to reveal or copy secrets.</p>
    <% } else if (canReveal || canCopy) { %>
      <p class="small text-muted"><i class="fa-solid fa-user-shield me-1" aria-hidden="true"></i>Every reveal and every copy asks for your <%= security.method === 'account_password' ? 'Zander password' : 'vault password' %>, every time.</p>
    <% } %>

    <% if (c.description) { %>
      <h2 class="h6 mt-4">Description</h2>
      <p class="cv-description"><%= c.description %></p>
    <% } %>
  </div>

  <aside class="col-lg-4" aria-label="Credential information">
    <dl class="cv-meta small">
      <dt>Owner</dt><dd><%= names.get(c.ownerUserId) || "No owner" %></dd>
      <dt>Created</dt><dd><%= _d(c.createdAt) %> by <%= names.get(c.createdBy) || "—" %></dd>
      <dt>Last modified</dt><dd><%= _d(c.updatedAt) %> by <%= names.get(c.updatedBy) || "—" %></dd>
      <dt>Expires</dt><dd><%= _d(c.expiresAt) %></dd>
      <dt>Rotation</dt><dd><%= c.rotateEveryDays ? "Every " + c.rotateEveryDays + " days" : "No schedule" %><% if (c.nextRotationAt) { %>, next <%= _d(c.nextRotationAt) %><% } %></dd>
      <dt>Last rotated</dt><dd><%= _d(c.lastRotatedAt) %></dd>
      <dt>Last reviewed</dt><dd><%= _d(c.lastReviewedAt) %><% if (c.lastReviewedBy) { %> by <%= names.get(c.lastReviewedBy) || "—" %><% } %></dd>
      <% if (passwordStrength !== null && passwordStrength !== undefined) { %>
        <dt>Password strength</dt><dd><%= ["Very weak", "Weak", "Fair", "Strong", "Very strong"][passwordStrength] %></dd>
      <% } %>
    </dl>
    <div class="d-flex flex-column gap-2">
      <% if (caps.has("edit") || actor.vaultCaps.has("manage_vault")) { %>
        <form method="POST" action="<%= BASE %>/<%= c.credentialId %>/review"><button class="btn btn-sm btn-outline-secondary w-100" type="submit"><i class="fa-solid fa-clipboard-check me-1" aria-hidden="true"></i>Mark as reviewed</button></form>
      <% } %>
      <% if (caps.has("delete")) { %>
        <form method="POST" action="<%= BASE %>/<%= c.credentialId %>/delete" data-cv-confirm="Delete this credential? Staff lose access immediately; an administrator can restore it.">
          <button class="btn btn-sm btn-outline-danger w-100" type="submit"><i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Delete</button>
        </form>
      <% } %>
    </div>
  </aside>
</div>
<%- include("_bottom.ejs") %>
