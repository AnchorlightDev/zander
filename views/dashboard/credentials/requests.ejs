<%
  const _hours = (h) => !h ? "No expiry" : h < 24 ? h + " hour" + (h === 1 ? "" : "s") : h % 24 === 0 && h < 720 ? (h / 24) + " day" + (h === 24 ? "" : "s") : (h / 24) + " days";
  const _status = { pending: "text-bg-warning", approved: "text-bg-success", rejected: "text-bg-danger", cancelled: "text-bg-secondary", expired: "text-bg-secondary" };
%>
<%- include("_top.ejs") %>

<% if (queue.length) { %>
<h2 class="h5">Waiting for your decision</h2>
<ul class="list-group mb-4">
  <% queue.forEach(function (r) { %>
    <li class="list-group-item">
      <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
          <strong><%= r.requesterName %></strong> wants
          <% r.capabilities.forEach(function (cap) { %><span class="badge text-bg-light border me-1"><%= CAPABILITY_LABELS[cap] %></span><% }) %>
          on <strong><%= r.targetName %></strong> <span class="text-muted small">(<%= r.scope %>)</span>
          <div class="small text-muted">Asked <%= new Date(r.createdAt).toISOString().slice(0, 16).replace('T', ' ') %> UTC · requested duration: <%= _hours(r.durationHours) %></div>
          <blockquote class="small mb-2 mt-1 cv-quote"><%= r.reason %></blockquote>
        </div>
      </div>
      <form method="POST" action="<%= BASE %>/requests/<%= r.requestId %>/decide" class="row g-2 align-items-end">
        <div class="col-md-3"><label class="form-label small" for="d-<%= r.requestId %>">Grant for</label>
          <select class="form-select form-select-sm" name="durationHours" id="d-<%= r.requestId %>">
            <% durations.forEach(function (h) { %><option value="<%= h %>" <%= r.durationHours === h ? 'selected' : '' %>><%= _hours(h) %></option><% }) %>
            <option value="0" <%= !r.durationHours ? 'selected' : '' %>>No expiry</option>
          </select></div>
        <div class="col-md-5"><label class="form-label small" for="n-<%= r.requestId %>">Note to requester (optional)</label>
          <input class="form-control form-control-sm" name="note" id="n-<%= r.requestId %>" maxlength="1000"></div>
        <div class="col-md-4 d-flex gap-2">
          <button class="btn btn-sm btn-success flex-fill" name="decision" value="approve" type="submit">Approve</button>
          <button class="btn btn-sm btn-outline-danger flex-fill" name="decision" value="reject" type="submit">Reject</button>
        </div>
      </form>
    </li>
  <% }) %>
</ul>
<% } %>

<h2 class="h5">Request access</h2>
<% if (!targets.collections.length && !targets.credentials.length) { %>
  <p class="text-muted">Nothing is open to requests right now. Ask a vault administrator directly.</p>
<% } else { %>
<form method="POST" action="<%= BASE %>/requests" class="cv-section">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label" for="r-target">What do you need?</label>
      <select class="form-select" name="target" id="r-target" required>
        <% if (targets.collections.length) { %><optgroup label="Collections">
          <% targets.collections.forEach(function (c) { %><option value="collection:<%= c.collectionId %>" <%= preselect.scope === 'collection' && preselect.targetId === c.collectionId ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </optgroup><% } %>
        <% if (targets.credentials.length) { %><optgroup label="Credentials">
          <% targets.credentials.forEach(function (c) { %><option value="credential:<%= c.credentialId %>" <%= preselect.scope === 'credential' && preselect.targetId === c.credentialId ? 'selected' : '' %>><%= c.name %> (<%= c.collectionName %>)</option><% }) %>
        </optgroup><% } %>
      </select>
    </div>
    <div class="col-md-6">
      <label class="form-label" for="r-duration">For how long?</label>
      <select class="form-select" name="durationHours" id="r-duration">
        <% durations.forEach(function (h) { %><option value="<%= h %>" <%= h === 24 ? 'selected' : '' %>><%= _hours(h) %></option><% }) %>
        <option value="">Ongoing (approver decides)</option>
      </select>
    </div>
    <fieldset class="col-12"><legend class="form-label">Access needed</legend>
      <div class="d-flex flex-wrap gap-3">
        <% requestableCapabilities.forEach(function (cap) { %>
          <div class="form-check"><input class="form-check-input" type="checkbox" name="capabilities" value="<%= cap %>" id="r-cap-<%= cap %>" <%= cap === 'reveal' ? 'checked' : '' %>>
          <label class="form-check-label" for="r-cap-<%= cap %>"><%= CAPABILITY_LABELS[cap] %></label></div>
        <% }) %>
      </div>
    </fieldset>
    <div class="col-12">
      <label class="form-label" for="r-reason">Why do you need it?</label>
      <textarea class="form-control" name="reason" id="r-reason" rows="2" minlength="10" maxlength="1000" required></textarea>
    </div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Send request</button></div>
  </div>
</form>
<% } %>

<h2 class="h5 mt-4">Your requests</h2>
<div class="table-responsive">
<table class="table table-sm align-middle cv-table">
  <thead><tr><th scope="col">Requested</th><th scope="col">For</th><th scope="col">Access</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
  <tbody>
  <% if (!mine.length) { %><tr><td colspan="5" class="text-muted">No requests yet.</td></tr><% } %>
  <% mine.forEach(function (r) { %>
    <tr>
      <td class="text-nowrap"><%= new Date(r.createdAt).toISOString().slice(0, 10) %></td>
      <td><%= r.targetName %></td>
      <td><% r.capabilities.forEach(function (cap) { %><span class="badge text-bg-light border me-1"><%= CAPABILITY_LABELS[cap] %></span><% }) %></td>
      <td><span class="badge <%= _status[r.status] || 'text-bg-secondary' %>"><%= r.status %></span><% if (r.decisionNote) { %><div class="small text-muted"><%= r.decisionNote %></div><% } %></td>
      <td class="text-end"><% if (r.status === 'pending') { %><form method="POST" action="<%= BASE %>/requests/<%= r.requestId %>/cancel"><button class="btn btn-sm btn-link" type="submit">Cancel</button></form><% } %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include("_bottom.ejs") %>
