<%- include("_top.ejs") %>
<div style="max-width: 40rem">
  <div class="alert alert-warning" role="alert">
    <strong>Copy this code now — it will not be shown again.</strong> Only a hash is stored.
  </div>
  <p>Enrolment code for <strong><%= issued.username %></strong>, valid until <%= new Date(issued.expiresAt).toISOString().slice(0, 16).replace('T', ' ') %> UTC and usable once:</p>
  <div class="input-group mb-3">
    <input class="form-control form-control-lg font-monospace" id="cvEnrolCode" value="<%= issued.code %>" readonly aria-label="Enrolment code">
    <button class="btn btn-outline-secondary" type="button" data-cv-copy-plain-input="cvEnrolCode"><i class="fa-regular fa-copy me-1" aria-hidden="true"></i>Copy</button>
  </div>
  <p class="small text-muted">Give it to them directly (in person or a private message). They enter it on their Security tab with a new vault password. Issuing another code cancels this one.</p>
  <a class="btn btn-outline-secondary" href="<%= BASE %>/admin">Back to administration</a>
</div>
<%- include("_bottom.ejs") %>
