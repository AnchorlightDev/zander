<%- include("_top.ejs") %>
<p>What are you storing?</p>
<div class="list-group cv-type-picker" style="max-width: 40rem">
  <% Object.entries(CREDENTIAL_TYPES).forEach(function ([k, t]) { %>
    <a class="list-group-item list-group-item-action d-flex gap-3 align-items-center" href="<%= BASE %>/new?type=<%= k %><%= selectedCollectionId ? '&collection=' + selectedCollectionId : '' %>">
      <i class="<%= t.icon %> fa-fw text-secondary" aria-hidden="true"></i>
      <div><div class="fw-semibold"><%= t.label %></div>
        <div class="small text-muted"><%= t.secrets.map(s => s.label).join(", ") %></div></div>
    </a>
  <% }) %>
</div>
<p class="small text-muted mt-3">Prefer delegated access (organisation memberships, OAuth apps, service roles) where the service supports it, and store a shared login only when it does not.</p>
<%- include("_bottom.ejs") %>
