<%- include("_top.ejs") %>
<p><a href="<%= BASE %>/<%= credential.credentialId %>"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i><%= credential.name %></a></p>
<h2 class="h5">Permissions on this credential</h2>
<%- include("_grants.ejs", { grants, groups, grantScope: "credential", grantCollectionId: null, grantCredentialId: credential.credentialId, scopeCapabilities, returnTo: BASE + "/" + credential.credentialId + "/access", canManage: true }) %>
<h2 class="h5 mt-4">Inherited from the collection</h2>
<p class="small text-muted">Collection permissions apply to every credential in it. Manage them on the <a href="<%= BASE %>/collections/<%= credential.collectionId %>">collection page</a>. A deny at any level wins.</p>
<%- include("_grants.ejs", { grants: inherited, groups, grantScope: "collection-ro", grantCollectionId: null, grantCredentialId: null, scopeCapabilities: [], returnTo: "", canManage: false }) %>
<%- include("_bottom.ejs") %>
