<% const o = overview.counts; %>
<%- include("_top.ejs") %>
<div class="cv-stats mb-4">
  <div class="cv-stat"><span class="cv-stat-n"><%= o.credentials %></span><span class="cv-stat-l">Credentials</span></div>
  <div class="cv-stat"><span class="cv-stat-n"><%= o.collections %></span><span class="cv-stat-l">Collections</span></div>
  <div class="cv-stat"><span class="cv-stat-n"><%= o.staffWithAccess %></span><span class="cv-stat-l">Staff with access</span></div>
  <a class="cv-stat <%= o.openRotationTasks ? 'cv-stat-alert' : '' %>" href="<%= BASE %>/admin/rotation"><span class="cv-stat-n"><%= o.openRotationTasks %></span><span class="cv-stat-l">Awaiting rotation</span></a>
  <a class="cv-stat <%= o.expiring ? 'cv-stat-alert' : '' %>" href="<%= BASE %>/health#h-expiring"><span class="cv-stat-n"><%= o.expiring %></span><span class="cv-stat-l">Expiring</span></a>
  <a class="cv-stat <%= o.pendingRequests ? 'cv-stat-alert' : '' %>" href="<%= BASE %>/requests"><span class="cv-stat-n"><%= o.pendingRequests %></span><span class="cv-stat-l">Pending requests</span></a>
  <a class="cv-stat <%= o.failedVerifications7d ? 'cv-stat-alert' : '' %>" href="<%= BASE %>/audit?outcome=failure"><span class="cv-stat-n"><%= o.failedVerifications7d %></span><span class="cv-stat-l">Failed/denied checks (7 days)</span></a>
  <a class="cv-stat <%= o.missingOwner ? 'cv-stat-alert' : '' %>" href="<%= BASE %>/health#h-noOwner"><span class="cv-stat-n"><%= o.missingOwner %></span><span class="cv-stat-l">Missing an owner</span></a>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
  <a class="btn btn-sm btn-outline-secondary" href="<%= BASE %>/collections"><i class="fa-solid fa-folder-tree me-1" aria-hidden="true"></i>Collections</a>
  <a class="btn btn-sm btn-outline-secondary" href="<%= BASE %>/groups"><i class="fa-solid fa-users me-1" aria-hidden="true"></i>Permission groups</a>
  <a class="btn btn-sm btn-outline-secondary" href="<%= BASE %>/admin/rotation"><i class="fa-solid fa-rotate me-1" aria-hidden="true"></i>Rotation tasks</a>
  <a class="btn btn-sm btn-outline-secondary" href="<%= BASE %>/admin/offboard"><i class="fa-solid fa-user-minus me-1" aria-hidden="true"></i>Offboard staff</a>
  <a class="btn btn-sm btn-outline-secondary" href="<%= BASE %>/trash"><i class="fa-solid fa-trash-can-arrow-up me-1" aria-hidden="true"></i>Deleted credentials</a>
  <a class="btn btn-sm btn-outline-secondary" href="<%= BASE %>/audit"><i class="fa-solid fa-list me-1" aria-hidden="true"></i>Activity</a>
</div>

<h2 class="h5">Vault-wide permissions</h2>
<p class="small text-muted">Apply to every collection. Keep this list short: prefer collection-level access. Administrative capabilities never include reveal or copy.</p>
<%- include("_grants.ejs", { grants: vaultGrants, groups, grantScope: "vault", grantCollectionId: null, grantCredentialId: null, scopeCapabilities, returnTo: BASE + "/admin", canManage: true }) %>

<h2 class="h5 mt-4">Staff with vault access</h2>
<div class="table-responsive">
<table class="table table-sm align-middle cv-table">
  <thead><tr><th scope="col">Staff member</th><th scope="col">Verifies with</th><th scope="col">Status</th><th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th></tr></thead>
  <tbody>
  <% if (!users.length) { %><tr><td colspan="4" class="text-muted">Nobody yet.</td></tr><% } %>
  <% users.forEach(function (u) { const locked = u.lockedUntil && new Date(u.lockedUntil) > new Date(); const acct = Number(u.hasAccountPassword) === 1; const vp = Number(u.hasVaultPassword) === 1; %>
    <tr>
      <td><%= u.username %></td>
      <td class="small"><%= (overview.settings.requireDedicatedVaultPassword || !acct) ? (vp ? "Vault password" : "Not enrolled") : "Zander password" %><% if (vp && acct && !overview.settings.requireDedicatedVaultPassword) { %> <span class="text-muted">(vault password also set)</span><% } %></td>
      <td><% if (locked) { %><span class="badge text-bg-danger">Locked until <%= new Date(u.lockedUntil).toISOString().slice(11, 16) %> UTC</span><% } else { %><span class="badge text-bg-light border">OK</span><% } %></td>
      <td class="text-end">
        <% if (u.userId !== actor.userId) { %>
        <div class="d-inline-flex gap-1">
          <% if (locked) { %><form method="POST" action="<%= BASE %>/admin/users/<%= u.userId %>/clear-lockout"><button class="btn btn-sm btn-outline-secondary" type="submit">Clear lockout</button></form><% } %>
          <% if (vp) { %><form method="POST" action="<%= BASE %>/admin/users/<%= u.userId %>/reset-password" data-cv-confirm="Clear this person's vault password? They will need to set a new one (with their Zander password, or an enrolment code if they have none)."><button class="btn btn-sm btn-outline-danger" type="submit">Reset vault password</button></form><% } %>
          <% if (!vp && !acct) { %><form method="POST" action="<%= BASE %>/admin/enrolment-code"><input type="hidden" name="userId" value="<%= u.userId %>"><button class="btn btn-sm btn-outline-primary" type="submit">Issue enrolment code</button></form><% } %>
        </div>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>

<details class="mt-2">
  <summary class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-ticket me-1" aria-hidden="true"></i>Issue an enrolment code</summary>
  <form method="POST" action="<%= BASE %>/admin/enrolment-code" class="border rounded p-3 mt-2 row g-2">
    <p class="small text-muted mb-1">For staff who sign in with Discord only (no Zander password). They need a one-time code to set their first vault password. Give it to them directly, not in a public channel.</p>
    <div class="col-sm-6"><label class="visually-hidden" for="ec-user">Username</label>
      <input class="form-control form-control-sm" id="ec-user" name="username" maxlength="32" placeholder="Username" required autocomplete="off"></div>
    <div class="col-sm-3"><button class="btn btn-sm btn-primary w-100" type="submit">Issue code</button></div>
  </form>
</details>

<h2 class="h5 mt-4">Security settings</h2>
<form method="POST" action="<%= BASE %>/admin/settings" class="cv-section">
  <p class="small text-muted">Reauthentication cannot be switched off. Every reveal, copy and history access always needs a fresh verification.</p>
  <div class="row g-3">
    <% Object.entries(settingDefinitions).forEach(function ([key, def]) { %>
      <% if (def.type === 'bool') { %>
        <div class="col-md-6"><div class="form-check">
          <input class="form-check-input" type="checkbox" id="s-<%= key %>" name="<%= key %>" value="1" <%= overview.settings[key] ? 'checked' : '' %>>
          <label class="form-check-label small" for="s-<%= key %>"><%= def.label %></label></div></div>
      <% } else { %>
        <div class="col-md-6"><label class="form-label small" for="s-<%= key %>"><%= def.label %></label>
          <input class="form-control form-control-sm" type="number" id="s-<%= key %>" name="<%= key %>" min="<%= def.min %>" max="<%= def.max %>" value="<%= overview.settings[key] %>"></div>
      <% } %>
    <% }) %>
  </div>
  <button class="btn btn-sm btn-primary mt-3" type="submit">Save settings</button>
</form>

<h2 class="h5 mt-4">Recent security activity</h2>
<%- include("_events.ejs", { events: overview.recent, showCredential: true }) %>
<%- include("_bottom.ejs") %>
