<%
  const _q = filters.q || "";
  const _hrefWith = (over) => {
    const p = new URLSearchParams();
    const merged = { q: filters.q, type: filters.type, collection: filters.collectionId, filter: filters.filter, favourites: filters.favourites ? "1" : "", sort: filters.sort !== "name" ? filters.sort : "", ...over };
    for (const [k, v] of Object.entries(merged)) if (v) p.set(k, v);
    const s = p.toString();
    return BASE + (s ? "?" + s : "");
  };
  const headerActions = canCreate
    ? `<a class="btn btn-primary btn-sm" href="${BASE}/new${filters.collectionId ? "?collection=" + Number(filters.collectionId) : ""}"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add credential</a>`
    : "";
%>
<%- include("_top.ejs", { headerActions }) %>

<% if (!security.method) { %>
  <div class="alert alert-info d-flex gap-2 align-items-start" role="status">
    <i class="fa-solid fa-key mt-1" aria-hidden="true"></i>
    <div>Before you can reveal or copy any secret, <a href="<%= BASE %>/security">set your vault password</a>. You will enter it every time you access a secret.</div>
  </div>
<% } %>

<div class="row g-3">
  <aside class="col-lg-3 order-lg-1 order-2" aria-label="Filters">
    <div class="cv-panel">
      <h2 class="cv-panel-title">Collections</h2>
      <ul class="list-unstyled cv-collection-list mb-0">
        <li><a class="<%= !filters.collectionId ? 'active' : '' %>" href="<%= _hrefWith({ collection: '' }) %>">All collections</a></li>
        <% collections.filter(c => c.visibleCount > 0).forEach(function (c) { %>
          <li>
            <a class="<%= filters.collectionId === c.collectionId ? 'active' : '' %>" href="<%= _hrefWith({ collection: c.collectionId }) %>">
              <span class="cv-dot" style="background:<%= c.colour || '#6c757d' %>" aria-hidden="true"></span>
              <span class="flex-grow-1 text-truncate"><%= c.name %></span>
              <span class="badge text-bg-light border"><%= c.visibleCount %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
    <div class="cv-panel">
      <h2 class="cv-panel-title">Show</h2>
      <ul class="list-unstyled cv-collection-list mb-0">
        <li><a class="<%= !filters.filter ? 'active' : '' %>" href="<%= _hrefWith({ filter: '' }) %>">Everything</a></li>
        <li><a class="<%= filters.filter === 'recent' ? 'active' : '' %>" href="<%= _hrefWith({ filter: 'recent' }) %>">Recently updated</a></li>
        <li><a class="<%= filters.filter === 'expiring' ? 'active' : '' %>" href="<%= _hrefWith({ filter: 'expiring' }) %>">Expiring</a></li>
        <li><a class="<%= filters.filter === 'rotation' ? 'active' : '' %>" href="<%= _hrefWith({ filter: 'rotation' }) %>">Requires rotation</a></li>
      </ul>
    </div>
    <p class="small text-muted px-1">Can't find something? <a href="<%= BASE %>/requests">Request access</a>.</p>
  </aside>

  <section class="col-lg-9 order-lg-2 order-1" aria-label="Credentials">
    <form class="row g-2 align-items-end mb-3" method="GET" action="<%= BASE %>" role="search">
      <% if (filters.favourites) { %><input type="hidden" name="favourites" value="1"><% } %>
      <% if (filters.collectionId) { %><input type="hidden" name="collection" value="<%= filters.collectionId %>"><% } %>
      <% if (filters.filter) { %><input type="hidden" name="filter" value="<%= filters.filter %>"><% } %>
      <div class="col-12 col-md">
        <label for="cvSearch" class="visually-hidden">Search credentials</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
          <input id="cvSearch" type="search" class="form-control" name="q" value="<%= _q %>" placeholder="Search name, website, username, tag" maxlength="100" autocomplete="off">
        </div>
      </div>
      <div class="col-6 col-md-auto">
        <label for="cvType" class="visually-hidden">Type</label>
        <select id="cvType" name="type" class="form-select">
          <option value="">All types</option>
          <% Object.entries(CREDENTIAL_TYPES).forEach(function ([k, t]) { %>
            <option value="<%= k %>" <%= filters.type === k ? 'selected' : '' %>><%= t.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-6 col-md-auto">
        <label for="cvSort" class="visually-hidden">Sort</label>
        <select id="cvSort" name="sort" class="form-select">
          <option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Name</option>
          <option value="updated" <%= filters.sort === 'updated' ? 'selected' : '' %>>Recently updated</option>
          <option value="type" <%= filters.sort === 'type' ? 'selected' : '' %>>Type</option>
        </select>
      </div>
      <div class="col-12 col-md-auto"><button class="btn btn-outline-secondary w-100" type="submit">Filter</button></div>
    </form>

    <% if (!credentials.length) { %>
      <div class="cv-empty text-center text-muted py-5">
        <i class="fa-solid fa-vault fa-2x mb-2" aria-hidden="true"></i>
        <p class="mb-1"><%= (_q || filters.type || filters.filter || filters.favourites || filters.collectionId) ? "No credentials match." : "You don't have access to any credentials yet." %></p>
        <% if (!(_q || filters.type || filters.filter || filters.favourites)) { %><p class="small mb-0">Ask a vault administrator, or <a href="<%= BASE %>/requests">request access</a>.</p><% } %>
      </div>
    <% } else { %>
      <ul class="list-group cv-list">
        <% credentials.forEach(function (c) { const t = CREDENTIAL_TYPES[c.type]; %>
          <li class="list-group-item d-flex align-items-center gap-3">
            <span class="cv-type-icon" style="--cv-accent:<%= c.collectionColour || '#6c757d' %>" title="<%= t ? t.label : c.type %>"><i class="<%= t ? t.icon : 'fa-solid fa-key' %>" aria-hidden="true"></i></span>
            <div class="flex-grow-1 min-w-0">
              <a class="fw-semibold stretched-link-sm text-break" href="<%= BASE %>/<%= c.credentialId %>"><%= c.name %></a>
              <% if (c.favourite) { %><i class="fa-solid fa-star text-warning ms-1 small" aria-label="Favourite"></i><% } %>
              <div class="small text-muted text-truncate">
                <%= c.collectionName %>
                <% if (c.url) { %> · <%= displayHost(c.url) %><% } %>
                <% if (c.username) { %> · <%= c.username %><% } %>
              </div>
            </div>
            <div class="d-none d-md-flex flex-column align-items-end small text-muted text-nowrap">
              <% if (c.expiresAt && new Date(c.expiresAt) < new Date(Date.now() + 14 * 86400000)) { %><span class="badge text-bg-warning">Expires <%= new Date(c.expiresAt).toISOString().slice(0, 10) %></span><% } %>
              <% if (c.nextRotationAt && new Date(c.nextRotationAt) < new Date()) { %><span class="badge text-bg-danger">Rotation due</span><% } %>
              <span>Updated <%= new Date(c.updatedAt).toISOString().slice(0, 10) %></span>
            </div>
          </li>
        <% }) %>
      </ul>
      <p class="small text-muted mt-2"><%= credentials.length %> credential<%= credentials.length === 1 ? "" : "s" %></p>
    <% } %>
  </section>
</div>
<%- include("_bottom.ejs") %>
