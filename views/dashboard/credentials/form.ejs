<%
  const _v = values || {};
  const _isEdit = mode === "edit";
  const _action = _isEdit ? `${BASE}/${credential.credentialId}` : BASE;
  const _date = (d) => (d ? new Date(d).toISOString().slice(0, 10) : "");
  const _details = (_v.details && typeof _v.details === "object") ? _v.details : {};
  const _custom = Array.isArray(_details.customFields) ? _details.customFields : [];
%>
<%- include("_top.ejs") %>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger" role="alert"><ul class="mb-0"><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="POST" action="<%= _action %>" class="cv-form" autocomplete="off" id="cvCredentialForm">
  <input type="hidden" name="type" value="<%= type %>">

  <fieldset class="cv-section">
    <legend class="cv-section-title"><i class="<%= CREDENTIAL_TYPES[type].icon %> me-1" aria-hidden="true"></i><%= CREDENTIAL_TYPES[type].label %> details</legend>
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label" for="f-name">Name <span class="text-danger" aria-hidden="true">*</span></label>
        <input class="form-control" id="f-name" name="name" maxlength="150" required value="<%= _v.name || '' %>" placeholder="e.g. Instagram — main account">
      </div>
      <div class="col-md-6">
        <label class="form-label" for="f-collection">Collection <span class="text-danger" aria-hidden="true">*</span></label>
        <select class="form-select" id="f-collection" name="collectionId" required>
          <% collections.forEach(function (c) { %>
            <option value="<%= c.collectionId %>" <%= Number(selectedCollectionId || _v.collectionId) === c.collectionId ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <% if (type !== "secure_note") { %>
      <div class="col-md-6">
        <label class="form-label" for="f-url">Website</label>
        <input class="form-control" id="f-url" name="url" maxlength="500" inputmode="url" value="<%= _v.url || '' %>" placeholder="https://">
      </div>
      <div class="col-md-6">
        <label class="form-label" for="f-username">Username</label>
        <input class="form-control" id="f-username" name="username" maxlength="255" value="<%= _v.username || '' %>" autocomplete="off">
      </div>
      <div class="col-md-6">
        <label class="form-label" for="f-email">Associated email address</label>
        <input class="form-control" id="f-email" name="email" type="email" maxlength="254" value="<%= _v.email || '' %>">
      </div>
      <% } %>
      <% metadataFields.forEach(function (f) { %>
      <div class="col-md-6">
        <label class="form-label" for="f-detail-<%= f.key %>"><%= f.label %></label>
        <input class="form-control" id="f-detail-<%= f.key %>" name="detail_<%= f.key %>" maxlength="300" value="<%= _details[f.key] || '' %>">
      </div>
      <% }) %>
      <div class="col-12">
        <label class="form-label" for="f-description">Description <span class="text-muted small">(not encrypted — no secrets here)</span></label>
        <textarea class="form-control" id="f-description" name="description" rows="2" maxlength="5000"><%= _v.description || '' %></textarea>
      </div>
      <div class="col-md-6">
        <label class="form-label" for="f-tags">Tags</label>
        <input class="form-control" id="f-tags" name="tags" maxlength="1000" value="<%= _v.tags || '' %>" placeholder="comma, separated">
      </div>
      <div class="col-md-6">
        <label class="form-label" for="f-owner">Owner (username)</label>
        <input class="form-control" id="f-owner" name="ownerUsername" maxlength="32" value="<%= _v.ownerUsername || '' %>" placeholder="<%= _isEdit ? '' : 'Defaults to you' %>">
      </div>
    </div>
  </fieldset>

  <fieldset class="cv-section">
    <legend class="cv-section-title"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Secrets</legend>
    <p class="small text-muted">Encrypted before saving.
      <% if (_isEdit) { %>Stored values are never shown here. Leave a field blank to keep it; type a new value to replace it.<% } %>
    </p>
    <div class="row g-3">
      <% secretFields.forEach(function (f) { const stored = storedFieldNames.includes(f.key); %>
        <div class="col-12 <%= f.multiline ? '' : 'col-md-6' %>">
          <label class="form-label d-flex justify-content-between" for="s-<%= f.key %>">
            <span><%= f.label %></span>
            <% if (stored) { %><span class="badge text-bg-success-subtle text-success-emphasis border"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Stored</span><% } %>
          </label>
          <% if (f.multiline) { %>
            <textarea class="form-control font-monospace cv-secret-input" id="s-<%= f.key %>" name="secret_<%= f.key %>" rows="4" spellcheck="false" autocomplete="off" placeholder="<%= stored ? 'Leave blank to keep the stored value' : '' %>"></textarea>
          <% } else { %>
            <div class="input-group">
              <input type="password" class="form-control font-monospace cv-secret-input" id="s-<%= f.key %>" name="secret_<%= f.key %>" autocomplete="new-password" spellcheck="false" placeholder="<%= stored ? 'Leave blank to keep the stored value' : '' %>">
              <button class="btn btn-outline-secondary" type="button" data-cv-toggle="s-<%= f.key %>" aria-label="Show <%= f.label %>"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
              <% if (f.generator) { %><button class="btn btn-outline-secondary" type="button" data-cv-generate="s-<%= f.key %>" aria-controls="cvGenerator"><i class="fa-solid fa-wand-magic-sparkles me-1" aria-hidden="true"></i>Generate</button><% } %>
            </div>
          <% } %>
          <% if (stored) { %>
            <div class="form-check form-check-inline mt-1 small">
              <input class="form-check-input" type="checkbox" id="c-<%= f.key %>" name="clear_<%= f.key %>" value="1">
              <label class="form-check-label" for="c-<%= f.key %>">Remove stored value</label>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>

    <div class="cv-generator border rounded p-3 mt-3" id="cvGenerator" hidden>
      <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3"><label class="form-label small" for="g-length">Length</label>
          <input type="number" class="form-control form-control-sm" id="g-length" min="8" max="128" value="24"></div>
        <div class="col-auto form-check"><input class="form-check-input" type="checkbox" id="g-upper" checked><label class="form-check-label small" for="g-upper">A-Z</label></div>
        <div class="col-auto form-check"><input class="form-check-input" type="checkbox" id="g-lower" checked><label class="form-check-label small" for="g-lower">a-z</label></div>
        <div class="col-auto form-check"><input class="form-check-input" type="checkbox" id="g-digits" checked><label class="form-check-label small" for="g-digits">0-9</label></div>
        <div class="col-auto form-check"><input class="form-check-input" type="checkbox" id="g-symbols" checked><label class="form-check-label small" for="g-symbols">!@#</label></div>
        <div class="col-auto form-check"><input class="form-check-input" type="checkbox" id="g-ambiguous"><label class="form-check-label small" for="g-ambiguous">Avoid look-alikes</label></div>
        <div class="col-12 col-md-auto ms-md-auto"><button type="button" class="btn btn-sm btn-primary" id="g-apply">Use generated password</button></div>
      </div>
      <p class="small text-muted mb-0 mt-2">Generated in your browser with a cryptographically secure random source.</p>
    </div>
  </fieldset>

  <fieldset class="cv-section">
    <legend class="cv-section-title">Custom fields</legend>
    <p class="small text-muted">Tick “Secret” to encrypt a field and protect it like a password.</p>
    <div id="cvCustomFields">
      <% _custom.forEach(function (cf, i) { const stored = cf.secret && storedFieldNames.includes('custom:' + cf.key); %>
        <div class="row g-2 align-items-center cv-custom-row mb-2">
          <input type="hidden" name="custom_key" value="<%= cf.key %>">
          <div class="col-md-4"><input class="form-control form-control-sm" name="custom_label" maxlength="60" value="<%= cf.label %>" aria-label="Field name"></div>
          <div class="col-md-5">
            <% if (cf.secret) { %>
              <input class="form-control form-control-sm font-monospace" type="password" name="custom_value" autocomplete="new-password" placeholder="<%= stored ? 'Stored — leave blank to keep' : '' %>" aria-label="Field value">
            <% } else { %>
              <input class="form-control form-control-sm" name="custom_value" maxlength="300" value="<%= cf.value || '' %>" aria-label="Field value">
            <% } %>
          </div>
          <div class="col-auto form-check"><input class="form-check-input cv-custom-secret" type="checkbox" <%= cf.secret ? 'checked' : '' %> <%= cf.secret ? 'disabled' : '' %> aria-label="Secret"><label class="form-check-label small">Secret</label></div>
          <div class="col-auto"><button type="button" class="btn btn-sm btn-outline-danger" data-cv-remove-row aria-label="Remove field"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
        </div>
      <% }) %>
    </div>
    <template id="cvCustomTemplate">
      <div class="row g-2 align-items-center cv-custom-row mb-2">
        <input type="hidden" name="custom_key" value="">
        <div class="col-md-4"><input class="form-control form-control-sm" name="custom_label" maxlength="60" placeholder="Field name" aria-label="Field name"></div>
        <div class="col-md-5"><input class="form-control form-control-sm" name="custom_value" autocomplete="off" placeholder="Value" aria-label="Field value"></div>
        <div class="col-auto form-check"><input class="form-check-input cv-custom-secret" type="checkbox" aria-label="Secret"><label class="form-check-label small">Secret</label></div>
        <div class="col-auto"><button type="button" class="btn btn-sm btn-outline-danger" data-cv-remove-row aria-label="Remove field"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
      </div>
    </template>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="cvAddCustom"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add field</button>
  </fieldset>

  <fieldset class="cv-section">
    <legend class="cv-section-title">Lifecycle and access</legend>
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label" for="f-expires">Expires</label>
        <input class="form-control" type="date" id="f-expires" name="expiresAt" value="<%= _date(_v.expiresAt) %>">
      </div>
      <div class="col-md-4">
        <label class="form-label" for="f-rotate">Rotate every (days)</label>
        <input class="form-control" type="number" min="1" max="3650" id="f-rotate" name="rotateEveryDays" value="<%= _v.rotateEveryDays || '' %>">
      </div>
      <div class="col-md-4">
        <label class="form-label" for="f-next">Next rotation</label>
        <input class="form-control" type="date" id="f-next" name="nextRotationAt" value="<%= _date(_v.nextRotationAt) %>">
      </div>
      <div class="col-12 form-check ms-2">
        <input class="form-check-input" type="checkbox" id="f-requestable" name="isRequestable" value="1" <%= _v.isRequestable ? 'checked' : '' %>>
        <label class="form-check-label" for="f-requestable">Allow staff to request access to this credential <span class="text-muted small">(its name becomes visible to every vault user)</span></label>
      </div>
      <% if (_isEdit) { %>
      <div class="col-12 form-check ms-2">
        <input class="form-check-input" type="checkbox" id="f-rotated" name="markRotated" value="1">
        <label class="form-check-label" for="f-rotated">This change is a rotation (I changed the password at the service). Closes open rotation tasks.</label>
      </div>
      <% } %>
    </div>
  </fieldset>

  <div class="d-flex gap-2 flex-wrap">
    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i><%= _isEdit ? "Save changes" : "Save credential" %></button>
    <a class="btn btn-outline-secondary" href="<%= _isEdit ? BASE + '/' + credential.credentialId : BASE %>">Cancel</a>
  </div>
</form>
<%- include("_bottom.ejs") %>
