<%- include("_top.ejs") %>
<% if (result) { %>
  <div class="alert alert-success" role="status">
    <h2 class="h5">Offboarding complete</h2>
    <ul class="mb-2">
      <li><%= result.grantsRevoked %> direct permission(s) revoked, <%= result.membershipsRemoved %> group membership(s) removed</li>
      <li><%= result.challengesRevoked %> pending verification(s) cancelled, <%= result.sessionsEnded %> Zander session(s) ended</li>
      <li><%= result.tasksOpened %> rotation task(s) opened</li>
    </ul>
    <p class="mb-0"><strong>Removing someone from Zander does not change what they already saw.</strong> Rotate the flagged credentials at each service. <a href="<%= BASE %>/admin/rotation">Open rotation tasks</a>.</p>
  </div>
<% } %>

<form method="GET" action="<%= BASE %>/admin/offboard" class="row g-2 mb-3" role="search">
  <div class="col-sm-6 col-md-4"><label class="form-label" for="o-user">Staff member leaving</label>
    <input class="form-control" id="o-user" name="user" maxlength="32" required autocomplete="off" value="<%= preview ? preview.subject.username : '' %>"></div>
  <div class="col-sm-3 d-flex align-items-end"><button class="btn btn-outline-secondary" type="submit">Preview</button></div>
</form>

<% if (preview) { %>
  <h2 class="h5">What will happen for <%= preview.subject.username %></h2>
  <ol>
    <li>Revoke <%= preview.directGrants.length %> direct permission(s) and remove <%= preview.memberships.length %> group membership(s)<% if (preview.memberships.length) { %> (<%= preview.memberships.map(m => m.name).join(", ") %>)<% } %>.</li>
    <li>Cancel their pending verifications and clear their vault password.</li>
    <li>Optionally end every Zander session they have open.</li>
    <li>Open rotation tasks for <%= preview.credentials.length %> credential(s) they could reveal or copy, or did:</li>
  </ol>
  <ul class="small">
    <% preview.credentials.forEach(function (c) { %><li><a href="<%= BASE %>/<%= c.credentialId %>"><%= c.name %></a> <span class="text-muted"><%= c.didAccess ? "— revealed or copied it" : "— could reveal or copy" %></span></li><% }) %>
    <% if (!preview.credentials.length) { %><li class="text-muted">None.</li><% } %>
  </ul>
  <form method="POST" action="<%= BASE %>/admin/offboard" class="cv-section">
    <input type="hidden" name="userId" value="<%= preview.subject.userId %>">
    <div class="form-check"><input class="form-check-input" type="checkbox" id="o-sessions" name="endSessions" value="1" checked><label class="form-check-label" for="o-sessions">Also sign them out of Zander everywhere</label></div>
    <div class="form-check"><input class="form-check-input" type="checkbox" id="o-confirm" name="confirm" value="yes" required><label class="form-check-label" for="o-confirm">I understand this takes effect immediately</label></div>
    <button class="btn btn-danger mt-2" type="submit">Offboard <%= preview.subject.username %></button>
  </form>
  <p class="small text-muted">Their Zander account and ranks are not changed here; do that in user administration.</p>
<% } %>
<%- include("_bottom.ejs") %>
