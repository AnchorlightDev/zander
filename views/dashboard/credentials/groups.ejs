<%- include("_top.ejs") %>
<p class="text-muted">Vault permission groups are separate from ranks: membership is assigned here, explicitly. Give a group access on a collection or credential's access page.</p>
<% groups.forEach(function (g) { %>
  <section class="cv-section" aria-labelledby="grp-<%= g.groupId %>">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h2 class="h5 mb-0" id="grp-<%= g.groupId %>"><i class="fa-solid fa-users me-1 text-secondary" aria-hidden="true"></i><%= g.name %></h2>
        <% if (g.description) { %><div class="small text-muted"><%= g.description %></div><% } %>
      </div>
      <details>
        <summary class="btn btn-sm btn-outline-secondary">Edit</summary>
        <form method="POST" action="<%= BASE %>/groups/<%= g.groupId %>" class="border rounded p-2 mt-1">
          <input class="form-control form-control-sm mb-1" name="name" value="<%= g.name %>" maxlength="100" aria-label="Group name" required>
          <input class="form-control form-control-sm mb-1" name="description" value="<%= g.description || '' %>" maxlength="500" aria-label="Description">
          <button class="btn btn-sm btn-primary" type="submit">Save</button>
        </form>
        <form method="POST" action="<%= BASE %>/groups/<%= g.groupId %>/delete" class="mt-1" data-cv-confirm="Delete this group? Every permission given to it is revoked.">
          <button class="btn btn-sm btn-outline-danger" type="submit">Delete group</button>
        </form>
      </details>
    </div>
    <ul class="list-group list-group-flush mt-2">
      <% if (!g.members.length) { %><li class="list-group-item text-muted small">No members.</li><% } %>
      <% g.members.forEach(function (m) { %>
        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
          <span><%= m.username %><% if (m.expiresAt) { %> <span class="badge text-bg-warning">until <%= new Date(m.expiresAt).toISOString().slice(0, 10) %></span><% } %></span>
          <% if (m.userId !== actor.userId) { %>
          <form method="POST" action="<%= BASE %>/groups/<%= g.groupId %>/members/<%= m.userId %>/remove"><button class="btn btn-sm btn-link text-danger" type="submit">Remove</button></form>
          <% } %>
        </li>
      <% }) %>
    </ul>
    <form method="POST" action="<%= BASE %>/groups/<%= g.groupId %>/members" class="row g-2 mt-1">
      <div class="col-sm-5"><input class="form-control form-control-sm" name="username" maxlength="32" placeholder="Username" aria-label="Username to add" required autocomplete="off"></div>
      <div class="col-sm-4"><input class="form-control form-control-sm" type="date" name="expiresAt" aria-label="Membership expires (optional)"></div>
      <div class="col-sm-3"><button class="btn btn-sm btn-outline-primary w-100" type="submit">Add member</button></div>
    </form>
  </section>
<% }) %>
<details class="mt-3">
  <summary class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>New group</summary>
  <form method="POST" action="<%= BASE %>/groups" class="border rounded p-3 mt-2 row g-2">
    <div class="col-md-4"><input class="form-control form-control-sm" name="name" maxlength="100" placeholder="Name" aria-label="Group name" required></div>
    <div class="col-md-6"><input class="form-control form-control-sm" name="description" maxlength="500" placeholder="Description" aria-label="Description"></div>
    <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit">Create</button></div>
  </form>
</details>
<%- include("_bottom.ejs") %>
