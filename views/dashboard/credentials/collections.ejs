<%- include("_top.ejs") %>
<div class="table-responsive">
<table class="table align-middle cv-table">
  <thead><tr><th scope="col">Collection</th><th scope="col" class="text-end">Credentials you can see</th><% if (actor.vaultCaps.has('manage_collections')) { %><th scope="col" class="text-end">Total</th><% } %><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
  <tbody>
  <% if (!collections.length) { %><tr><td colspan="4" class="text-muted">You have no access to any collection yet.</td></tr><% } %>
  <% collections.forEach(function (c) { %>
    <tr>
      <td>
        <span class="cv-collection-icon" style="--cv-accent:<%= c.colour || '#6c757d' %>"><i class="<%= c.icon || 'fa-solid fa-folder' %>" aria-hidden="true"></i></span>
        <a class="fw-semibold" href="<%= BASE %>?collection=<%= c.collectionId %>"><%= c.name %></a>
        <% if (c.isRequestable) { %><span class="badge text-bg-light border ms-1">Requestable</span><% } %>
        <% if (c.description) { %><div class="small text-muted"><%= c.description %></div><% } %>
      </td>
      <td class="text-end"><%= c.visibleCount %></td>
      <% if (actor.vaultCaps.has('manage_collections')) { %><td class="text-end"><%= c.credentialCount %></td><% } %>
      <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="<%= BASE %>/collections/<%= c.collectionId %>">Manage</a></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% if (actor.vaultCaps.has('manage_collections')) { %>
<details class="mt-3">
  <summary class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>New collection</summary>
  <form method="POST" action="<%= BASE %>/collections" class="border rounded p-3 mt-2">
    <%- include("_collectionFields.ejs", { c: {}, idPrefix: "new" }) %>
    <button class="btn btn-sm btn-primary mt-3" type="submit">Create collection</button>
    <p class="small text-muted mb-0 mt-2">A new collection has no access. Assign people or groups after creating it.</p>
  </form>
</details>
<% } %>
<%- include("_bottom.ejs") %>
