<%- include("_top.ejs") %>
<p><a href="<%= BASE %>/collections"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Collections</a> · <a href="<%= BASE %>?collection=<%= collection.collectionId %>">View credentials</a></p>
<% if (collection.description) { %><p class="text-muted"><%= collection.description %></p><% } %>

<% if (actor.vaultCaps.has('manage_collections')) { %>
<h2 class="h5">Settings</h2>
<form method="POST" action="<%= BASE %>/collections/<%= collection.collectionId %>" class="mb-2">
  <%- include("_collectionFields.ejs", { c: collection, idPrefix: "edit" }) %>
  <button class="btn btn-sm btn-primary mt-3" type="submit">Save collection</button>
</form>
<form method="POST" action="<%= BASE %>/collections/<%= collection.collectionId %>/delete" class="mb-4" data-cv-confirm="Delete this collection? It must be empty. Its permissions are revoked.">
  <button class="btn btn-sm btn-outline-danger" type="submit">Delete collection</button>
</form>
<% } %>

<h2 class="h5">Access</h2>
<% if (canManage) { %>
  <p class="small text-muted">Permissions here apply to every credential in the collection, now and later.</p>
  <%- include("_grants.ejs", { grants, groups, grantScope: "collection", grantCollectionId: collection.collectionId, grantCredentialId: null, scopeCapabilities, returnTo: BASE + "/collections/" + collection.collectionId, canManage: true }) %>
<% } else { %>
  <p>Your capabilities here: <% [...caps].forEach(function (cap) { %><span class="badge text-bg-light border me-1"><%= CAPABILITY_LABELS[cap] %></span><% }) %><% if (!caps.size) { %><span class="text-muted">none</span><% } %></p>
<% } %>
<%- include("_bottom.ejs") %>
