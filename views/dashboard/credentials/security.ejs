<%- include("_top.ejs") %>
<div style="max-width: 44rem">
  <p>Every time you reveal, copy or otherwise access a protected secret, you verify your identity again — even if you did so a moment ago.</p>

  <% if (security.lockedUntil) { %>
    <div class="alert alert-danger" role="alert">Verification is locked until <%= new Date(security.lockedUntil).toISOString().slice(11, 16) %> UTC after repeated failed attempts. A vault administrator can clear this.</div>
  <% } %>

  <h2 class="h5">How you verify</h2>
  <% if (security.method === "account_password") { %>
    <p><i class="fa-solid fa-circle-check text-success me-1" aria-hidden="true"></i>With your <strong>Zander account password</strong>.</p>
  <% } else if (security.method === "vault_password") { %>
    <p><i class="fa-solid fa-circle-check text-success me-1" aria-hidden="true"></i>With your <strong>vault password</strong><% if (security.vaultPasswordEnrolledAt) { %> (set <%= new Date(security.vaultPasswordEnrolledAt).toISOString().slice(0, 10) %>)<% } %>.</p>
  <% } else { %>
    <p><i class="fa-solid fa-triangle-exclamation text-warning me-1" aria-hidden="true"></i>
      <%= security.requireDedicatedVaultPassword ? "This vault requires a dedicated vault password." : "You sign in with Discord, which cannot prove a fresh sign-in, so you need a vault password." %>
      Until you set one you cannot access any secret.</p>
  <% } %>

  <% if (!security.hasVaultPassword && (security.method !== "account_password")) { %>
    <h2 class="h5 mt-4">Set your vault password</h2>
    <% if (security.enrolmentFactor === "enrolment_code" && !security.hasPendingEnrolmentCode) { %>
      <div class="alert alert-info" role="status">
        Because you sign in with Discord, you need a one-time <strong>enrolment code</strong> from a vault administrator to set your vault password.
        Ask one of them; they will give it to you directly. Being signed in is not enough on its own.
      </div>
    <% } else { %>
      <form method="POST" action="<%= BASE %>/security/enrol" class="cv-section" autocomplete="off">
        <% if (security.enrolmentFactor === "account_password") { %>
          <div class="mb-3"><label class="form-label" for="v-acct">Your Zander password</label>
            <input class="form-control" type="password" id="v-acct" name="accountPassword" required maxlength="256" autocomplete="current-password">
            <div class="form-text">Confirms it is really you.</div></div>
        <% } else { %>
          <div class="mb-3"><label class="form-label" for="v-code">Enrolment code</label>
            <input class="form-control font-monospace text-uppercase" id="v-code" name="enrolmentCode" required maxlength="40" autocomplete="one-time-code" spellcheck="false" placeholder="XXXXX-XXXXX-XXXXX-XXXXX">
            <div class="form-text">From a vault administrator. It works once and expires after 24 hours.</div></div>
        <% } %>
        <div class="mb-2"><label class="form-label" for="v-new">New vault password</label>
          <input class="form-control" type="password" id="v-new" name="password" minlength="12" maxlength="256" required autocomplete="new-password" aria-describedby="v-help"></div>
        <div class="mb-2"><label class="form-label" for="v-confirm">Confirm</label>
          <input class="form-control" type="password" id="v-confirm" name="confirm" minlength="12" maxlength="256" required autocomplete="new-password"></div>
        <p class="form-text" id="v-help">At least 12 characters; a long passphrase is best. Use a different password from your Zander account. It cannot be recovered by email — if you forget it, another vault administrator must reset it.</p>
        <button class="btn btn-primary" type="submit">Set vault password</button>
      </form>
    <% } %>
  <% } else if (security.hasVaultPassword) { %>
    <h2 class="h5 mt-4">Change your vault password</h2>
    <form method="POST" action="<%= BASE %>/security/change" class="cv-section" autocomplete="off">
      <div class="mb-2"><label class="form-label" for="c-cur">Current vault password</label>
        <input class="form-control" type="password" id="c-cur" name="currentPassword" required maxlength="256" autocomplete="current-password"></div>
      <div class="mb-2"><label class="form-label" for="c-new">New vault password</label>
        <input class="form-control" type="password" id="c-new" name="password" minlength="12" maxlength="256" required autocomplete="new-password"></div>
      <div class="mb-2"><label class="form-label" for="c-confirm">Confirm</label>
        <input class="form-control" type="password" id="c-confirm" name="confirm" minlength="12" maxlength="256" required autocomplete="new-password"></div>
      <button class="btn btn-primary" type="submit">Change vault password</button>
    </form>
  <% } %>

  <h2 class="h5 mt-4">Good practice</h2>
  <ul class="small">
    <li>Revealed values hide themselves after a few seconds. Don't screenshot or paste secrets into chat.</li>
    <li>Copying tries to clear your clipboard afterwards, but no browser or operating system guarantees that — clipboard history tools may keep a copy.</li>
    <li>Where a service supports it, ask for your own account or delegated access instead of a shared login.</li>
  </ul>
</div>
<%- include("_bottom.ejs") %>
