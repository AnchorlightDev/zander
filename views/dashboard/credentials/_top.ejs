<%#
  Credential Vault page chrome. Expects: pageTitle, actor (may be undefined on
  error pages), activeTab, and optionally headerActions (HTML string built in
  the view from escaped values only).
%>
<%- include("../../admin/_head.ejs", { pageTitle, extraHead: '<link rel="stylesheet" href="/css/credentialVault.css">' }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>
<% const _nav = (typeof actor !== "undefined" && actor && actor.nav) ? actor.nav : {}; %>
<% const _tab = typeof activeTab !== "undefined" ? activeTab : ""; %>
<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap cv-wrap">
      <div class="d-flex justify-content-between flex-wrap align-items-center gap-2 pt-3 pb-2 mb-2">
        <h1 class="h2 mb-0 text-break"><i class="fa-solid fa-vault me-2 text-secondary" aria-hidden="true"></i><%= pageTitle %></h1>
        <% if (typeof headerActions !== "undefined" && headerActions) { %><div class="d-flex flex-wrap gap-2"><%- headerActions %></div><% } %>
      </div>
      <% if (typeof actor !== "undefined" && actor) { %>
      <nav class="cv-tabs mb-3" aria-label="Credential vault sections">
        <ul class="nav nav-underline flex-nowrap overflow-auto">
          <li class="nav-item"><a class="nav-link <%= _tab === 'all' ? 'active' : '' %>" <%- _tab === 'all' ? 'aria-current="page"' : '' %> href="<%= BASE %>">All credentials</a></li>
          <li class="nav-item"><a class="nav-link <%= _tab === 'favourites' ? 'active' : '' %>" href="<%= BASE %>?favourites=1">Favourites</a></li>
          <li class="nav-item"><a class="nav-link <%= _tab === 'collections' ? 'active' : '' %>" href="<%= BASE %>/collections">Collections</a></li>
          <li class="nav-item"><a class="nav-link <%= _tab === 'requests' ? 'active' : '' %>" href="<%= BASE %>/requests">Access requests</a></li>
          <% if (_nav.manageVault || (actor.vaultCaps && actor.vaultCaps.has('view_audit'))) { %>
          <li class="nav-item"><a class="nav-link <%= _tab === 'health' ? 'active' : '' %>" href="<%= BASE %>/health">Health</a></li>
          <% } %>
          <% if (_nav.viewAudit) { %>
          <li class="nav-item"><a class="nav-link <%= _tab === 'audit' ? 'active' : '' %>" href="<%= BASE %>/audit">Activity</a></li>
          <% } %>
          <% if (_nav.manageVault) { %>
          <li class="nav-item"><a class="nav-link <%= _tab === 'admin' ? 'active' : '' %>" href="<%= BASE %>/admin">Administration</a></li>
          <% } %>
          <li class="nav-item ms-auto"><a class="nav-link <%= _tab === 'security' ? 'active' : '' %>" href="<%= BASE %>/security"><i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>Security</a></li>
        </ul>
      </nav>
      <% } %>
      <%- include("../../admin/_notices.ejs") %>
