<%- include("_top.ejs") %>
<p class="text-muted">Change the password or key at the service itself, then edit the credential and tick “This change is a rotation” (that closes the task), or close it here.</p>
<div class="table-responsive">
<table class="table align-middle cv-table">
  <thead><tr><th scope="col">Credential</th><th scope="col">Why</th><th scope="col">Opened</th><th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th></tr></thead>
  <tbody>
  <% if (!tasks.length) { %><tr><td colspan="4" class="text-muted">No open rotation tasks.</td></tr><% } %>
  <% tasks.forEach(function (t) { %>
    <tr>
      <td><a href="<%= BASE %>/<%= t.credentialId %>"><%= t.credentialName %></a></td>
      <td><span class="badge text-bg-light border"><%= t.reason %></span> <span class="small"><%= t.details || '' %></span></td>
      <td class="text-nowrap small"><%= new Date(t.createdAt).toISOString().slice(0, 10) %></td>
      <td class="text-end"><div class="d-inline-flex gap-1">
        <a class="btn btn-sm btn-outline-primary" href="<%= BASE %>/<%= t.credentialId %>/edit">Rotate now</a>
        <form method="POST" action="<%= BASE %>/admin/rotation/<%= t.taskId %>/close"><input type="hidden" name="status" value="done"><button class="btn btn-sm btn-outline-success" type="submit">Mark done</button></form>
        <form method="POST" action="<%= BASE %>/admin/rotation/<%= t.taskId %>/close" data-cv-confirm="Dismiss without rotating? This is recorded in the audit log."><input type="hidden" name="status" value="dismissed"><button class="btn btn-sm btn-outline-secondary" type="submit">Dismiss</button></form>
      </div></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include("_bottom.ejs") %>
