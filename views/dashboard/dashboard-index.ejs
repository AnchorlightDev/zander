<%- include("../admin/_head.ejs", { pageTitle }) %>
<%- include("../admin/_topbar.ejs") %>
<%- include("../admin/_sidebar.ejs") %>

<%
  const _user = req.session.user;
  const _build = locals.buildInfo || {};
%>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap dash">

      <!-- ── Greeting ───────────────────────────────────────────────────── -->
      <div class="dash-hero">
        <div>
          <h1 class="dash-greeting" data-greeting><%= greetingFor(new Date().getUTCHours()) %>, <%= _user.username %></h1>
          <p class="dash-subtitle">Here's what's happening on <%= config.siteConfiguration.siteName %>.</p>
        </div>
        <a class="dash-visit" href="/" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square me-1" aria-hidden="true"></i>View site</a>
      </div>

      <%- include("../admin/_notices.ejs") %>

      <!-- ── Needs attention ────────────────────────────────────────────── -->
      <% if (overview.attention.length) { %>
        <section class="dash-section" aria-labelledby="dashAttention">
          <div class="dash-section-head">
            <h2 id="dashAttention">Needs attention</h2>
            <% if (overview.allClear) { %><span class="dash-clear"><i class="fa-solid fa-circle-check me-1"></i>All clear</span><% } %>
          </div>
          <div class="dash-tiles">
            <% overview.attention.forEach(function (t) { %>
              <a class="dash-tile <%= t.value ? 'is-active' : 'is-zero' %>" href="<%= t.href %>">
                <span class="dash-tile-icon stat-icon <%= t.tone %>"><i class="<%= t.icon %>" aria-hidden="true"></i></span>
                <span class="dash-tile-body">
                  <span class="dash-tile-value"><%= t.value %></span>
                  <span class="dash-tile-label"><%= t.label %></span>
                  <% if (t.detail) { %><span class="dash-tile-detail"><%= t.detail %></span><% } %>
                </span>
                <i class="fa-solid fa-chevron-right dash-tile-go" aria-hidden="true"></i>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- ── At a glance ────────────────────────────────────────────────── -->
      <% if (overview.stats.length) { %>
        <section class="dash-section" aria-labelledby="dashGlance">
          <div class="dash-section-head"><h2 id="dashGlance">At a glance</h2></div>
          <div class="dash-stats">
            <% overview.stats.forEach(function (t) { %>
              <a class="dash-stat" href="<%= t.href %>">
                <span class="dash-stat-label"><i class="<%= t.icon %> me-1" aria-hidden="true"></i><%= t.label %></span>
                <span class="dash-stat-value"><%= typeof t.value === "number" ? t.value.toLocaleString("en-US") : t.value %></span>
                <% if (t.detail) { %><span class="dash-stat-detail"><%= t.detail %></span><% } %>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <div class="dash-columns">
        <!-- ── Recent announcements ─────────────────────────────────────── -->
        <% if (features.announcements) { %>
          <section class="wp-card dash-card">
            <div class="wp-card-header">
              <h2 class="wp-card-title"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Recent announcements</h2>
              <a class="dash-link" href="/dashboard/announcements">View all</a>
            </div>
            <% if (!recentAnnouncements.length) { %>
              <div class="wp-empty-state"><i class="fa-solid fa-bullhorn"></i><p>No announcements yet.</p></div>
            <% } else { %>
              <ul class="dash-list">
                <% recentAnnouncements.forEach(function (ann) {
                     const now = new Date();
                     const ended = ann.endDate && new Date(ann.endDate) < now;
                     const scheduled = ann.startDate && new Date(ann.startDate) > now;
                     const status = scheduled ? ["pending", "Scheduled"] : ended ? ["inactive", "Ended"] : ann.enabled ? ["active", "Live"] : ["inactive", "Off"];
                %>
                  <li>
                    <span class="wp-badge info dash-type"><%= ann.announcementType %></span>
                    <a class="dash-list-text" href="/dashboard/announcements/edit?announcementId=<%= ann.announcementId %>" title="<%= ann.preview %>"><%= ann.preview %></a>
                    <span class="wp-badge <%= status[0] %>"><%= status[1] %></span>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </section>
        <% } %>

        <!-- ── Shortcuts + system ───────────────────────────────────────── -->
        <div class="dash-side">
          <% if (overview.actions.length) { %>
            <section class="wp-card dash-card">
              <div class="wp-card-header"><h2 class="wp-card-title"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Shortcuts</h2></div>
              <div class="dash-actions">
                <% overview.actions.forEach(function (a) { %>
                  <a class="dash-action" href="<%= a.href %>"><i class="<%= a.icon %>" aria-hidden="true"></i><span><%= a.label %></span></a>
                <% }) %>
              </div>
            </section>
          <% } %>

          <section class="wp-card dash-card">
            <div class="wp-card-header"><h2 class="wp-card-title"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i> System</h2></div>
            <ul class="dash-health">
              <li><span>Website</span><span class="dash-dot ok">Online</span></li>
              <li><span>Database</span><span class="dash-dot <%= system.databaseOnline ? 'ok' : 'bad' %>"><%= system.databaseOnline ? "Connected" : "Unreachable" %></span></li>
              <li><span>Discord bot</span><span class="dash-dot <%= system.discordOnline ? 'ok' : 'bad' %>"><%= system.discordOnline ? "Connected" : "Offline" %></span></li>
              <% if (_build.version || _build.shortCommit) { %>
                <li><span>Version</span><span class="text-muted">
                  <% if (_build.version) { %>v<%= _build.version %><% } %><% if (_build.shortCommit) { %> · <%= _build.shortCommit %><% } %>
                </span></li>
              <% } %>
            </ul>
          </section>
        </div>
      </div>

    </div><!-- /.wrap -->
  </div><!-- /#wpbody-content -->

  <script>
    // Greet by the viewer's own clock rather than the server's.
    (function () {
      var el = document.querySelector("[data-greeting]");
      if (!el) return;
      var h = new Date().getHours();
      var greeting = h < 5 ? "Good evening" : h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
      el.textContent = el.textContent.replace(/^Good (morning|afternoon|evening)/, greeting);
    })();
  </script>

  <%- include("../admin/_footer.ejs") %>
</div><!-- /#wpcontent -->
