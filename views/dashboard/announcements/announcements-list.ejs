<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<%
  const PLATFORM_META = {
    web:      { label: "Website banner",   icon: "fa-bullhorn" },
    popup:    { label: "Website popup",    icon: "fa-window-restore" },
    tip:      { label: "In-game tip",      icon: "fa-comment-dots" },
    motd:     { label: "Server-list MOTD", icon: "fa-server" },
    hologram: { label: "Hologram",         icon: "fa-cube" },
  };
  const STATUS_BADGE = { active: "success", scheduled: "info", ended: "secondary", disabled: "warning" };
  const fmtDate = (d) => {
    if (!d) return null;
    const x = new Date(d);
    return Number.isNaN(x.getTime()) ? null : x.toISOString();
  };
  const f = filters || { platform: "", status: "", group: "" };
%>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Announcements</h1>
        <div class="btn-toolbar mb-2 mb-md-0 gap-2">
          <a href="/dashboard/announcements/create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Create Announcement</a>
          <%- include("../../partials/documentationLink.ejs", {
            doclink: "https://anchorlight.dev/docs/products/zander/features/announcements"
          }) %>
        </div>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <!-- Filters -->
      <form method="get" action="/dashboard/announcements" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
          <label class="form-label small mb-0">Platform</label>
          <select name="platform" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All platforms</option>
            <% Object.keys(PLATFORM_META).forEach(function (p) {
              if (p === "hologram" && !hologramsEnabled) return; %>
              <option value="<%= p %>" <%= f.platform === p ? "selected" : "" %>><%= PLATFORM_META[p].label %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-auto">
          <label class="form-label small mb-0">Status</label>
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">Any status</option>
            <% ["active","scheduled","ended","disabled"].forEach(function (s) { %>
              <option value="<%= s %>" <%= f.status === s ? "selected" : "" %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
            <% }); %>
          </select>
        </div>
        <% if (f.platform === "hologram") { %>
          <div class="col-auto">
            <label class="form-label small mb-0">Hologram group</label>
            <select name="group" class="form-select form-select-sm" onchange="this.form.submit()">
              <option value="">All groups</option>
              <% (groups || []).forEach(function (g) { %>
                <option value="<%= g %>" <%= f.group === g ? "selected" : "" %>><%= g %></option>
              <% }); %>
            </select>
          </div>
        <% } %>
        <div class="col-auto">
          <a href="/dashboard/announcements" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
      </form>

      <% if (frames) { %>
        <!-- Hologram group reorder view -->
        <h2 class="h5 mb-3">Frames in <code><%= f.group %></code> <span class="text-muted">(in rotation order)</span></h2>
        <% if (!frames.length) { %>
          <div class="alert alert-info">No frames in this group yet.</div>
        <% } else { %>
          <table class="table table-sm align-middle">
            <thead><tr><th style="width:90px;">Order</th><th>Message</th><th>Status</th><th style="width:160px;">Actions</th></tr></thead>
            <tbody>
              <% frames.forEach(function (frame, i) { %>
                <tr>
                  <td>
                    <form method="post" action="/dashboard/announcements/move" class="d-inline">
                      <input type="hidden" name="id" value="<%= frame.announcementId %>">
                      <input type="hidden" name="returnTo" value="/dashboard/announcements?platform=hologram&group=<%= encodeURIComponent(f.group) %>">
                      <button type="submit" name="direction" value="up" class="btn btn-sm btn-outline-secondary" <%= i === 0 ? "disabled" : "" %>><i class="fas fa-arrow-up"></i></button>
                      <button type="submit" name="direction" value="down" class="btn btn-sm btn-outline-secondary" <%= i === frames.length - 1 ? "disabled" : "" %>><i class="fas fa-arrow-down"></i></button>
                    </form>
                  </td>
                  <td style="font-family:monospace;max-width:420px;word-break:break-word;"><%= frame.colourMessageFormat || frame.body || "" %></td>
                  <td><span class="badge bg-<%= frame.enabled ? "success" : "warning" %>"><%= frame.enabled ? "Enabled" : "Disabled" %></span></td>
                  <td>
                    <a href="/dashboard/announcements/edit?postId=<%= frame.postId %>" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen"></i></a>
                    <form method="post" action="/dashboard/announcements/delete" class="d-inline" onsubmit="return confirm('Delete this frame and its post?');">
                      <input type="hidden" name="postId" value="<%= frame.postId %>">
                      <input type="hidden" name="returnTo" value="/dashboard/announcements?platform=hologram&group=<%= encodeURIComponent(f.group) %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>

      <% } else { %>
        <!-- Post cards -->
        <% if (!posts || !posts.length) { %>
          <div class="alert alert-info">No announcements match these filters. <a href="/dashboard/announcements/create">Create one.</a></div>
        <% } else { %>
          <div class="row g-3">
            <% posts.forEach(function (post) {
              const starts = post.platforms.map(r => r.startDate).filter(Boolean).map(d => new Date(d).getTime());
              const ends   = post.platforms.map(r => r.endDate).filter(Boolean).map(d => new Date(d).getTime());
              const start  = starts.length ? new Date(Math.min(...starts)) : null;
              const end    = ends.length ? new Date(Math.max(...ends)) : null;
              const anyEnabled = post.platforms.some(r => r.enabled);
            %>
              <div class="col-12">
                <div class="card">
                  <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                      <div>
                        <h3 class="h6 mb-1"><%= post.title || "(untitled)" %></h3>
                        <div class="mb-2">
                          <% post.platforms.forEach(function (r) {
                            const m = PLATFORM_META[r.announcementType] || { label: r.announcementType, icon: "fa-tag" }; %>
                            <span class="badge bg-light text-dark border me-1"><i class="fas <%= m.icon %> me-1"></i><%= m.label %><%= r.enabled ? "" : " (off)" %></span>
                          <% }); %>
                        </div>
                        <div class="small text-muted">
                          <span class="badge bg-<%= STATUS_BADGE[post.status] || "secondary" %> me-2"><%= post.status %></span>
                          <span data-local-date="<%= start ? start.toISOString() : "" %>">Starts: <%= start ? start.toISOString() : "immediately" %></span>
                          &middot;
                          <span data-local-date="<%= end ? end.toISOString() : "" %>">Ends: <%= end ? end.toISOString() : "never" %></span>
                        </div>
                      </div>
                      <div class="btn-group">
                        <a href="/dashboard/announcements/edit?postId=<%= post.postId %>" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen"></i> Edit</a>
                        <form method="post" action="/dashboard/announcements/toggle" class="d-inline">
                          <input type="hidden" name="postId" value="<%= post.postId %>">
                          <input type="hidden" name="enabled" value="<%= anyEnabled ? "0" : "1" %>">
                          <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-power-off"></i> <%= anyEnabled ? "Disable all" : "Enable all" %></button>
                        </form>
                        <form method="post" action="/dashboard/announcements/delete" class="d-inline" onsubmit="return confirm('Delete this post and all its platform rows?');">
                          <input type="hidden" name="postId" value="<%= post.postId %>">
                          <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      <% } %>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>

<script>
  // Render the UTC schedule instants in the viewer's local timezone.
  document.querySelectorAll("[data-local-date]").forEach(function (el) {
    const iso = el.getAttribute("data-local-date");
    if (!iso) return;
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return;
    const label = el.textContent.split(":")[0];
    el.textContent = label + ": " + d.toLocaleString();
  });
</script>
