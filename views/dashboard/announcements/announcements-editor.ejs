<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<%
  // wizardState and hologramsEnabled are supplied by routes/dashboard/announcement.js.
  // wizardState carries ISO-UTC date strings; the client converts to/from local.
%>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><%= type === 'create' ? 'Create' : 'Edit' %> Announcement</h1>
        <div class="btn-toolbar mb-2 mb-md-0 gap-2">
          <a href="/dashboard/announcements" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back
          </a>
          <%- include("../../partials/documentationLink.ejs", {
            doclink: "https://anchorlight.dev/docs/products/zander/features/announcements"
          }) %>
        </div>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <!-- Stepper -->
      <ol class="wiz-steps list-unstyled d-flex flex-wrap gap-2 mb-4" id="wiz-steps">
        <li class="wiz-step active" data-step="1"><span class="wiz-num">1</span> Message</li>
        <li class="wiz-step" data-step="2"><span class="wiz-num">2</span> Platforms</li>
        <li class="wiz-step" data-step="3"><span class="wiz-num">3</span> Per-platform</li>
        <li class="wiz-step" data-step="4"><span class="wiz-num">4</span> Schedule</li>
        <li class="wiz-step" data-step="5"><span class="wiz-num">5</span> Review</li>
      </ol>

      <form id="wizard-form" method="post" action="/dashboard/announcements/save">
        <input type="hidden" name="payload" id="wizard-payload">

        <!-- Step 1: Message -->
        <section class="wiz-panel" data-step="1">
          <div class="mb-3">
            <label for="wiz-title" class="form-label">Post title <span class="text-muted">(optional)</span></label>
            <input type="text" class="form-control" id="wiz-title" maxlength="120"
                   placeholder="Defaults to the start of the message">
          </div>
          <div class="mb-3">
            <label for="wiz-body" class="form-label">Message</label>
            <textarea class="form-control" id="wiz-body" rows="4"
                      placeholder="The main message. Each platform can tweak this later."></textarea>
            <small class="text-muted">Seeds every platform; you can edit each one independently in step 3.</small>
          </div>
          <div class="mb-3">
            <label for="wiz-link" class="form-label">Link <span class="text-muted">(optional)</span></label>
            <input type="text" class="form-control" id="wiz-link" placeholder="/store, https://..., mailto:...">
          </div>
        </section>

        <!-- Step 2: Platforms -->
        <section class="wiz-panel d-none" data-step="2">
          <p class="text-muted">Choose where this announcement publishes. Each ticked platform gets its own tab next.</p>
          <div class="row g-3" id="platform-choices"></div>
          <div class="mt-3 d-none" id="hologram-group-wrap">
            <label for="wiz-hologram-group" class="form-label">Hologram group</label>
            <input type="text" class="form-control" id="wiz-hologram-group" list="hologram-groups"
                   maxlength="64" placeholder="default">
            <datalist id="hologram-groups">
              <% (groups || []).forEach(function (g) { %><option value="<%= g %>"></option><% }); %>
            </datalist>
            <small class="text-muted">Pick an existing group or type a new one. Holograms in a group cycle through its frames.</small>
          </div>
        </section>

        <!-- Step 3: Per-platform tabs -->
        <section class="wiz-panel d-none" data-step="3">
          <ul class="nav nav-tabs" id="platform-tabs" role="tablist"></ul>
          <div class="tab-content border border-top-0 p-3" id="platform-tab-panes"></div>
        </section>

        <!-- Step 4: Schedule -->
        <section class="wiz-panel d-none" data-step="4">
          <p class="text-muted">One window for every platform. Times are shown in your local timezone and stored as UTC.</p>
          <div class="row">
            <div class="mb-3 col-md-6">
              <label for="wiz-start" class="form-label">Start</label>
              <input type="datetime-local" class="form-control" id="wiz-start">
              <small class="text-muted">Leave blank to publish immediately.</small>
            </div>
            <div class="mb-3 col-md-6">
              <label for="wiz-end" class="form-label">End</label>
              <input type="datetime-local" class="form-control" id="wiz-end">
              <small class="text-muted">Leave blank to keep it active. Expired posts move to the "Ended" filter.</small>
            </div>
          </div>
          <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="per-platform-schedule">
            <label class="form-check-label" for="per-platform-schedule">Different times per platform</label>
          </div>
          <div id="per-platform-schedule-fields" class="d-none"></div>
        </section>

        <!-- Step 5: Review -->
        <section class="wiz-panel d-none" data-step="5">
          <div id="review-summary"></div>
          <div class="mt-4 d-flex gap-2">
            <button type="button" class="btn btn-primary" id="btn-publish"><i class="fas fa-paper-plane"></i> Publish</button>
            <button type="button" class="btn btn-outline-secondary" id="btn-draft"><i class="fas fa-save"></i> Save as draft</button>
          </div>
        </section>

        <!-- Nav -->
        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
          <button type="button" class="btn btn-outline-secondary" id="wiz-back" disabled><i class="fas fa-chevron-left"></i> Back</button>
          <button type="button" class="btn btn-primary" id="wiz-next">Next <i class="fas fa-chevron-right"></i></button>
        </div>
      </form>
    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>

<style>
.wiz-steps .wiz-step { padding:6px 12px; border-radius:20px; background:#eee; color:#666; font-size:13px; }
.wiz-steps .wiz-step.active { background:#2271b1; color:#fff; }
.wiz-steps .wiz-step.done { background:#c5e5c8; color:#13611b; }
.wiz-num { display:inline-block; width:18px; height:18px; line-height:18px; text-align:center; border-radius:50%; background:rgba(0,0,0,.15); font-size:11px; margin-right:4px; }
.mc-toolbar { display:flex; flex-wrap:wrap; gap:3px; align-items:center; }
.mc-code-btn { min-width:26px; height:24px; padding:0 5px; border:1px solid #ccc; border-radius:3px; cursor:pointer; font-size:11px; font-family:monospace; line-height:22px; background:#eee; color:#000; }
.mc-code-btn:hover { opacity:.75; }
.mc-fmt-btn { background:#555; color:#eee; border-color:#333; }
.mc-toolbar-sep { display:inline-block; width:1px; background:#ccc; height:20px; align-self:center; margin:0 4px; }
.mc-preview { background:#1d1d1d; border:1px solid #3a3a3a; border-radius:4px; padding:8px 10px; font-family:'Courier New',monospace; font-size:13px; color:#fff; margin-top:8px; min-height:28px; word-break:break-all; }
.len-warn { color:#b32d2e; }
.platform-card { cursor:pointer; border:1px solid #ddd; border-radius:6px; padding:12px; height:100%; }
.platform-card.selected { border-color:#2271b1; background:#eef6fc; }
</style>

<script>
(function () {
  const STATE = <%- JSON.stringify(wizardState) %>;
  const HOLOGRAMS_ENABLED = <%= hologramsEnabled ? 'true' : 'false' %>;

  const COLOURS = [
    ['&0','#000000','#fff'],['&1','#0000AA','#fff'],['&2','#00AA00','#fff'],['&3','#00AAAA','#fff'],
    ['&4','#AA0000','#fff'],['&5','#AA00AA','#fff'],['&6','#FFAA00','#000'],['&7','#AAAAAA','#000'],
    ['&8','#555555','#fff'],['&9','#5555FF','#fff'],['&a','#55FF55','#000'],['&b','#55FFFF','#000'],
    ['&c','#FF5555','#fff'],['&d','#FF55FF','#000'],['&e','#FFFF55','#000'],['&f','#FFFFFF','#000'],
  ];
  const FORMATS = [['&l','Bold'],['&o','Italic'],['&n','Underline'],['&m','Strike'],['&k','Obf'],['&r','Reset']];
  const MC_COLORS = Object.fromEntries(COLOURS.map(([c,hex]) => [c[1], hex]));

  const PLATFORM_META = {
    web:      { label: 'Website banner',  icon: 'fa-bullhorn',        colour: false },
    popup:    { label: 'Website popup',   icon: 'fa-window-restore',  colour: false },
    tip:      { label: 'In-game tip',     icon: 'fa-comment-dots',    colour: true  },
    motd:     { label: 'Server-list MOTD', icon: 'fa-server',         colour: true, maxLines: 2 },
    hologram: { label: 'Hologram',        icon: 'fa-cube',            colour: true  },
  };
  const ORDER = ['web', 'popup', 'tip', 'motd', 'hologram'];

  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

  // ── date helpers ──────────────────────────────────────────────────────────
  function isoToLocalInput(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
  }
  function localInputToIso(val) {
    if (!val) return null;
    const d = new Date(val);
    return Number.isNaN(d.getTime()) ? null : d.toISOString();
  }

  // ── Minecraft colour preview ────────────────────────────────────────────────
  function parseMc(text) {
    if (!text) return '&nbsp;';
    const parts = String(text).split(/([&§][0-9a-fk-or])/i);
    let color = '#FFFFFF', bold = false, italic = false, uline = false, strike = false, html = '';
    for (const part of parts) {
      const m = part.match(/^[&§]([0-9a-fk-or])$/i);
      if (m) {
        const code = ('&' + m[1]).toLowerCase();
        const hex = MC_COLORS[code];
        if (hex) { color = hex; bold = italic = uline = strike = false; }
        else if (code === '&r') { color = '#FFFFFF'; bold = italic = uline = strike = false; }
        else if (code === '&l') bold = true;
        else if (code === '&o') italic = true;
        else if (code === '&n') uline = true;
        else if (code === '&m') strike = true;
      } else if (part) {
        let style = 'color:' + color + ';';
        if (bold) style += 'font-weight:bold;';
        if (italic) style += 'font-style:italic;';
        const deco = [uline ? 'underline' : '', strike ? 'line-through' : ''].filter(Boolean).join(' ');
        if (deco) style += 'text-decoration:' + deco + ';';
        html += '<span style="' + style + '">' + esc(part) + '</span>';
      }
    }
    return html || '&nbsp;';
  }

  function insertAtCursor(el, text) {
    const start = el.selectionStart ?? el.value.length;
    const end = el.selectionEnd ?? el.value.length;
    el.value = el.value.slice(0, start) + text + el.value.slice(end);
    const pos = start + text.length;
    el.setSelectionRange(pos, pos);
    el.focus();
    el.dispatchEvent(new Event('input'));
  }

  function colourToolbar(targetId) {
    let html = '<div class="mc-toolbar mb-1">';
    for (const [code, bg, fg] of COLOURS) {
      html += `<button type="button" class="mc-code-btn" data-ins="${code}" data-target="${targetId}" title="${code}" style="background:${bg};color:${fg};">${esc(code)}</button>`;
    }
    html += '<span class="mc-toolbar-sep"></span>';
    for (const [code, name] of FORMATS) {
      html += `<button type="button" class="mc-code-btn mc-fmt-btn" data-ins="${code}" data-target="${targetId}" title="${name} (${code})">${esc(code)}</button>`;
    }
    html += '</div>';
    return html;
  }

  // ── Platform choice cards (step 2) ──────────────────────────────────────────
  function renderPlatformChoices() {
    const wrap = $('platform-choices');
    wrap.innerHTML = '';
    for (const p of ORDER) {
      if (p === 'hologram' && !HOLOGRAMS_ENABLED) continue;
      const meta = PLATFORM_META[p];
      const sel = STATE.platforms[p].selected;
      const col = document.createElement('div');
      col.className = 'col-md-4 col-sm-6';
      col.innerHTML = `
        <label class="platform-card d-block ${sel ? 'selected' : ''}" data-platform="${p}">
          <input type="checkbox" class="form-check-input me-2" ${sel ? 'checked' : ''}>
          <i class="fas ${meta.icon} me-1"></i> ${meta.label}
        </label>`;
      const cb = col.querySelector('input');
      cb.addEventListener('change', () => {
        STATE.platforms[p].selected = cb.checked;
        col.querySelector('.platform-card').classList.toggle('selected', cb.checked);
        $('hologram-group-wrap').classList.toggle('d-none', !STATE.platforms.hologram.selected);
      });
      wrap.appendChild(col);
    }
    $('hologram-group-wrap').classList.toggle('d-none', !STATE.platforms.hologram.selected);
    $('wiz-hologram-group').value = STATE.platforms.hologram.hologramGroup || '';
  }

  function selectedPlatforms() {
    return ORDER.filter((p) => STATE.platforms[p].selected && (p !== 'hologram' || HOLOGRAMS_ENABLED));
  }

  // ── Per-platform tabs (step 3) ──────────────────────────────────────────────
  function renderPlatformTabs() {
    const tabs = $('platform-tabs');
    const panes = $('platform-tab-panes');
    tabs.innerHTML = '';
    panes.innerHTML = '';
    const sel = selectedPlatforms();
    sel.forEach((p, i) => {
      const meta = PLATFORM_META[p];
      const tab = document.createElement('li');
      tab.className = 'nav-item';
      tab.innerHTML = `<a class="nav-link ${i === 0 ? 'active' : ''}" href="#" data-tab="${p}"><i class="fas ${meta.icon} me-1"></i>${meta.label}</a>`;
      tab.querySelector('a').addEventListener('click', (e) => {
        e.preventDefault();
        tabs.querySelectorAll('.nav-link').forEach((n) => n.classList.remove('active'));
        e.currentTarget.classList.add('active');
        panes.querySelectorAll('[data-pane]').forEach((n) => n.classList.toggle('d-none', n.dataset.pane !== p));
      });
      tabs.appendChild(tab);
      panes.appendChild(buildPane(p, i === 0));
    });
  }

  function field(label, html, hint) {
    return `<div class="mb-3"><label class="form-label">${label}</label>${html}${hint ? `<small class="text-muted d-block">${hint}</small>` : ''}</div>`;
  }

  function buildPane(p, visible) {
    const meta = PLATFORM_META[p];
    const st = STATE.platforms[p];
    const pane = document.createElement('div');
    pane.dataset.pane = p;
    if (!visible) pane.classList.add('d-none');

    let html = '';
    const msgId = `fld-${p}-msg`;
    const prevId = `prev-${p}`;
    const warnId = `warn-${p}`;

    if (meta.colour) {
      html += `<div class="mb-3"><label class="form-label">Message (colour codes)</label>${colourToolbar(msgId)}
        <textarea id="${msgId}" class="form-control" rows="3" style="font-family:monospace;">${esc(st.colourMessageFormat || '')}</textarea>
        <small class="text-muted d-block"><span id="${warnId}" ></span></small>
        <div class="mc-preview" id="${prevId}"></div></div>`;
    } else {
      html += field('Message', `<textarea id="${msgId}" class="form-control" rows="3">${esc(st.body || '')}</textarea>`,
        `<span id="${warnId}"></span>`);
    }

    if (p === 'web' || p === 'popup' || p === 'tip' || p === 'hologram') {
      html += field('Link (optional)', `<input type="text" id="fld-${p}-link" class="form-control" value="${esc(st.link || '')}" placeholder="/store, https://...">`);
    }
    if (p === 'popup') {
      html += field('Button text (optional)', `<input type="text" id="fld-popup-btn" class="form-control" maxlength="60" value="${esc(st.popupButtonText || '')}">`, '60 characters max.');
      html += field('Image URL (optional)', `<input type="url" id="fld-popup-img" class="form-control" value="${esc(st.popupImageUrl || '')}" placeholder="https://...">`);
    }
    if (p === 'hologram') {
      html += `<div class="row"><div class="col-md-6">${field('Group', `<input type="text" id="fld-holo-group" class="form-control" list="hologram-groups" maxlength="64" value="${esc(st.hologramGroup || 'default')}">`)}</div>
        <div class="col-md-6">${field('Sort order', `<input type="number" id="fld-holo-sort" class="form-control" value="${Number.isFinite(st.sortOrder) ? st.sortOrder : 0}">`, 'Lower shows first.')}</div></div>`;
      const cdOn = !!st.countdownTo;
      html += `<div class="card mb-3"><div class="card-body">
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="fld-holo-cd-on" ${cdOn ? 'checked' : ''}>
          <label class="form-check-label" for="fld-holo-cd-on">Count down to a date &amp; time</label></div>
        <div id="fld-holo-cd-wrap" class="${cdOn ? '' : 'd-none'}">
          <div class="row"><div class="col-md-6">${field('Target (local)', `<input type="datetime-local" id="fld-holo-cd" class="form-control" value="${isoToLocalInput(st.countdownTo)}">`)}</div>
          <div class="col-md-6">${field('Finished text (optional)', `<input type="text" id="fld-holo-cdtext" class="form-control" maxlength="512" value="${esc(st.countdownFinishedText || '')}">`)}</div></div>
          <div><span class="text-muted small me-1">Insert:</span>
          ${['{countdown}','{days}','{hours}','{minutes}','{seconds}'].map((t) => `<button type="button" class="btn btn-sm btn-outline-secondary" data-ins="${t}" data-target="${msgId}">${t}</button>`).join(' ')}</div>
        </div></div></div>`;
    }

    pane.innerHTML = html;

    // wire message + preview + warnings
    const msg = pane.querySelector('#' + msgId);
    const prev = pane.querySelector('#' + prevId);
    const warn = pane.querySelector('#' + warnId);
    function update() {
      if (prev) {
        const lines = msg.value.split('\n').map(parseMc).join('<br>');
        prev.innerHTML = lines;
      }
      if (warn) {
        const len = msg.value.length;
        let w = `${len} chars`;
        if (meta.maxLines && msg.value.split(/\r\n|\r|\n/).length > meta.maxLines) {
          w = `<span class="len-warn">A ${meta.label} is ${meta.maxLines} lines at most.</span>`;
        }
        warn.innerHTML = w;
      }
    }
    msg.addEventListener('input', update);
    update();

    // countdown toggle
    const cdOn = pane.querySelector('#fld-holo-cd-on');
    if (cdOn) cdOn.addEventListener('change', () => pane.querySelector('#fld-holo-cd-wrap').classList.toggle('d-none', !cdOn.checked));

    // insert buttons (colour + placeholder)
    pane.querySelectorAll('[data-ins]').forEach((btn) => btn.addEventListener('click', () => {
      const target = document.getElementById(btn.dataset.target);
      if (target) insertAtCursor(target, btn.dataset.ins);
    }));

    // popup button length warning
    const btnText = pane.querySelector('#fld-popup-btn');
    if (btnText) btnText.addEventListener('input', () => {
      btnText.classList.toggle('is-invalid', btnText.value.length > 60);
    });

    return pane;
  }

  function readPaneInto(p) {
    const st = STATE.platforms[p];
    const g = (id) => { const el = document.getElementById(id); return el ? el.value : undefined; };
    const meta = PLATFORM_META[p];
    if (meta.colour) st.colourMessageFormat = g(`fld-${p}-msg`) ?? st.colourMessageFormat;
    else st.body = g(`fld-${p}-msg`) ?? st.body;
    const link = g(`fld-${p}-link`); if (link !== undefined) st.link = link;
    if (p === 'popup') { st.popupButtonText = g('fld-popup-btn') ?? ''; st.popupImageUrl = g('fld-popup-img') ?? ''; }
    if (p === 'hologram') {
      st.hologramGroup = g('fld-holo-group') ?? 'default';
      st.sortOrder = Number(g('fld-holo-sort')) || 0;
      const cdOn = document.getElementById('fld-holo-cd-on');
      st.countdownTo = (cdOn && cdOn.checked) ? localInputToIso(g('fld-holo-cd')) : null;
      st.countdownFinishedText = st.countdownTo ? (g('fld-holo-cdtext') || '') : '';
    }
  }
  function readAllPanes() { selectedPlatforms().forEach(readPaneInto); }

  // ── Step 4: per-platform schedule overrides ─────────────────────────────────
  function renderPerPlatformSchedule() {
    const wrap = $('per-platform-schedule-fields');
    wrap.innerHTML = '';
    selectedPlatforms().forEach((p) => {
      const st = STATE.platforms[p];
      const div = document.createElement('div');
      div.className = 'border rounded p-2 mb-2';
      div.innerHTML = `<strong>${PLATFORM_META[p].label}</strong>
        <div class="row mt-1">
          <div class="col-md-6"><label class="form-label small">Start</label><input type="datetime-local" class="form-control form-control-sm" id="sch-${p}-start" value="${isoToLocalInput(st.startDate)}"></div>
          <div class="col-md-6"><label class="form-label small">End</label><input type="datetime-local" class="form-control form-control-sm" id="sch-${p}-end" value="${isoToLocalInput(st.endDate)}"></div>
        </div>`;
      wrap.appendChild(div);
    });
  }

  // ── Step 5: review ──────────────────────────────────────────────────────────
  function fmt(iso) { return iso ? new Date(iso).toLocaleString() : 'always'; }
  function renderReview() {
    const perPlatform = $('per-platform-schedule').checked;
    const rows = selectedPlatforms().map((p) => {
      const st = STATE.platforms[p];
      const text = PLATFORM_META[p].colour ? (st.colourMessageFormat || '') : (st.body || '');
      const start = perPlatform ? st.startDate : STATE._sharedStart;
      const end = perPlatform ? st.endDate : STATE._sharedEnd;
      return `<tr><td><i class="fas ${PLATFORM_META[p].icon} me-1"></i>${PLATFORM_META[p].label}</td>
        <td style="max-width:320px;word-break:break-word;">${esc(text.slice(0, 160))}</td>
        <td>${fmt(start)}</td><td>${fmt(end)}</td></tr>`;
    }).join('');
    $('review-summary').innerHTML = rows
      ? `<table class="table table-sm table-bordered"><thead><tr><th>Platform</th><th>Message</th><th>Start</th><th>End</th></tr></thead><tbody>${rows}</tbody></table>`
      : '<div class="alert alert-warning">No platforms selected.</div>';
  }

  // ── Submit ──────────────────────────────────────────────────────────────────
  function buildPayload(draft) {
    readAllPanes();
    const perPlatform = $('per-platform-schedule').checked;
    const sharedStart = localInputToIso($('wiz-start').value);
    const sharedEnd = localInputToIso($('wiz-end').value);
    const platforms = selectedPlatforms().map((p) => {
      const st = STATE.platforms[p];
      let start = sharedStart, end = sharedEnd;
      if (perPlatform) {
        start = localInputToIso((document.getElementById(`sch-${p}-start`) || {}).value);
        end = localInputToIso((document.getElementById(`sch-${p}-end`) || {}).value);
      }
      const row = { platform: p, startDate: start, endDate: end, link: st.link || null };
      if (PLATFORM_META[p].colour) row.colourMessageFormat = st.colourMessageFormat || '';
      else row.body = st.body || '';
      if (p === 'popup') { row.popupButtonText = st.popupButtonText || null; row.popupImageUrl = st.popupImageUrl || null; }
      if (p === 'hologram') {
        row.hologramGroup = st.hologramGroup || 'default';
        row.sortOrder = Number.isFinite(st.sortOrder) ? st.sortOrder : 0;
        row.countdownTo = st.countdownTo || null;
        row.countdownFinishedText = st.countdownFinishedText || null;
      }
      return row;
    });
    return {
      postId: STATE.postId || null,
      title: $('wiz-title').value || null,
      shared: { enabled: !draft },
      platforms,
    };
  }

  function submit(draft) {
    const payload = buildPayload(draft);
    if (payload.platforms.length === 0) { alert('Choose at least one platform.'); return; }
    $('wizard-payload').value = JSON.stringify(payload);
    $('wizard-form').submit();
  }

  // ── Step navigation ─────────────────────────────────────────────────────────
  let step = 1;
  function showStep(n) {
    step = n;
    document.querySelectorAll('.wiz-panel').forEach((pnl) => pnl.classList.toggle('d-none', Number(pnl.dataset.step) !== n));
    document.querySelectorAll('.wiz-step').forEach((li) => {
      const s = Number(li.dataset.step);
      li.classList.toggle('active', s === n);
      li.classList.toggle('done', s < n);
    });
    $('wiz-back').disabled = n === 1;
    $('wiz-next').classList.toggle('d-none', n === 5);
    if (n === 3) renderPlatformTabs();
    if (n === 4) {
      STATE.platforms.hologram.hologramGroup = $('wiz-hologram-group').value || STATE.platforms.hologram.hologramGroup;
      renderPerPlatformSchedule();
      $('per-platform-schedule-fields').classList.toggle('d-none', !$('per-platform-schedule').checked);
    }
    if (n === 5) { readAllPanes(); renderReview(); }
  }

  function next() {
    if (step === 1) {
      STATE.title = $('wiz-title').value;
      STATE.shared = { body: $('wiz-body').value, link: $('wiz-link').value };
      // seed unedited platform bodies from the shared message
      for (const p of ORDER) {
        const st = STATE.platforms[p];
        if (PLATFORM_META[p].colour) { if (!st.colourMessageFormat) st.colourMessageFormat = $('wiz-body').value; }
        else if (!st.body) st.body = $('wiz-body').value;
        if (!st.link) st.link = $('wiz-link').value;
      }
    }
    if (step === 2) {
      if (selectedPlatforms().length === 0) { alert('Choose at least one platform.'); return; }
      STATE.platforms.hologram.hologramGroup = $('wiz-hologram-group').value || 'default';
    }
    if (step === 3) readAllPanes();
    if (step === 4) { STATE._sharedStart = localInputToIso($('wiz-start').value); STATE._sharedEnd = localInputToIso($('wiz-end').value); }
    showStep(Math.min(5, step + 1));
  }
  function back() { if (step > 1) { if (step === 3) readAllPanes(); showStep(step - 1); } }

  // ── Init ────────────────────────────────────────────────────────────────────
  function init() {
    $('wiz-title').value = STATE.title || '';
    $('wiz-body').value = (STATE.shared && STATE.shared.body) || '';
    $('wiz-link').value = (STATE.shared && STATE.shared.link) || '';
    $('wiz-start').value = isoToLocalInput(STATE._sharedStart);
    $('wiz-end').value = isoToLocalInput(STATE._sharedEnd);
    if (STATE._perPlatform) $('per-platform-schedule').checked = true;
    renderPlatformChoices();
    $('wiz-next').addEventListener('click', next);
    $('wiz-back').addEventListener('click', back);
    $('btn-publish').addEventListener('click', () => submit(false));
    $('btn-draft').addEventListener('click', () => submit(true));
    $('per-platform-schedule').addEventListener('change', (e) => {
      $('per-platform-schedule-fields').classList.toggle('d-none', !e.target.checked);
      if (e.target.checked) renderPerPlatformSchedule();
    });
    document.querySelectorAll('.wiz-step').forEach((li) => li.addEventListener('click', () => {
      const target = Number(li.dataset.step);
      if (target < step) { if (step === 3) readAllPanes(); showStep(target); }
    }));
    showStep(1);
  }
  document.addEventListener('DOMContentLoaded', init);
})();
</script>
