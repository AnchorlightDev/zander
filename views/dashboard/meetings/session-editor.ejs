<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<%
  // Loaded as a manager, so the notes below include ones that are not yet
  // revealed to anyone else — the organiser cannot schedule a reveal they
  // cannot see.  Every visibility badge is rendered so it is obvious which
  // notes are which.
  function offsetLabel(ms) {
    if (ms === null || ms === undefined) return "not discussed";
    const total = Math.floor(Number(ms) / 1000);
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    const pad = (v) => String(v).padStart(2, "0");
    return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
  }

  const archiveStatus = session.archiveStatus;
  const canConfirmArchive = archiveStatus === "ready" && !session.archiveConfirmedAt;
  const canRemoveAudio = archiveStatus === "ready" && !!session.archiveConfirmedAt && !session.audioRemovedAt;
%>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <div>
          <h1 class="h2 mb-1">Edit: <%= session.event && session.event.title ? session.event.title : ("Session #" + session.sessionId) %></h1>
          <span class="badge bg-secondary"><%= session.status %></span>
          <small class="text-muted ms-2">Session #<%= session.sessionId %></small>
        </div>
        <div class="btn-toolbar mb-2 mb-md-0 gap-2">
          <a href="/dashboard/meetings/session?sessionId=<%= session.sessionId %>" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-play fa-fw me-1"></i>Open player
          </a>
        </div>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <div class="row g-4">
        <div class="col-lg-7">
          <!-- ============================ Settings ============================ -->
          <h2 class="h5">Session</h2>
          <form id="sessionForm" class="border rounded p-3 mb-4">
            <input type="hidden" name="sessionId" value="<%= session.sessionId %>">

            <div class="mb-3">
              <label class="form-label small text-muted mb-1" for="summary">Summary</label>
              <textarea class="form-control" id="summary" name="summary" rows="3"><%= session.summary || "" %></textarea>
            </div>

            <div class="row g-3">
              <div class="col-sm-6">
                <label class="form-label small text-muted mb-1" for="audienceMode">Who may view</label>
                <select class="form-select" id="audienceMode" name="audienceMode">
                  <option value="roster" <%= session.audienceMode === "roster" ? "selected" : "" %>>Roster only</option>
                  <option value="open" <%= session.audienceMode === "open" ? "selected" : "" %>>Any logged-in user</option>
                </select>
              </div>
              <div class="col-sm-6">
                <label class="form-label small text-muted mb-1" for="noteRevealMode">Default note reveal</label>
                <select class="form-select" id="noteRevealMode" name="noteRevealMode">
                  <option value="immediate" <%= session.noteRevealMode === "immediate" ? "selected" : "" %>>Immediate</option>
                  <option value="on_playback" <%= session.noteRevealMode === "on_playback" ? "selected" : "" %>>When playback reaches it</option>
                  <option value="scheduled" <%= session.noteRevealMode === "scheduled" ? "selected" : "" %>>At a set time</option>
                </select>
              </div>
              <div class="col-sm-6">
                <label class="form-label small text-muted mb-1" for="responseDeadlineAt">Comments close</label>
                <input type="datetime-local" class="form-control" id="responseDeadlineAt" name="responseDeadlineAt"
                       value="<%= session.responseDeadlineAt ? new Date(session.responseDeadlineAt).toISOString().slice(0,16) : '' %>">
                <div class="form-text">Entered and stored in UTC; everyone sees it in their own timezone.</div>
              </div>
            </div>

            <div class="mt-3 d-flex gap-2">
              <button type="submit" class="btn btn-sm btn-primary">Save</button>
              <% if (session.status === "processing" || session.status === "draft") { %>
                <button type="button" class="btn btn-sm btn-success" data-action="/api/meetings/session/publish">Publish</button>
              <% } %>
              <% if (session.status === "published") { %>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="/api/meetings/session/close">Close comments</button>
              <% } %>
            </div>
          </form>

          <!-- ============================= Agenda ============================= -->
          <h2 class="h5">Agenda</h2>
          <p class="text-muted small">
            The agenda doubles as the recording's chapter list: the chair advancing it during the
            meeting — from the dashboard or with <code>/meeting next</code> — is what stamps the timeline.
          </p>

          <div class="border rounded mb-3">
            <% if (session.agendaItems.length === 0) { %>
              <div class="p-3 text-muted small">No agenda items yet.</div>
            <% } %>
            <% session.agendaItems.forEach(item => { %>
              <div class="p-3 border-bottom d-flex justify-content-between align-items-start gap-3">
                <div>
                  <strong><%= item.title %></strong>
                  <span class="badge bg-light text-dark ms-1"><%= item.status %></span>
                  <% if (item.hiddenUntilReached) { %>
                    <span class="badge bg-warning text-dark ms-1" title="Hidden from catch-up viewers until the meeting reaches it">hidden until reached</span>
                  <% } %>
                  <% if (item.brief) { %><div class="small text-muted"><%= item.brief %></div><% } %>
                  <div class="small text-muted"><%= offsetLabel(item.startOffsetMs) %> – <%= offsetLabel(item.endOffsetMs) %></div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        data-delete-item="<%= item.itemId %>" title="Comments and notes under this item are kept">
                  <i class="fas fa-trash fa-fw"></i>
                </button>
              </div>
            <% }) %>
          </div>

          <form id="agendaForm" class="border rounded p-3 mb-4">
            <input type="hidden" name="sessionId" value="<%= session.sessionId %>">
            <div class="row g-2">
              <div class="col-sm-5">
                <input type="text" class="form-control form-control-sm" name="title" placeholder="Agenda item title" required>
              </div>
              <div class="col-sm-5">
                <input type="text" class="form-control form-control-sm" name="brief" placeholder="Brief (optional)">
              </div>
              <div class="col-sm-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Add</button>
              </div>
            </div>
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" name="hiddenUntilReached" id="hiddenUntilReached">
              <label class="form-check-label small" for="hiddenUntilReached">
                Hide from catch-up viewers until the meeting reaches it
              </label>
            </div>
          </form>

          <!-- ============================ Minutes ============================ -->
          <h2 class="h5">Minutes</h2>
          <div class="border rounded mb-4">
            <% if (session.notes.length === 0) { %>
              <div class="p-3 text-muted small">No notes yet.</div>
            <% } %>
            <% session.notes.forEach(note => { %>
              <div class="p-3 border-bottom">
                <div class="small text-muted mb-1">
                  <span class="text-uppercase"><%= note.kind %></span>
                  · <%= note.authorName %>
                  · <span class="badge bg-light text-dark"><%= note.visibility %></span>
                  · <span class="badge bg-light text-dark"><%= note.revealMode %></span>
                  <% if (note.revealMode === "scheduled" && note.revealAt) { %>
                    · <span class="js-datetime" data-iso="<%= new Date(note.revealAt).toISOString() %>" data-fallback=""></span>
                  <% } %>
                </div>
                <div><%= note.body %></div>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="col-lg-5">
          <!-- ============================ Roster ============================ -->
          <h2 class="h5">Attendees</h2>
          <p class="text-muted small">
            A role is set here and nowhere else — nothing infers one from who spoke, so a quiet
            presenter keeps speaker access to the minutes and a chatty observer does not gain it.
          </p>

          <div class="border rounded mb-3">
            <% if (!session.attendees || session.attendees.length === 0) { %>
              <div class="p-3 text-muted small">Nobody on the roster yet.</div>
            <% } %>
            <% (session.attendees || []).forEach(attendee => { %>
              <div class="p-2 border-bottom d-flex justify-content-between align-items-center gap-2">
                <div class="small">
                  <%= attendee.username || ("User #" + attendee.userId) %>
                  <% if (attendee.attendedLive) { %>
                    <span class="badge bg-success" title="Spoke or was present in the call">live</span>
                  <% } %>
                  <% if (!attendee.canRespond) { %>
                    <span class="badge bg-warning text-dark" title="No usable website login">no login</span>
                  <% } %>
                  <span class="text-muted">· <%= attendee.source %><%= attendee.viaRankSlug ? (" · " + attendee.viaRankSlug) : "" %></span>
                </div>
                <select class="form-select form-select-sm w-auto" data-attendee-role="<%= attendee.userId %>">
                  <% ["chair", "speaker", "attendee", "observer"].forEach(role => { %>
                    <option value="<%= role %>" <%= attendee.role === role ? "selected" : "" %>><%= role %></option>
                  <% }) %>
                </select>
              </div>
            <% }) %>
          </div>

          <form id="rosterForm" class="border rounded p-3 mb-4">
            <input type="hidden" name="sessionId" value="<%= session.sessionId %>">
            <label class="form-label small text-muted mb-1" for="rankSlugs">Add everyone in these ranks</label>
            <select class="form-select" id="rankSlugs" name="rankSlugs" multiple size="6">
              <% rankSlugs.forEach(slug => { %>
                <option value="<%= slug %>"><%= slug %></option>
              <% }) %>
            </select>
            <div class="form-text">
              The poll roster is merged in automatically when this meeting came from one.
            </div>
            <button type="submit" class="btn btn-sm btn-primary mt-2">Refresh roster</button>
          </form>

          <!-- ============================ Archive ============================ -->
          <h2 class="h5">Archive</h2>
          <div class="border rounded p-3">
            <p class="small mb-2">
              Status: <span class="badge bg-secondary"><%= archiveStatus %></span>
              <% if (session.archiveBuiltAt) { %>
                · built <span class="js-datetime" data-iso="<%= new Date(session.archiveBuiltAt).toISOString() %>" data-fallback=""></span>
              <% } %>
            </p>

            <p class="text-muted small">
              The bundle holds the audio, the transcript as <code>.vtt</code> and <code>.txt</code>,
              the agenda and minutes as markdown, every voice note, and a <code>metadata.json</code>
              carrying the full timeline — so the meeting can be reconstructed with no database.
            </p>

            <% if (archiveStatus === "ready" && session.archivePath) { %>
              <a class="btn btn-sm btn-outline-primary mb-2" href="<%= session.archivePath %>">Download bundle</a>
            <% } %>

            <div class="d-flex flex-wrap gap-2">
              <button type="button" class="btn btn-sm btn-outline-secondary" data-action="/api/meetings/archive/request">
                <%= archiveStatus === "none" ? "Build archive" : "Rebuild archive" %>
              </button>

              <% if (canConfirmArchive) { %>
                <button type="button" class="btn btn-sm btn-success" data-action="/api/meetings/archive/confirm"
                        data-confirm="Only confirm once you have downloaded the bundle and checked it opens. This is what unlocks deleting the audio.">
                  I have checked the bundle
                </button>
              <% } %>

              <% if (canRemoveAudio) { %>
                <button type="button" class="btn btn-sm btn-outline-danger" data-action="/api/meetings/audio/remove"
                        data-confirm="Delete the hosted audio for this meeting? The notes, transcript and discussion are kept. This cannot be undone.">
                  Remove hosted audio
                </button>
              <% } %>
            </div>

            <% if (session.archiveConfirmedAt) { %>
              <p class="small text-success mt-2 mb-0">
                Bundle confirmed on
                <span class="js-datetime" data-iso="<%= new Date(session.archiveConfirmedAt).toISOString() %>" data-fallback=""></span>.
              </p>
            <% } else if (archiveStatus === "ready") { %>
              <p class="small text-muted mt-2 mb-0">
                The audio cannot be removed until somebody has opened this bundle and confirmed it.
              </p>
            <% } %>
          </div>
        </div>
      </div>
    </div><!-- /.wrap -->
  </div><!-- /#wpbody-content -->
  <%- include("../../admin/_footer.ejs") %>
</div><!-- /#wpcontent -->

<script>
(function () {
  'use strict';

  const sessionId = <%= session.sessionId %>;

  async function post(url, body) {
    const response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    return response.json();
  }

  function handle(payload) {
    if (payload.success) window.location.reload();
    else alert(payload.message || 'That did not work.');
  }

  document.getElementById('sessionForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(event.target);
    handle(await post('/api/meetings/session/update', {
      sessionId: sessionId,
      summary: data.get('summary'),
      audienceMode: data.get('audienceMode'),
      noteRevealMode: data.get('noteRevealMode'),
      // datetime-local has no zone; it is read back as UTC, which is what the
      // form text above tells the organiser.
      responseDeadlineAt: data.get('responseDeadlineAt') ? data.get('responseDeadlineAt') + 'Z' : null,
    }));
  });

  document.getElementById('agendaForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(event.target);
    handle(await post('/api/meetings/agenda/create', {
      sessionId: sessionId,
      title: data.get('title'),
      brief: data.get('brief'),
      hiddenUntilReached: data.get('hiddenUntilReached') === 'on',
    }));
  });

  document.getElementById('rosterForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const selected = Array.from(document.getElementById('rankSlugs').selectedOptions).map((o) => o.value);
    handle(await post('/api/meetings/attendees/refresh', { sessionId: sessionId, rankSlugs: selected }));
  });

  document.querySelectorAll('[data-delete-item]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!confirm('Delete this agenda item? Its comments and notes are kept.')) return;
      handle(await post('/api/meetings/agenda/delete', { itemId: Number(button.dataset.deleteItem) }));
    });
  });

  document.querySelectorAll('[data-attendee-role]').forEach((select) => {
    select.addEventListener('change', async () => {
      const payload = await post('/api/meetings/attendees/role', {
        sessionId: sessionId,
        userId: Number(select.dataset.attendeeRole),
        role: select.value,
      });
      if (!payload.success) alert(payload.message || 'Could not change that role.');
    });
  });

  document.querySelectorAll('[data-action]').forEach((button) => {
    button.addEventListener('click', async () => {
      const warning = button.dataset.confirm;
      if (warning && !confirm(warning)) return;
      button.disabled = true;
      handle(await post(button.dataset.action, { sessionId: sessionId }));
    });
  });

  document.querySelectorAll('.js-datetime').forEach((element) => {
    const parsed = element.dataset.iso ? new Date(element.dataset.iso) : null;
    element.textContent = parsed && !isNaN(parsed)
      ? parsed.toLocaleString(undefined, {
          year: 'numeric', month: 'short', day: 'numeric',
          hour: '2-digit', minute: '2-digit', timeZoneName: 'short',
        })
      : (element.dataset.fallback || '');
  });
})();
</script>
