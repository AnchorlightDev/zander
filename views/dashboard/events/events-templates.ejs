<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Event Templates</h1>
                <div class="btn-toolbar mb-2 mb-md-0 gap-2">
                    <a href="/dashboard/events" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-calendar fa-fw me-1"></i>Calendar
                    </a>
                    <a href="/dashboard/events/templates/create" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus fa-fw me-1"></i>New Template
                    </a>
                    <%- include("../../partials/documentationLink.ejs", {
                        doclink: "https://modularsoft.org/docs/products/zander/features/events/"
                    }) %>
                </div>
            </div>
      <%- include("../../admin/_notices.ejs") %>

            <p class="text-muted small">Templates store default event settings. <strong>Recurring</strong> templates auto-generate drafts on a schedule. <strong>Once-off / Master</strong> templates are reusable presets you manually apply by clicking "Generate Draft".</p>

            <% if (!apiData.success) { %>
                <%- include("../../partials/alert.ejs", { alertType: "danger", content: apiData.message }) %>
            <% } else if (!apiData.data || apiData.data.length === 0) { %>
                <div class="alert alert-info">
                    No templates yet. <a href="/dashboard/events/templates/create">Create your first template</a>.
                </div>
            <% } else { %>
                <div class="row g-3">
                    <% apiData.data.forEach(tmpl => { %>
                    <div class="col-md-6">
                        <div class="card h-100 <%= !tmpl.isActive ? 'border-secondary opacity-75' : '' %>">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span class="fw-semibold"><%= tmpl.title %></span>
                                <div class="d-flex gap-1 align-items-center">
                                    <% if (!tmpl.isActive) { %><span class="badge bg-secondary">Inactive</span><% } %>
                                    <% if (tmpl.recurrenceType === 'once') { %><span class="badge bg-purple text-white" style="background-color:#6f42c1" title="Once-off master template"><i class="fas fa-star fa-fw me-1"></i>Master</span>
                                    <% } else if (tmpl.autoGenerateDrafts) { %><span class="badge bg-info text-dark" title="Auto-generates drafts"><i class="fas fa-robot fa-fw"></i></span><% } %>
                                </div>
                            </div>
                            <div class="card-body">
                                <dl class="row mb-0 small">
                                    <dt class="col-5">Type</dt>
                                    <dd class="col-7">
                                        <% if (tmpl.recurrenceType === 'once') { %>
                                            Once-off
                                        <% } else { %>
                                            <%= tmpl.recurrenceType %>
                                            <% if (tmpl.recurrenceType === 'weekly' && tmpl.recurrenceDays) {
                                                const dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
                                                const days = Array.isArray(tmpl.recurrenceDays) ? tmpl.recurrenceDays : JSON.parse(tmpl.recurrenceDays || '[]');
                                            %>
                                            — <%= days.map(d => dayNames[d]).join(', ') %>
                                            <% } %>
                                        <% } %>
                                    </dd>
                                    <dt class="col-5">Default Time</dt>
                                    <dd class="col-7"><%= tmpl.defaultStartTime || '—' %> – <%= tmpl.defaultEndTime || '—' %></dd>
                                    <% if (tmpl.recurrenceType !== 'once') { %>
                                    <dt class="col-5">Draft Advance</dt>
                                    <dd class="col-7"><%= tmpl.draftAdvanceDays %> days before</dd>
                                    <dt class="col-5">Next Generate</dt>
                                    <dd class="col-7">
                                        <% if (tmpl.nextGenerateAt) { %>
                                            <span class="js-datetime" data-iso="<%= new Date(tmpl.nextGenerateAt).toISOString() %>"></span>
                                        <% } else { %><span class="text-muted">—</span><% } %>
                                    </dd>
                                    <% } %>
                                    <dt class="col-5">Events</dt>
                                    <dd class="col-7"><%= tmpl._count ? tmpl._count.events : 0 %> created</dd>
                                </dl>
                            </div>
                            <div class="card-footer d-flex gap-2">
                                <a href="/dashboard/events/templates/edit?templateId=<%= tmpl.templateId %>" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit me-1"></i>Edit
                                </a>
                                <button class="btn btn-sm btn-outline-primary btn-generate-draft" data-template-id="<%= tmpl.templateId %>" data-title="<%= tmpl.title %>" data-recurrence="<%= tmpl.recurrenceType %>">
                                    <i class="fas fa-plus me-1"></i>Generate Draft
                                </button>
                                <button class="btn btn-sm btn-outline-danger btn-delete-template ms-auto" data-template-id="<%= tmpl.templateId %>" data-title="<%= tmpl.title %>">
                                    <i class="fas fa-trash me-1"></i>Delete
                                </button>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } %>
    <%# Date picker for templates with no schedule of their own (master / once-off). %>
    <div class="modal fade" id="draftDateModal" tabindex="-1" aria-labelledby="draftDateModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="draftDateForm">
          <div class="modal-header">
            <h5 class="modal-title" id="draftDateModalLabel">Choose the event date</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="mb-2" id="draftDateMessage">Pick the date for the new event. The template's default times are used.</p>
            <input type="date" class="form-control" id="draftDateInput" required>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Generate Draft</button>
          </div>
        </form>
      </div>
    </div>
    </div><!-- /.wrap -->
  </div><!-- /#wpbody-content -->
  <%- include("../../admin/_footer.ejs") %>
</div><!-- /#wpcontent -->

<script>
document.querySelectorAll('.js-datetime').forEach(el => {
    const d = el.dataset.iso ? new Date(el.dataset.iso) : null;
    el.textContent = d && !isNaN(d) ? d.toLocaleString(undefined, {
        year: 'numeric', month: 'short', day: 'numeric',
        hour: '2-digit', minute: '2-digit', timeZoneName: 'short'
    }) : '—';
});

// POST JSON and always come back with { success, message, ... } -- a network
// failure or a non-JSON reply used to throw silently and leave the page as it
// was, looking like nothing happened until a refresh.
async function postJson(url, body) {
    try {
        const res = await fetch(url, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => null);
        if (!data) return { success: false, message: `The server returned an unexpected response (HTTP ${res.status}).` };
        return data;
    } catch (err) {
        return { success: false, message: 'Network error: ' + err.message };
    }
}

function tomorrowIso() {
    const d = new Date();
    d.setDate(d.getDate() + 1);
    return d.toISOString().slice(0, 10);
}

let pendingDraftButton = null;
const draftDateModalEl = document.getElementById('draftDateModal');

function askForDate(btn, message) {
    pendingDraftButton = btn;
    document.getElementById('draftDateMessage').textContent =
        message || "Pick the date for the new event. The template's default times are used.";
    const input = document.getElementById('draftDateInput');
    input.value = input.value || tomorrowIso();
    bootstrap.Modal.getOrCreateInstance(draftDateModalEl).show();
}

async function generateDraft(btn, targetDate) {
    btn.disabled = true;
    const data = await postJson('/api/events/templates/generate-draft', {
        templateId: btn.dataset.templateId,
        ...(targetDate ? { targetDate } : {}),
    });
    if (data.success) {
        window.location.href = `/dashboard/events/view?eventId=${data.data.eventId}`;
        return;
    }
    btn.disabled = false;
    if (data.needsDate && !targetDate) askForDate(btn, data.message);
    else alert('Error: ' + data.message);
}

document.querySelectorAll('.btn-generate-draft').forEach(btn => {
    btn.addEventListener('click', () => {
        // A master template has no schedule, so the date has to be picked.
        if (btn.dataset.recurrence === 'once') return askForDate(btn);
        if (!confirm(`Generate a draft event from template "${btn.dataset.title}"?`)) return;
        generateDraft(btn);
    });
});

document.getElementById('draftDateForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const date = document.getElementById('draftDateInput').value;
    if (!date || !pendingDraftButton) return;
    bootstrap.Modal.getOrCreateInstance(draftDateModalEl).hide();
    generateDraft(pendingDraftButton, date);
});

document.querySelectorAll('.btn-delete-template').forEach(btn => {
    btn.addEventListener('click', async () => {
        if (!confirm(`Delete template "${btn.dataset.title}"? This will not delete generated events.`)) return;
        btn.disabled = true;
        const data = await postJson('/api/events/templates/delete', { templateId: btn.dataset.templateId });
        if (data.success) {
            // Take the card off straight away, then reload for fresh counts.
            btn.closest('.col-md-6, .col-lg-4, .col-xl-4, .col-12, [class*="col-"]')?.remove();
            window.location.reload();
        } else {
            btn.disabled = false;
            alert('Error: ' + data.message);
        }
    });
});
</script>
