<script>
// ============================================================
// Hosts management
// ============================================================
function collectHosts() {
    const rows = document.querySelectorAll('#hostsContainer .host-row');
    return Array.from(rows).map(row => ({
        displayName: row.querySelector('.host-displayName')?.value || null,
        role: row.querySelector('.host-role')?.value || 'host',
        discordUserId: row.querySelector('.host-discordUserId')?.value || null,
        userId: row.querySelector('.host-userId')?.value || null,
    })).filter(h => h.userId || h.displayName);
}

function initHostRowSearch(row) {
    const searchInput = row.querySelector('.host-userSearch');
    const suggestionsEl = row.querySelector('.host-suggestions');
    const userIdInput = row.querySelector('.host-userId');
    const discordIdInput = row.querySelector('.host-discordUserId');
    const displayNameInput = row.querySelector('.host-displayName');

    if (!searchInput || !suggestionsEl) return;

    let searchTimeout;

    const clearSuggestions = () => {
        suggestionsEl.innerHTML = '';
        suggestionsEl.style.display = 'none';
    };

    const selectUser = (user) => {
        searchInput.value = user.username;
        userIdInput.value = user.userId;
        discordIdInput.value = user.discordId || '';
        displayNameInput.value = user.username;
        clearSuggestions();
    };

    const renderSuggestions = (results) => {
        clearSuggestions();
        if (!results.length) return;
        results.forEach(user => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-1 px-2';
            if (user.avatarUrl) {
                const img = document.createElement('img');
                img.src = user.avatarUrl;
                img.alt = '';
                img.width = 28;
                img.height = 28;
                img.className = 'rounded';
                btn.appendChild(img);
            }
            const span = document.createElement('span');
            span.textContent = user.username;
            span.className = 'flex-fill text-start small';
            btn.appendChild(span);
            btn.addEventListener('click', () => selectUser(user));
            suggestionsEl.appendChild(btn);
        });
        suggestionsEl.style.display = 'block';
    };

    const doSearch = async (term) => {
        if (!term || term.length < 2) { clearSuggestions(); return; }
        try {
            const res = await fetch(`/api/events/users/search?q=${encodeURIComponent(term)}`, {
                credentials: 'include',
                headers: { 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
            });
            if (!res.ok) { clearSuggestions(); return; }
            const data = await res.json();
            renderSuggestions(data.results || []);
        } catch { clearSuggestions(); }
    };

    searchInput.addEventListener('input', (e) => {
        userIdInput.value = '';
        discordIdInput.value = '';
        displayNameInput.value = e.target.value;
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => doSearch(e.target.value.trim()), 250);
    });

    document.addEventListener('click', (e) => {
        if (!row.contains(e.target)) clearSuggestions();
    });
}

function addHostRow(host = {}) {
    const tmpl = document.getElementById('hostRowTemplate').content.cloneNode(true);
    const row = tmpl.querySelector('.host-row');
    if (host.role) row.querySelector('.host-role').value = host.role;
    if (host.userId) {
        row.querySelector('.host-userId').value = host.userId;
        row.querySelector('.host-discordUserId').value = host.discordUserId || '';
        row.querySelector('.host-displayName').value = host.displayName || '';
        row.querySelector('.host-userSearch').value = host.displayName || '';
    }
    row.querySelector('.remove-host').addEventListener('click', () => row.remove());
    document.getElementById('hostsContainer').appendChild(row);
    initHostRowSearch(row);
}

document.getElementById('addHostBtn').addEventListener('click', () => addHostRow());

// Init search on existing rows rendered by EJS partial
document.querySelectorAll('#hostsContainer .host-row').forEach(initHostRowSearch);

// ============================================================
// Announcements management
// ============================================================
function collectAnnouncements() {
    const rows = document.querySelectorAll('#announcementsContainer .announcement-row');
    return Array.from(rows).map(row => ({
        label: row.querySelector('.ann-label')?.value || null,
        announcementType: row.querySelector('.ann-type')?.value || 'reminder',
        platform: row.querySelector('.ann-platform')?.value || 'discord',
        channelId: row.querySelector('.ann-channelId')?.value || null,
        contentTemplate: row.querySelector('.ann-contentTemplate')?.value || null,
        body: row.querySelector('.ann-body')?.value || null,
        colourMessageFormat: row.querySelector('.ann-colourMessageFormat')?.value || null,
        link: row.querySelector('.ann-link')?.value || null,
        popupButtonText: row.querySelector('.ann-popupButtonText')?.value || null,
        popupImageUrl: row.querySelector('.ann-popupImageUrl')?.value || null,
        triggerType: row.querySelector('.ann-trigger')?.value || 'before_event',
        offsetMinutes: parseInt(row.querySelector('.ann-offsetMinutes')?.value || '0') || null,
        enabled: row.querySelector('.ann-enabled')?.checked !== false,
    }));
}

function initAnnouncementRow(row) {
    row.querySelector('.remove-announcement')?.addEventListener('click', () => row.remove());

    const trigger = row.querySelector('.ann-trigger');
    const offsetGroup = row.querySelector('.ann-offset-group');
    const offsetLabel = row.querySelector('.ann-offset-label');
    if (trigger && offsetGroup) {
        const toggleOffset = () => {
            const v = trigger.value;
            offsetGroup.classList.toggle('d-none', v !== 'before_event' && v !== 'after_event');
            if (offsetLabel) offsetLabel.textContent = v === 'after_event' ? 'Minutes After' : 'Minutes Before';
        };
        trigger.addEventListener('change', toggleOffset);
        toggleOffset();
    }

    const platformSel = row.querySelector('.ann-platform');
    const togglePlatform = () => {
        const p = platformSel?.value || 'discord';
        row.querySelectorAll('.ann-discord-group').forEach(el => el.classList.toggle('d-none', p !== 'discord'));
        row.querySelector('.ann-body-group')?.classList.toggle('d-none', p === 'discord');
        row.querySelector('.ann-colour-group')?.classList.toggle('d-none', !['motd','tip'].includes(p));
        row.querySelector('.ann-link-group')?.classList.toggle('d-none', !['tip','web','popup'].includes(p));
        row.querySelectorAll('.ann-popup-group').forEach(el => el.classList.toggle('d-none', p !== 'popup'));
    };
    platformSel?.addEventListener('change', togglePlatform);
    togglePlatform();

    row.querySelectorAll('.ann-ts-insert').forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            const ta = row.querySelector('.ann-contentTemplate');
            if (!ta) return;
            const token = link.dataset.token;
            const start = ta.selectionStart, end = ta.selectionEnd;
            ta.value = ta.value.slice(0, start) + token + ta.value.slice(end);
            ta.selectionStart = ta.selectionEnd = start + token.length;
            ta.focus();
        });
    });
}

function addAnnouncementRow(ann = {}) {
    const tmpl = document.getElementById('announcementRowTemplate').content.cloneNode(true);
    const row = tmpl.querySelector('.announcement-row');
    if (ann.platform) row.querySelector('.ann-platform').value = ann.platform;
    if (ann.label) row.querySelector('.ann-label').value = ann.label;
    if (ann.announcementType) row.querySelector('.ann-type').value = ann.announcementType;
    if (ann.triggerType) row.querySelector('.ann-trigger').value = ann.triggerType;
    if (ann.offsetMinutes) row.querySelector('.ann-offsetMinutes').value = ann.offsetMinutes;
    const annChannelSel = row.querySelector('.ann-channelId');
    if (annChannelSel) populateTextChannelSelect(annChannelSel, ann.channelId || '');
    if (ann.contentTemplate) row.querySelector('.ann-contentTemplate').value = ann.contentTemplate;
    if (ann.body) row.querySelector('.ann-body').value = ann.body;
    if (ann.colourMessageFormat) row.querySelector('.ann-colourMessageFormat').value = ann.colourMessageFormat;
    if (ann.link) row.querySelector('.ann-link').value = ann.link;
    if (ann.popupButtonText) row.querySelector('.ann-popupButtonText').value = ann.popupButtonText;
    if (ann.popupImageUrl) row.querySelector('.ann-popupImageUrl').value = ann.popupImageUrl;
    if (ann.enabled === false) row.querySelector('.ann-enabled').checked = false;
    document.getElementById('announcementsContainer').appendChild(tmpl);
    initAnnouncementRow(row);
}

document.getElementById('addAnnouncementBtn').addEventListener('click', () => addAnnouncementRow());

// Re-hydrate existing announcement rows (server-rendered via partial)
document.querySelectorAll('#announcementsContainer .announcement-row').forEach(row => {
    // Partial already wired up trigger/platform toggle via its IIFE, but ensure remove is bound
    row.querySelector('.remove-announcement')?.addEventListener('click', () => row.remove());
});

// ============================================================
// Actions
// ============================================================
const DISCORD_GUILD_ID = '<%= config.discord?.guildId || "" %>';

function collectActions() {
    const actionTypes = ['discord_message', 'discord_guild_event', 'website_page'];
    return actionTypes.map(type => {
        const toggle = document.querySelector(`.action-toggle[data-action-type="${type}"]`);
        const cfgInputs = document.querySelectorAll(`[data-config-key][data-action-type="${type}"]`);
        const config = {};
        cfgInputs.forEach(inp => { if (inp.value) config[inp.dataset.configKey] = inp.value; });
        if (type === 'discord_guild_event' && DISCORD_GUILD_ID) {
            config.guildId = DISCORD_GUILD_ID;
        }
        return {
            actionType: type,
            trigger: 'on_publish',
            enabled: toggle ? toggle.checked : false,
            config,
        };
    });
}

// ============================================================
// Image upload + preview (Cloudinary)
// ============================================================
function setupImageUpload(hiddenId, fileId, uploadBtnId, manualId, previewId, statusId, clearBtnId, folder) {
    const hidden = document.getElementById(hiddenId);
    const fileInput = document.getElementById(fileId);
    const uploadBtn = document.getElementById(uploadBtnId);
    const manual = document.getElementById(manualId);
    const preview = document.getElementById(previewId);
    const statusEl = document.getElementById(statusId);
    const clearBtn = document.getElementById(clearBtnId);
    if (!hidden || !fileInput || !uploadBtn || !manual || !preview) return;

    function setUrl(url) {
        hidden.value = url;
        manual.value = url;
        const img = preview.querySelector('img');
        if (url && img) { img.src = url; preview.classList.remove('d-none'); }
        else { preview.classList.add('d-none'); }
    }

    fileInput.addEventListener('change', () => { uploadBtn.disabled = !fileInput.files.length; });

    uploadBtn.addEventListener('click', async () => {
        const file = fileInput.files[0];
        if (!file) return;
        uploadBtn.disabled = true;
        statusEl.className = 'small text-info';
        statusEl.textContent = 'Uploading…';
        statusEl.classList.remove('d-none');
        try {
            const fd = new FormData();
            fd.append('folder', folder);
            fd.append('file', file);
            const res = await fetch('/api/upload/image', {
                method: 'POST',
                body: fd,
            });
            const json = await res.json();
            if (json.success) {
                setUrl(json.data.url);
                statusEl.className = 'small text-success';
                statusEl.textContent = 'Uploaded!';
                fileInput.value = '';
            } else {
                statusEl.className = 'small text-danger';
                statusEl.textContent = json.message || 'Upload failed';
            }
        } catch {
            statusEl.className = 'small text-danger';
            statusEl.textContent = 'Upload failed';
        }
        uploadBtn.disabled = true;
        setTimeout(() => statusEl.classList.add('d-none'), 4000);
    });

    manual.addEventListener('change', () => setUrl(manual.value.trim()));

    if (clearBtn) {
        clearBtn.addEventListener('click', (e) => {
            e.preventDefault();
            setUrl('');
            fileInput.value = '';
        });
    }
}
setupImageUpload('bannerUrlInput', 'bannerFileInput', 'bannerUploadBtn', 'bannerUrlManual', 'bannerPreview', 'bannerUploadStatus', 'bannerClearBtn', 'zander/events/banners');
setupImageUpload('logoUrlInput', 'logoFileInput', 'logoUploadBtn', 'logoUrlManual', 'logoPreview', 'logoUploadStatus', 'logoClearBtn', 'zander/events/logos');

// ============================================================
// Timezone-aware datetime helpers
// ============================================================

/** Convert a UTC ISO string to a datetime-local input value in the given IANA timezone. */
function utcToLocalInput(utcIso, ianaTimezone) {
    const date = new Date(utcIso);
    const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: ianaTimezone,
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false,
    }).formatToParts(date);
    const p = {};
    parts.forEach(({ type, value }) => { p[type] = value; });
    const h = p.hour === '24' ? '00' : p.hour; // midnight edge case
    return `${p.year}-${p.month}-${p.day}T${h}:${p.minute}`;
}

/** Convert a datetime-local value ("YYYY-MM-DDTHH:mm") in the given IANA timezone to a UTC ISO string. */
function localInputToUtc(localStr, ianaTimezone) {
    // Treat localStr as UTC temporarily so we can use Intl to find the actual offset
    const asUtc = new Date(localStr + ':00Z');
    const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: ianaTimezone,
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
    }).formatToParts(asUtc);
    const p = {};
    parts.forEach(({ type, value }) => { p[type] = value; });
    const h = p.hour === '24' ? '00' : p.hour;
    const tzAsUtc = new Date(`${p.year}-${p.month}-${p.day}T${h}:${p.minute}:${p.second}Z`);
    // offset = how much asUtc differs from what the timezone "thinks" it is
    const offsetMs = asUtc.getTime() - tzAsUtc.getTime();
    return new Date(asUtc.getTime() + offsetMs).toISOString();
}

// Initialise timezone field and datetime inputs from browser locale
(function initTimezone() {
    const tzInput = document.getElementById('timezoneInput');
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    tzInput.value = tz;

    // Convert stored UTC values to local display
    ['startAt', 'endAt'].forEach(id => {
        const input = document.getElementById(id);
        const utc = input.dataset.utc;
        if (utc) input.value = utcToLocalInput(utc, tz);
    });
})();


// ============================================================
// Location picker
// ============================================================
(function initLocationPicker() {
    const typeInput  = document.getElementById('locationType');
    const sections   = { discord: document.getElementById('loc-discord'), minecraft: document.getElementById('loc-minecraft'), other: document.getElementById('loc-other') };
    const btns       = document.querySelectorAll('.loc-type-btn');

    function setType(type) {
        typeInput.value = type;
        Object.keys(sections).forEach(k => sections[k].classList.toggle('d-none', k !== type));
        btns.forEach(b => {
            b.classList.toggle('btn-primary', b.dataset.type === type);
            b.classList.toggle('btn-outline-secondary', b.dataset.type !== type);
        });
    }

    btns.forEach(b => b.addEventListener('click', () => setType(b.dataset.type)));

    // Discord voice channels
    const voiceSelect = document.getElementById('locationDiscordChannelId');
    const savedChannelId = '<%= ev.locationDiscordChannelId || "" %>';

    async function loadVoiceChannels() {
        try {
            const res = await fetch('/api/events/discord/voice-channels', {
                credentials: 'include',
                headers: { 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
            });
            const data = await res.json();
            voiceSelect.innerHTML = '<option value="">— select a channel —</option>';
            let lastCat = null;
            let grp;
            data.channels.forEach(ch => {
                if (ch.category !== lastCat) {
                    grp = document.createElement('optgroup');
                    grp.label = ch.category || 'Uncategorised';
                    voiceSelect.appendChild(grp);
                    lastCat = ch.category;
                }
                const opt = document.createElement('option');
                opt.value = ch.id;
                opt.textContent = ch.name;
                opt.dataset.name = ch.name;
                if (ch.id === savedChannelId) opt.selected = true;
                (grp || voiceSelect).appendChild(opt);
            });
            if (!data.channels.length) voiceSelect.innerHTML = '<option value="">No voice channels found</option>';
        } catch { voiceSelect.innerHTML = '<option value="">Failed to load channels</option>'; }
    }

    // channel name is captured at submit time from the selected option

    loadVoiceChannels();

    // Minecraft servers
    const mcSelect   = document.getElementById('minecraftServerSelect');
    const mcName     = document.getElementById('serverName');
    const mcIp       = document.getElementById('serverIp');

    async function loadMinecraftServers() {
        try {
            const res = await fetch('/api/server/get', {
                credentials: 'include',
                headers: { 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
            });
            const data = await res.json();
            mcSelect.innerHTML = '<option value="">— select a server —</option>';
            if (data.success && Array.isArray(data.data)) {
                data.data.forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.serverId;
                    opt.textContent = s.serverName || s.name;
                    opt.dataset.name = s.serverName || s.name;
                    opt.dataset.ip   = s.serverIp || s.ip || '';
                    // Pre-select if name matches stored value
                    if (mcName && opt.dataset.name === mcName.value) opt.selected = true;
                    mcSelect.appendChild(opt);
                });
            }
            if (!mcSelect.options.length || mcSelect.options.length === 1) {
                mcSelect.innerHTML = '<option value="">No servers found</option>';
            }
        } catch { mcSelect.innerHTML = '<option value="">Failed to load servers</option>'; }
    }

    mcSelect.addEventListener('change', () => {
        const opt = mcSelect.options[mcSelect.selectedIndex];
        if (mcName) mcName.value = opt?.dataset?.name || '';
        if (mcIp)   mcIp.value   = opt?.dataset?.ip   || '';
    });

    loadMinecraftServers();
})();

// ============================================================
// Discord text channel picker (for actions + announcements)
// ============================================================
let _textChannels = [];

function populateTextChannelSelect(select, selectedId) {
    select.innerHTML = '<option value="">— select a channel —</option>';
    let lastCat = null;
    let grp;
    _textChannels.forEach(ch => {
        if (ch.category !== lastCat) {
            grp = document.createElement('optgroup');
            grp.label = ch.category || 'Uncategorised';
            select.appendChild(grp);
            lastCat = ch.category;
        }
        const opt = document.createElement('option');
        opt.value = ch.id;
        opt.textContent = '#' + ch.name;
        if (ch.id === selectedId) opt.selected = true;
        (grp || select).appendChild(opt);
    });
    if (!_textChannels.length) {
        select.innerHTML = '<option value="">No text channels found</option>';
    }
}

(async function loadTextChannels() {
    try {
        const res = await fetch('/api/events/discord/text-channels', {
            credentials: 'include',
            headers: { 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
        });
        const data = await res.json();
        _textChannels = data.channels || [];
    } catch {
        _textChannels = [];
    }

    const actionSelect = document.getElementById('discordMessageChannelSelect');
    if (actionSelect) {
        populateTextChannelSelect(actionSelect, actionSelect.dataset.saved || '');
    }

    document.querySelectorAll('.ann-channelId').forEach(sel => {
        populateTextChannelSelect(sel, sel.dataset.saved || '');
    });
})();

// ============================================================
// Form submission
// ============================================================
document.getElementById('eventForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target;
    const formData = new FormData(form);
    const body = Object.fromEntries(formData.entries());

    // Sync Summernote description content
    if (typeof $.fn.summernote !== 'undefined') {
        body.description = $('#descriptionEditor').summernote('code');
    }

    // Convert local datetimes to UTC ISO strings using the selected timezone
    const tz = document.getElementById('timezoneInput').value.trim() ||
                Intl.DateTimeFormat().resolvedOptions().timeZone;
    body.timezone = tz;
    if (body.startAt) body.startAt = localInputToUtc(body.startAt, tz);
    if (body.endAt)   body.endAt   = localInputToUtc(body.endAt,   tz);

    // Location — consolidate based on active type
    const locType = document.getElementById('locationType').value;
    body.locationType = locType;
    if (locType === 'discord') {
        const sel = document.getElementById('locationDiscordChannelId');
        body.locationDiscordChannelId = sel.value || null;
        body.locationLabel = sel.options[sel.selectedIndex]?.textContent?.trim() || null;
        body.serverName = null;
        body.serverIp   = null;
    } else if (locType === 'minecraft') {
        body.locationDiscordChannelId = null;
        body.locationLabel = document.getElementById('serverName')?.value || null;
        // serverName and serverIp come from FormData as-is
    } else {
        body.locationDiscordChannelId = null;
        body.locationLabel = document.getElementById('locationLabelOther')?.value || null;
        body.serverName = null;
        body.serverIp   = null;
    }

    // Tags
    const tagsRaw = document.getElementById('tagsInput').value;
    body.tags = tagsRaw.split(',').map(t => t.trim()).filter(Boolean);

    // Hosts
    body.hosts = collectHosts();

    // Actions
    body.actions = collectActions();

    // Announcements
    body.announcements = collectAnnouncements();

    // Boolean
    body.featured = document.getElementById('featuredCheck').checked;

    const saveBtn = document.getElementById('saveBtn');
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving…';

    try {
        const apiEndpoint = '<%= apiEndpoint %>';
        const res = await fetch(apiEndpoint, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json', 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
            body: JSON.stringify(body),
        });
        const data = await res.json();

        if (data.success) {
            // Also update actions and announcements separately
            const eventId = data.data?.eventId || body.eventId;
            await Promise.all([
                fetch('/api/events/actions/update', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json', 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
                    body: JSON.stringify({ eventId, actions: body.actions }),
                }),
                fetch('/api/events/announcements/update', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json', 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
                    body: JSON.stringify({ eventId, announcements: body.announcements }),
                }),
            ]);
            window.location.href = `/dashboard/events/view?eventId=${eventId}`;
        } else {
            alert('Error: ' + data.message);
            saveBtn.disabled = false;
            saveBtn.textContent = '<%= isPublished ? "Save & Sync" : (mode === "create" ? "Create Draft" : "Save Draft") %>';
        }
    } catch (err) {
        alert('Network error: ' + err.message);
        saveBtn.disabled = false;
    }
});

// Submit for review
const submitBtn = document.getElementById('submitReviewBtn');
if (submitBtn) {
    submitBtn.addEventListener('click', async () => {
        if (!confirm('Submit this event for admin review?')) return;
        const res = await fetch('/api/events/submit-review', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json', 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
            body: JSON.stringify({ eventId: submitBtn.dataset.eventId }),
        });
        const data = await res.json();
        if (data.success) window.location.href = `/dashboard/events/view?eventId=${submitBtn.dataset.eventId}`;
        else alert('Error: ' + data.message);
    });
}

