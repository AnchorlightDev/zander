<script>
// ============================================================
// Timezone-aware time helpers for default start/end time
// ============================================================
const _tz = Intl.DateTimeFormat().resolvedOptions().timeZone;

// Show timezone name in labels
document.querySelectorAll('.js-tz-label').forEach(el => {
    el.textContent = `In your local timezone (${_tz}).`;
});

/** Convert a stored UTC HH:MM:SS string to a local HH:MM string for <input type="time">. */
function utcTimeToLocal(utcTimeStr) {
    if (!utcTimeStr) return '';
    const [h, m] = utcTimeStr.split(':');
    const d = new Date();
    d.setUTCHours(parseInt(h, 10), parseInt(m, 10), 0, 0);
    const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: _tz, hour: '2-digit', minute: '2-digit', hour12: false,
    }).formatToParts(d);
    const p = {};
    parts.forEach(({ type, value }) => { p[type] = value; });
    const hh = p.hour === '24' ? '00' : p.hour;
    return `${hh}:${p.minute}`;
}

/** Convert a local HH:MM string from <input type="time"> back to UTC HH:MM:SS for storage. */
function localTimeToUtc(localTimeStr) {
    if (!localTimeStr) return '';
    const [h, m] = localTimeStr.split(':');
    const d = new Date();
    // Set to today's date in local time at that hour/minute, then read UTC
    const fake = new Date(`${d.toISOString().slice(0, 10)}T${h.padStart(2,'0')}:${m.padStart(2,'0')}:00`);
    // This parses as LOCAL time only in some environments; use Intl to be safe
    const asUtc = new Date(d.getFullYear(), d.getMonth(), d.getDate(), parseInt(h, 10), parseInt(m, 10), 0);
    return `${String(asUtc.getUTCHours()).padStart(2,'0')}:${String(asUtc.getUTCMinutes()).padStart(2,'0')}:00`;
}

// Init: convert stored UTC times to local for display
(function initTemplateTimes() {
    const startLocal = document.getElementById('defaultStartTimeLocal');
    const endLocal   = document.getElementById('defaultEndTimeLocal');
    if (startLocal) startLocal.value = utcTimeToLocal(startLocal.dataset.utc);
    if (endLocal)   endLocal.value   = utcTimeToLocal(endLocal.dataset.utc);
})();

// Recurrence type toggle
const recTypeSelect = document.getElementById('recurrenceType');
const weeklyOpts = document.getElementById('weeklyOptions');
const customOpts = document.getElementById('customOptions');
const recurringOpts = document.getElementById('recurringOptions');
const onceInfo = document.getElementById('onceInfo');

function toggleRecurrenceOptions() {
    const val = recTypeSelect.value;
    const isOnce = val === 'once';
    recurringOpts.classList.toggle('d-none', isOnce);
    onceInfo.classList.toggle('d-none', !isOnce);
    weeklyOpts.classList.toggle('d-none', val !== 'weekly');
    customOpts.classList.toggle('d-none', val !== 'custom');
}
recTypeSelect.addEventListener('change', toggleRecurrenceOptions);

// Hosts — autofill search
function initTemplateHostSearch(row) {
    const searchInput = row.querySelector('.host-userSearch');
    const suggestionsEl = row.querySelector('.host-suggestions');
    const userIdInput = row.querySelector('.host-userId');
    const discordIdInput = row.querySelector('.host-discordUserId');
    const displayNameInput = row.querySelector('.host-displayName');

    if (!searchInput || !suggestionsEl) return;

    let searchTimeout;

    const clearSuggestions = () => {
        suggestionsEl.innerHTML = '';
        suggestionsEl.style.display = 'none';
    };

    const selectUser = (user) => {
        searchInput.value = user.username;
        userIdInput.value = user.userId;
        discordIdInput.value = user.discordId || '';
        displayNameInput.value = user.username;
        clearSuggestions();
    };

    const renderSuggestions = (results) => {
        clearSuggestions();
        if (!results.length) return;
        results.forEach(user => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-1 px-2';
            if (user.avatarUrl) {
                const img = document.createElement('img');
                img.src = user.avatarUrl;
                img.alt = '';
                img.width = 28;
                img.height = 28;
                img.className = 'rounded';
                btn.appendChild(img);
            }
            const span = document.createElement('span');
            span.textContent = user.username;
            span.className = 'flex-fill text-start small';
            btn.appendChild(span);
            btn.addEventListener('click', () => selectUser(user));
            suggestionsEl.appendChild(btn);
        });
        suggestionsEl.style.display = 'block';
    };

    const doSearch = async (term) => {
        if (!term || term.length < 2) { clearSuggestions(); return; }
        try {
            const res = await fetch(`/api/events/users/search?q=${encodeURIComponent(term)}`, {
                credentials: 'include',
                headers: { 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
            });
            if (!res.ok) { clearSuggestions(); return; }
            const data = await res.json();
            renderSuggestions(data.results || []);
        } catch { clearSuggestions(); }
    };

    searchInput.addEventListener('input', (e) => {
        userIdInput.value = '';
        discordIdInput.value = '';
        displayNameInput.value = e.target.value;
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => doSearch(e.target.value.trim()), 250);
    });

    document.addEventListener('click', (e) => {
        if (!row.contains(e.target)) clearSuggestions();
    });
}

function addTemplateHost(host = {}) {
    const row = document.createElement('div');
    row.className = 'host-row border rounded p-3 mb-2 position-relative';
    row.innerHTML = `
        <button type="button" class="btn btn-xs btn-danger position-absolute top-0 end-0 m-2 remove-host">×</button>
        <div class="row g-2">
            <div class="col-md-5">
                <label class="form-label small">Player <span class="text-muted">(linked accounts only)</span></label>
                <div class="position-relative">
                    <input type="text" class="form-control form-control-sm host-userSearch" placeholder="Search by username…" autocomplete="off" value="${host.displayName||''}">
                    <div class="host-suggestions list-group position-absolute w-100" style="z-index:1000;top:100%;left:0;display:none;"></div>
                </div>
                <input type="hidden" class="host-userId" value="${host.userId||''}">
                <input type="hidden" class="host-discordUserId" value="${host.discordUserId||''}">
                <input type="hidden" class="host-displayName" value="${host.displayName||''}">
            </div>
            <div class="col-md-3"><label class="form-label small">Role</label>
                <select class="form-select form-select-sm host-role">
                    <option value="host" ${host.role==='host'?'selected':''}>Host</option>
                    <option value="co_host" ${host.role==='co_host'?'selected':''}>Co-Host</option>
                    <option value="coordinator" ${host.role==='coordinator'?'selected':''}>Coordinator</option>
                </select>
            </div>
        </div>`;
    row.querySelector('.remove-host').addEventListener('click', () => row.remove());
    document.getElementById('templateHostsContainer').appendChild(row);
    initTemplateHostSearch(row);
}

document.getElementById('addTemplateHostBtn').addEventListener('click', () => addTemplateHost());
document.querySelectorAll('#templateHostsContainer .remove-host').forEach(btn => {
    btn.addEventListener('click', () => btn.closest('.host-row').remove());
});
document.querySelectorAll('#templateHostsContainer .host-row').forEach(initTemplateHostSearch);

// Location picker
(function initTmplLocationPicker() {
    const typeInput = document.getElementById('tmplLocationType');
    const sections = {
        discord:   document.getElementById('tmpl-loc-discord'),
        minecraft: document.getElementById('tmpl-loc-minecraft'),
        other:     document.getElementById('tmpl-loc-other'),
    };
    const btns = document.querySelectorAll('.tmpl-loc-type-btn');

    function setType(type) {
        typeInput.value = type;
        Object.keys(sections).forEach(k => sections[k].classList.toggle('d-none', k !== type));
        btns.forEach(b => {
            b.classList.toggle('btn-primary', b.dataset.type === type);
            b.classList.toggle('btn-outline-secondary', b.dataset.type !== type);
        });
    }
    btns.forEach(b => b.addEventListener('click', () => setType(b.dataset.type)));

    // Load voice channels
    const voiceSelect = document.getElementById('tmplLocationDiscordChannelId');
    const savedChannelId = '<%= tmpl.locationDiscordChannelId || "" %>';
    async function loadVoiceChannels() {
        try {
            const res = await fetch('/api/events/discord/voice-channels', { credentials: 'include', headers: { 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> } });
            const data = await res.json();
            voiceSelect.innerHTML = '<option value="">— select a channel —</option>';
            let lastCat = null, grp;
            data.channels.forEach(ch => {
                if (ch.category !== lastCat) {
                    grp = document.createElement('optgroup');
                    grp.label = ch.category || 'Uncategorised';
                    voiceSelect.appendChild(grp);
                    lastCat = ch.category;
                }
                const opt = document.createElement('option');
                opt.value = ch.id;
                opt.textContent = ch.name;
                if (ch.id === savedChannelId) opt.selected = true;
                (grp || voiceSelect).appendChild(opt);
            });
            if (!data.channels.length) voiceSelect.innerHTML = '<option value="">No voice channels found</option>';
        } catch { voiceSelect.innerHTML = '<option value="">Failed to load channels</option>'; }
    }
    loadVoiceChannels();
})();

// Form submission
document.getElementById('templateForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);
    const body = Object.fromEntries(fd.entries());

    // Description is synced by summerNoteEditor partial before submit
    body.description = document.getElementById('tmplDescriptionEditor')?.value || '';

    // Convert local times back to UTC before submission
    const startLocalEl = document.getElementById('defaultStartTimeLocal');
    const endLocalEl   = document.getElementById('defaultEndTimeLocal');
    document.getElementById('defaultStartTimeUtc').value = startLocalEl?.value ? localTimeToUtc(startLocalEl.value) : '';
    document.getElementById('defaultEndTimeUtc').value   = endLocalEl?.value   ? localTimeToUtc(endLocalEl.value)   : '';

    // Recurrence days
    const days = Array.from(document.querySelectorAll('.recurrence-day:checked')).map(cb => parseInt(cb.value));
    body.recurrenceDays = days;
    const isOnce = body.recurrenceType === 'once';
    body.autoGenerateDrafts = isOnce ? false : document.getElementById('autoGenCheck').checked;
    body.isActive = document.getElementById('isActiveCheck').checked;
    body.recurrenceEveryDays = body.recurrenceEveryDays ? parseInt(body.recurrenceEveryDays) : null;
    body.defaultDurationMins = body.defaultDurationMins ? parseInt(body.defaultDurationMins) : null;
    body.draftAdvanceDays = parseInt(body.draftAdvanceDays) || 7;

    // Location — consolidate based on active type
    const locType = document.getElementById('tmplLocationType').value;
    body.locationType = locType;
    if (locType === 'discord') {
        const sel = document.getElementById('tmplLocationDiscordChannelId');
        body.locationDiscordChannelId = sel.value || null;
        body.locationLabel = sel.options[sel.selectedIndex]?.textContent?.trim() || null;
        body.serverName = null;
        body.serverIp = null;
    } else if (locType === 'minecraft') {
        body.locationDiscordChannelId = null;
        body.locationLabel = document.getElementById('tmplServerName')?.value || null;
        body.serverName = document.getElementById('tmplServerName')?.value || null;
        body.serverIp = document.getElementById('tmplServerIp')?.value || null;
    } else {
        body.locationDiscordChannelId = null;
        body.locationLabel = document.getElementById('tmplLocationLabelOther')?.value || null;
        body.serverName = null;
        body.serverIp = null;
    }

    // Hosts
    body.defaultHosts = Array.from(document.querySelectorAll('#templateHostsContainer .host-row')).map(row => ({
        displayName: row.querySelector('.host-displayName')?.value || null,
        role: row.querySelector('.host-role')?.value || 'host',
        discordUserId: row.querySelector('.host-discordUserId')?.value || null,
        userId: row.querySelector('.host-userId')?.value || null,
    })).filter(h => h.userId || h.displayName);

    const endpoint = '<%= mode === "create" ? "/api/events/templates/create" : "/api/events/templates/update" %>';
    const res = await fetch(endpoint, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json', 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
        body: JSON.stringify(body),
    });
    const data = await res.json();
    if (!data.success) { alert('Error: ' + data.message); return; }

    // Save announcements (use returned templateId for new templates)
    const savedTemplateId = data.data?.templateId || body.templateId;
    if (savedTemplateId) {
        const annRes = await fetch('/api/events/templates/announcements/update', {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json', 'x-access-token': <%- JSON.stringify(process.env.apiKey || '') %> },
            body: JSON.stringify({ templateId: savedTemplateId, announcements: collectTemplateAnnouncements() }),
        });
        const annData = await annRes.json();
        if (!annData.success) { alert('Template saved but announcements failed: ' + annData.message); return; }
    }

    window.location.href = '/dashboard/events/templates';
});

// Announcements
function initAnnouncementRow(row) {
    row.querySelector('.remove-announcement').addEventListener('click', () => row.remove());

    const trigger = row.querySelector('.ann-trigger');
    const offsetGroup = row.querySelector('.ann-offset-group');
    if (trigger && offsetGroup) {
        const toggleOffset = () => offsetGroup.classList.toggle('d-none', trigger.value !== 'before_event');
        trigger.addEventListener('change', toggleOffset);
        toggleOffset();
    }

    const platformSel = row.querySelector('.ann-platform');
    const togglePlatform = () => {
        const p = platformSel?.value || 'discord';
        row.querySelectorAll('.ann-discord-group').forEach(el => el.classList.toggle('d-none', p !== 'discord'));
        row.querySelector('.ann-body-group')?.classList.toggle('d-none', p === 'discord');
        row.querySelector('.ann-colour-group')?.classList.toggle('d-none', !['motd','tip'].includes(p));
        row.querySelector('.ann-link-group')?.classList.toggle('d-none', !['tip','web','popup'].includes(p));
        row.querySelectorAll('.ann-popup-group').forEach(el => el.classList.toggle('d-none', p !== 'popup'));
    };
    platformSel?.addEventListener('change', togglePlatform);
    togglePlatform();

    row.querySelectorAll('.ann-ts-insert').forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            const ta = row.querySelector('.ann-contentTemplate');
            const token = link.dataset.token;
            const start = ta.selectionStart, end = ta.selectionEnd;
            ta.value = ta.value.slice(0, start) + token + ta.value.slice(end);
            ta.selectionStart = ta.selectionEnd = start + token.length;
            ta.focus();
        });
    });
}

function addTemplateAnnouncementRow(ann = {}) {
    const tmpl = document.getElementById('tmplAnnouncementRowTemplate');
    const row = tmpl.content.cloneNode(true).querySelector('.announcement-row');
    if (ann.platform) row.querySelector('.ann-platform').value = ann.platform;
    if (ann.label) row.querySelector('.ann-label').value = ann.label;
    if (ann.announcementType) row.querySelector('.ann-type').value = ann.announcementType;
    if (ann.triggerType) row.querySelector('.ann-trigger').value = ann.triggerType;
    if (ann.offsetMinutes) row.querySelector('.ann-offsetMinutes').value = ann.offsetMinutes;
    if (ann.channelId) row.querySelector('.ann-channelId').value = ann.channelId;
    if (ann.contentTemplate) row.querySelector('.ann-contentTemplate').value = ann.contentTemplate;
    if (ann.body) row.querySelector('.ann-body').value = ann.body;
    if (ann.colourMessageFormat) row.querySelector('.ann-colourMessageFormat').value = ann.colourMessageFormat;
    if (ann.link) row.querySelector('.ann-link').value = ann.link;
    if (ann.popupButtonText) row.querySelector('.ann-popupButtonText').value = ann.popupButtonText;
    if (ann.popupImageUrl) row.querySelector('.ann-popupImageUrl').value = ann.popupImageUrl;
    if (ann.enabled === false) row.querySelector('.ann-enabled').checked = false;
    document.getElementById('templateAnnouncementsContainer').appendChild(row);
    initAnnouncementRow(row);
}

function collectTemplateAnnouncements() {
    return Array.from(document.querySelectorAll('#templateAnnouncementsContainer .announcement-row')).map(row => ({
        platform: row.querySelector('.ann-platform')?.value || 'discord',
        label: row.querySelector('.ann-label')?.value || null,
        announcementType: row.querySelector('.ann-type')?.value || 'reminder',
        channelId: row.querySelector('.ann-channelId')?.value || null,
        contentTemplate: row.querySelector('.ann-contentTemplate')?.value || null,
        body: row.querySelector('.ann-body')?.value || null,
        colourMessageFormat: row.querySelector('.ann-colourMessageFormat')?.value || null,
        link: row.querySelector('.ann-link')?.value || null,
        popupButtonText: row.querySelector('.ann-popupButtonText')?.value || null,
        popupImageUrl: row.querySelector('.ann-popupImageUrl')?.value || null,
        triggerType: row.querySelector('.ann-trigger')?.value || 'before_event',
        offsetMinutes: row.querySelector('.ann-offsetMinutes')?.value ? parseInt(row.querySelector('.ann-offsetMinutes').value) : null,
        enabled: row.querySelector('.ann-enabled')?.checked !== false,
    }));
}

document.getElementById('addTemplateAnnouncementBtn').addEventListener('click', () => addTemplateAnnouncementRow());
document.querySelectorAll('#templateAnnouncementsContainer .announcement-row').forEach(initAnnouncementRow);

// ============================================================
// Image upload + preview (Cloudinary)
// ============================================================
function setupImageUpload(hiddenId, fileId, uploadBtnId, manualId, previewId, statusId, clearBtnId, folder) {
    const hidden = document.getElementById(hiddenId);
    const fileInput = document.getElementById(fileId);
    const uploadBtn = document.getElementById(uploadBtnId);
    const manual = document.getElementById(manualId);
    const preview = document.getElementById(previewId);
    const statusEl = document.getElementById(statusId);
    const clearBtn = document.getElementById(clearBtnId);
    if (!hidden || !fileInput || !uploadBtn || !manual || !preview) return;

    function setUrl(url) {
        hidden.value = url;
        manual.value = url;
        const img = preview.querySelector('img');
        if (url && img) { img.src = url; preview.classList.remove('d-none'); }
        else { preview.classList.add('d-none'); }
    }

    fileInput.addEventListener('change', () => { uploadBtn.disabled = !fileInput.files.length; });

    uploadBtn.addEventListener('click', async () => {
        const file = fileInput.files[0];
        if (!file) return;
        uploadBtn.disabled = true;
        statusEl.className = 'small text-info';
        statusEl.textContent = 'Uploading…';
        statusEl.classList.remove('d-none');
        try {
            const fd = new FormData();
            fd.append('folder', folder);
            fd.append('file', file);
            const res = await fetch('/api/upload/image', {
                method: 'POST',
                body: fd,
            });
            const json = await res.json();
            if (json.success) {
                setUrl(json.data.url);
                statusEl.className = 'small text-success';
                statusEl.textContent = 'Uploaded!';
                fileInput.value = '';
            } else {
                statusEl.className = 'small text-danger';
                statusEl.textContent = json.message || 'Upload failed';
            }
        } catch {
            statusEl.className = 'small text-danger';
            statusEl.textContent = 'Upload failed';
        }
        uploadBtn.disabled = true;
        setTimeout(() => statusEl.classList.add('d-none'), 4000);
    });

    manual.addEventListener('change', () => setUrl(manual.value.trim()));

    if (clearBtn) {
        clearBtn.addEventListener('click', (e) => {
            e.preventDefault();
            setUrl('');
            fileInput.value = '';
        });
    }
}
setupImageUpload('bannerUrlInput', 'bannerFileInput', 'bannerUploadBtn', 'bannerUrlManual', 'bannerPreview', 'bannerUploadStatus', 'bannerClearBtn', 'zander/events/banners');
setupImageUpload('logoUrlInput', 'logoFileInput', 'logoUploadBtn', 'logoUrlManual', 'logoPreview', 'logoUploadStatus', 'logoClearBtn', 'zander/events/logos');
</script>
