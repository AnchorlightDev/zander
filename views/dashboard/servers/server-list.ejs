<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">

      <!-- ── Page header ─────────────────────────────────────────────────── -->
      <div class="wp-admin-page-header">
        <h1 class="wp-heading-inline">Servers</h1>
        <a href="/dashboard/servers/create" class="page-title-action">
          <i class="fas fa-plus" aria-hidden="true"></i> Add Server
        </a>
        <a href="https://modularsoft.org/docs/products/zander/features/server/"
           target="_blank" rel="noopener" class="page-title-action outline"
           title="Documentation">
          <i class="fas fa-book" aria-hidden="true"></i>
          <span class="d-none d-md-inline">Docs</span>
        </a>
      </div>
      <hr class="wp-section-divider">

      <%- include("../../admin/_notices.ejs") %>

      <!-- ── List table ──────────────────────────────────────────────────── -->
      <div class="wp-list-wrap">

        <div class="tablenav">
          <span class="text-muted-sm">
            <% if (apiData && apiData.data) { %>
              <%= apiData.data.length %> server<%= apiData.data.length !== 1 ? 's' : '' %>
            <% } %>
          </span>
        </div>

        <div class="table-responsive">
          <table class="wp-list-table wp-list-table-responsive" aria-label="Servers">
            <thead>
              <tr>
                <th scope="col">Display Name</th>
                <th scope="col">Connection Address</th>
                <th scope="col">Type</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>
            <tbody>

              <% if (!apiData || apiData.success === false) { %>
                <tr>
                  <td colspan="4">
                    <div class="wp-notice wp-notice-error" style="margin:0;">
                      <span class="wp-notice-icon"><i class="fas fa-times-circle"></i></span>
                      <p><%= apiData ? apiData.message : 'Failed to load servers.' %></p>
                    </div>
                  </td>
                </tr>

              <% } else if (!apiData.data || apiData.data.length === 0) { %>
                <tr>
                  <td colspan="4">
                    <div class="wp-empty-state">
                      <i class="fas fa-server"></i>
                      <p>No servers configured yet. <a href="/dashboard/servers/create">Add the first one.</a></p>
                    </div>
                  </td>
                </tr>

              <% } else { %>
                <% for (const srv of apiData.data) { %>
                  <%
                    const _typeCls = srv.serverType === 'INTERNAL'
                      ? 'blue'
                      : srv.serverType === 'EXTERNAL'
                      ? 'info'
                      : 'inactive';
                  %>
                  <tr>
                    <td data-label="Display Name">
                      <strong><%= srv.displayName || '—' %></strong>
                    </td>
                    <td data-label="Connection Address">
                      <code style="font-size:12px;"><%= srv.serverConnectionAddress || '—' %></code>
                    </td>
                    <td data-label="Type">
                      <span class="wp-badge <%= _typeCls %>"><%= srv.serverType || '—' %></span>
                    </td>
                    <td data-label="Actions">
                      <div class="row-actions">
                        <a class="row-action-btn edit"
                           href="/dashboard/servers/edit?id=<%= srv.serverId %>">
                          <i class="fas fa-pen" aria-hidden="true"></i> Edit
                        </a>
                        <form action="<%= process.env.siteAddress %>/redirect/server/delete" method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Delete server \'<%= srv.displayName %>\'?')">
                          <input type="hidden" name="serverId" value="<%= srv.serverId %>">
                          <button type="submit" class="row-action-btn danger">
                            <i class="fas fa-trash" aria-hidden="true"></i> Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% } %>
              <% } %>

            </tbody>
          </table>
        </div><!-- /table-responsive -->

      </div><!-- /wp-list-wrap -->

    </div><!-- /.wrap -->
  </div><!-- /#wpbody-content -->

  <%- include("../../admin/_footer.ejs") %>
</div><!-- /#wpcontent -->
