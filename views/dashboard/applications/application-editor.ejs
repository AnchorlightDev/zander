<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2"><%= type === 'create' ? 'Create' : 'Edit' %> Application</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <%- include("../../partials/documentationLink.ejs", {
                        doclink: "https://modularsoft.org/docs/products/zander/features/application/"
                    }) %>
                </div>
            </div>

            <div class="basic-form">
                <% if (type === 'create') { %>
                    <form method="post" action="<%= process.env.siteAddress %>/redirect/applications/create">
                <% } %>
                <% if (type === 'edit') { %>
                    <form method="post" action="<%= process.env.siteAddress %>/redirect/applications/edit">
                        <%- include("../../partials/form/inputHidden.ejs", {
                            elementName: "applicationId",
                            elementValue: applicationApiData.applicationId
                        }) %>
                <% } %>

                  <div class="row">
                      <!-- Display Name -->
                      <div class="mb-3 col">
                          <label for="displayName">Display Name</label>

                          <% if (type === 'create') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "displayName",
                                  elementValue: null,
                                  required: true
                              }) %>
                          <% } %>
                          <% if (type === 'edit') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "displayName",
                                  elementValue: applicationApiData.displayName,
                                  required: true
                              }) %>
                          <% } %>
                      </div>

                      <!-- Application Icon -->
                      <div class="mb-3 col">
                          <label for="displayIcon">Application Icon</label>

                          <% if (type === 'create') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "displayIcon",
                                  elementValue: null,
                                  required: true
                              }) %>
                          <% } %>
                          <% if (type === 'edit') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "displayIcon",
                                  elementValue: applicationApiData.displayIcon,
                                  required: true
                              }) %>
                          <% } %>
                      </div>
                  </div>

                  <!-- Application Description -->
                  <div class="mb-3">
                      <label for="description">Application Description</label>

                      <% if (type === 'create') { %>
                          <%- include("../../partials/form/inputTextArea.ejs", {
                              elementName: "description",
                              elementValue: null,
                              required: false
                          }) %>
                      <% } %>
                      <% if (type === 'edit') { %>
                          <%- include("../../partials/form/inputTextArea.ejs", {
                              elementName: "description",
                              elementValue: applicationApiData.description,
                              required: false
                          }) %>
                      <% } %>
                  </div>

                  <!-- Application Type -->
                  <div class="mb-3">
                      <label for="applicationType">Application Type</label>
                      <%# selected is set server-side as well as by the partial's
                          window-load script: the field toggle below runs before
                          that script, and would otherwise read "External URL" and
                          hide the form picker for an application that is linked. %>
                      <% const currentApplicationType = type === 'edit' ? (applicationApiData.applicationType || 'external') : 'external'; %>
                      <%- include("../../partials/form/inputSelect.ejs", {
                          elementName: "applicationType",
                          elementValue: currentApplicationType,
                          required: true,
                          optionElements: [
                              {
                                  optionName: "External URL",
                                  optionValue: "external",
                                  selected: currentApplicationType === "external",
                                  disabled: false
                              },
                              {
                                  optionName: "Linked Form",
                                  optionValue: "linked_form",
                                  selected: currentApplicationType === "linked_form",
                                  disabled: false
                              }
                          ]
                      }) %>
                      <small class="form-text text-muted">External: redirects to a URL. Linked Form: opens a built-in form.</small>
                  </div>

                  <div class="row">
                      <!-- Application Requirements Markdown Link -->
                      <div class="mb-3 col">
                          <label for="requirementsMarkdown">Application Requirements Markdown Link</label>

                          <% if (type === 'create') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "requirementsMarkdown",
                                  elementValue: null,
                                  required: true
                              }) %>
                          <% } %>
                          <% if (type === 'edit') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "requirementsMarkdown",
                                  elementValue: applicationApiData.requirementsMarkdown,
                                  required: true
                              }) %>
                          <% } %>
                      </div>

                      <!-- Application URL Redirect (for external type) -->
                      <div class="mb-3 col" id="redirectUrlField">
                          <label for="redirectUrl">Application URL Redirect</label>

                          <% if (type === 'create') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "redirectUrl",
                                  elementValue: null,
                                  required: false
                              }) %>
                          <% } %>
                          <% if (type === 'edit') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "redirectUrl",
                                  elementValue: applicationApiData.redirectUrl,
                                  required: false
                              }) %>
                          <% } %>
                      </div>

                      <!-- Linked Form (for linked_form type) -->
                      <%# A picker rather than a free-text id: the previous
                          "type the Form ID" box had no way to know whether the
                          id existed, or whether that form was even open. %>
                      <div class="mb-3 col" id="linkedFormField">
                          <label for="linkedFormId">Linked Form</label>

                          <% const selectedFormId = type === 'edit' ? applicationApiData.linkedFormId : null; %>
                          <select class="form-select" name="linkedFormId" id="linkedFormId">
                              <option value="">-- choose a form --</option>
                              <% availableForms.forEach(function (availableForm) { %>
                                  <option value="<%= availableForm.formId %>"
                                          <%= String(selectedFormId) === String(availableForm.formId) ? 'selected' : '' %>>
                                      <%= availableForm.name %><%= availableForm.status ? '' : ' (closed)' %><%= availableForm.createTicket ? ' - opens a ticket' : '' %>
                                  </option>
                              <% }) %>
                          </select>

                          <% if (!availableForms.length) { %>
                              <small class="form-text text-muted">
                                  No forms exist yet. <a href="/dashboard/forms/create">Create one</a> first.
                              </small>
                          <% } else { %>
                              <small class="form-text text-muted">
                                  Manage forms under <a href="/dashboard/forms">Dashboard &gt; Forms</a>.
                              </small>
                          <% } %>

                          <%# What the chosen form is actually set up to do. Without this
                              an admin has to open the form editor in another tab to find
                              out whether submissions go anywhere, or whether the tile is
                              pointing at a form nobody can get into. %>
                          <div class="mt-3 d-none" id="linkedFormSummary">
                              <div class="border rounded p-3">
                                  <div class="d-flex justify-content-between align-items-center mb-2">
                                      <strong class="small text-uppercase text-muted">How this form is set up</strong>
                                      <a href="#" id="linkedFormEditLink" class="btn btn-sm btn-light">Edit the form</a>
                                  </div>
                                  <ul class="list-unstyled mb-0 small" id="linkedFormFacts"></ul>
                              </div>
                          </div>
                      </div>
                  </div>

                  <div class="row">
                      <!-- Application Position -->
                      <div class="mb-3 col">
                          <label for="position">Application Position</label>

                          <% if (type === 'create') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "position",
                                  elementValue: null,
                                  required: true
                              }) %>
                          <% } %>
                          <% if (type === 'edit') { %>
                              <%- include("../../partials/form/inputText.ejs", {
                                  elementName: "position",
                                  elementValue: applicationApiData.position,
                                  required: true
                              }) %>
                          <% } %>
                      </div>

                      <!-- Application Status -->
                      <div class="mb-3 col">
                          <label for="applicationStatus">Application Status</label>

                          <% if (type === 'create') { %>
                              <%- include("../../partials/form/inputSelect.ejs", {
                                  elementName: "applicationStatus",
                                  elementValue: "null",
                                  required: true,
                                  optionElements: [
                                      {
                                          optionName: "Select a Status",
                                          optionValue: "null",
                                          selected: true,
                                          disabled: true
                                      },
                                      {
                                          optionName: "Open",
                                          optionValue: "1",
                                          selected: false,
                                          disabled: false
                                      },
                                      {
                                          optionName: "Closed",
                                          optionValue: "0",
                                          selected: false,
                                          disabled: false
                                      }
                                  ]
                              }) %>
                          <% } %>
                          <% if (type === 'edit') { %>
                              <%- include("../../partials/form/inputSelect.ejs", {
                                  elementName: "applicationStatus",
                                  elementValue: applicationApiData.applicationStatus,
                                  required: true,
                                  optionElements: [
                                      {
                                          optionName: "Select a Status",
                                          optionValue: "null",
                                          selected: true,
                                          disabled: true
                                      },
                                      {
                                          optionName: "Open",
                                          optionValue: "1",
                                          selected: false,
                                          disabled: false
                                      },
                                      {
                                          optionName: "Closed",
                                          optionValue: "0",
                                          selected: false,
                                          disabled: false
                                      }
                                  ]
                              }) %>
                          <% } %>
                      </div>
                  </div>

                  <% if (type === 'create') { %>
                      <button type="submit" class="btn btn-primary"><i class="fal fa-copy"></i> Create Application</button>
                  <% } %>

                  <% if (type === 'edit') { %>
                      <button type="submit" class="btn btn-warning"><i class="fa-solid fa-pen-to-square"></i> Edit Application</button>
                  <% } %>
                </form>
            </div>
    </div><!-- /.wrap -->
  </div><!-- /#wpbody-content -->
  <%- include("../../admin/_footer.ejs") %>
</div><!-- /#wpcontent -->

<script>
(function() {
    // Keyed by formId so the summary can be redrawn without another request.
    var LINKED_FORMS = <%- JSON.stringify(availableForms) %>;

    (function () {
        var picker = document.getElementById('linkedFormId');
        var summary = document.getElementById('linkedFormSummary');
        var facts = document.getElementById('linkedFormFacts');
        var editLink = document.getElementById('linkedFormEditLink');
        if (!picker || !summary || !facts) return;

        function fact(ok, text) {
            var icon = ok
                ? '<span class="text-success me-2">&#10003;</span>'
                : '<span class="text-warning me-2">&#33;</span>';
            return '<li class="mb-1">' + icon + text + '</li>';
        }

        function render() {
            var chosen = null;
            for (var i = 0; i < LINKED_FORMS.length; i++) {
                if (String(LINKED_FORMS[i].formId) === String(picker.value)) chosen = LINKED_FORMS[i];
            }

            if (!chosen) {
                summary.classList.add('d-none');
                return;
            }

            var rows = [];

            rows.push(fact(chosen.status, chosen.status
                ? 'Open for submissions.'
                : 'Closed &mdash; the tile will show, but nobody can submit.'));

            rows.push(fact(chosen.fieldCount > 0, chosen.fieldCount > 0
                ? chosen.fieldCount + ' question' + (chosen.fieldCount === 1 ? '' : 's') + '.'
                : 'No questions yet.'));

            // The two ways a submission reaches staff. Neither one configured
            // means it lands in the dashboard and waits to be noticed.
            rows.push(fact(chosen.hasDiscordChannel, chosen.hasDiscordChannel
                ? 'Posts new submissions to a Discord channel.'
                : 'No Discord channel &mdash; submissions are only visible in the dashboard.'));

            rows.push(fact(chosen.createTicket, chosen.createTicket
                ? 'Opens a support ticket for each applicant.'
                : 'No ticket &mdash; applicants are not told the outcome automatically.'));

            if (chosen.requirementCount > 0) {
                rows.push(fact(true, chosen.requirementCount + ' eligibility requirement'
                    + (chosen.requirementCount === 1 ? '' : 's') + ' enforced before the questions show.'));
            } else {
                rows.push(fact(true, 'No eligibility requirements &mdash; anyone signed in can apply.'));
            }

            if (chosen.hasAccessCode) {
                rows.push(fact(true, 'Needs an access code, so it is invite-only.'));
            }

            if (chosen.reapplyCooldownDays) {
                rows.push(fact(true, 'Denied applicants must wait '
                    + chosen.reapplyCooldownDays + ' day'
                    + (chosen.reapplyCooldownDays === 1 ? '' : 's') + ' to reapply.'));
            }

            facts.innerHTML = rows.join('');
            if (editLink) editLink.href = '/dashboard/forms/' + chosen.formId + '/edit';
            summary.classList.remove('d-none');
        }

        picker.addEventListener('change', render);
        render();
    })();

    var typeSelect = document.getElementById('applicationTypeSel');
    var redirectField = document.getElementById('redirectUrlField');
    var linkedFormField = document.getElementById('linkedFormField');

    function toggleFields() {
        if (!typeSelect || !redirectField || !linkedFormField) return;
        if (typeSelect.value === 'linked_form') {
            redirectField.style.display = 'none';
            linkedFormField.style.display = 'block';
        } else {
            redirectField.style.display = 'block';
            linkedFormField.style.display = 'none';
        }
    }

    if (typeSelect) {
        typeSelect.addEventListener('change', toggleFields);
        toggleFields();
        // The select partial assigns the saved value on load without firing
        // change, so re-apply once it has.
        window.addEventListener('load', toggleFields);
    }
})();
</script>
