<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<div id="wpcontent"><div id="wpbody-content"><div class="wrap">
  <div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Wrapped</h1>
    <a class="btn btn-outline-secondary btn-sm" href="/wrapped" target="_blank" rel="noopener">Open my Wrapped</a>
  </div>

  <% if (saved) { %><div class="alert alert-success">Settings saved.</div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <div class="row g-4">
    <!-- ── Period settings ─────────────────────────────────────────────── -->
    <div class="col-lg-6">
      <h5>Period</h5>
      <p class="text-muted small mb-2">
        Configured here — not <code>config.json</code>. Leave Start &amp; End blank
        for a <strong>rolling window</strong> of the length below, ending today.
        Or pin a window: <code>MM-DD</code> = that span in the current year,
        <code>YYYY-MM-DD</code> = exact dates (UTC day boundaries).
      </p>
      <form method="post" action="/dashboard/wrapped/settings">
        <div class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" name="enabled" id="enabled"
                 <%= (settings.enabled === null ? true : settings.enabled) ? 'checked' : '' %>>
          <label class="form-check-label" for="enabled">Wrapped enabled</label>
        </div>
        <div class="mb-2 row">
          <label class="col-sm-4 col-form-label col-form-label-sm">Rolling length</label>
          <div class="col-sm-8 input-group input-group-sm" style="width:auto;">
            <input class="form-control form-control-sm" type="number" min="1" max="24" name="rollingMonths"
                   value="<%= settings.rollingMonths || '' %>" placeholder="12">
            <span class="input-group-text">months</span>
          </div>
        </div>
        <div class="mb-2 row">
          <label class="col-sm-4 col-form-label col-form-label-sm">Start</label>
          <div class="col-sm-8">
            <input class="form-control form-control-sm" name="periodStart"
                   value="<%= settings.periodStart || '' %>"
                   placeholder="blank = use rolling length">
          </div>
        </div>
        <div class="mb-3 row">
          <label class="col-sm-4 col-form-label col-form-label-sm">End</label>
          <div class="col-sm-8">
            <input class="form-control form-control-sm" name="periodEnd"
                   value="<%= settings.periodEnd || '' %>"
                   placeholder="blank = use rolling length">
          </div>
        </div>
        <button class="btn btn-primary btn-sm">Save</button>
      </form>

      <div class="mt-3 small text-muted">
        <strong>Currently resolves to:</strong>
        <%= period.enabled ? 'enabled' : 'disabled' %> ·
        <%= moment(period.start).utc().format('MMM D') %> – <%= moment(period.end).utc().format('MMM D, YYYY') %>
        · <%= period.active ? 'window OPEN now' : 'window closed' %>
      </div>
    </div>

    <!-- ── Preview ────────────────────────────────────────────────────── -->
    <div class="col-lg-6">
      <h5>Preview a user's Wrapped</h5>
      <p class="text-muted small mb-2">Builds the deck live and does <strong>not</strong> save a run.</p>
      <form method="post" action="/dashboard/wrapped/preview" target="_blank">
        <div class="mb-2 position-relative">
          <input class="form-control form-control-sm" id="wrappedPreviewUser" name="username" required
                 value="<%= me %>" placeholder="Start typing a username" autocomplete="off">
          <div id="wrappedPreviewSuggest" class="list-group position-absolute w-100 shadow-sm"
               style="z-index:1050; display:none; max-height:260px; overflow:auto;"></div>
        </div>
        <div class="row g-2 mb-2">
          <div class="col">
            <input class="form-control form-control-sm" name="previewStart" placeholder="MM-DD or YYYY-MM-DD (optional)">
          </div>
          <div class="col">
            <input class="form-control form-control-sm" name="previewEnd" placeholder="MM-DD or YYYY-MM-DD (optional)">
          </div>
        </div>
        <div class="form-check form-check-inline small mb-2">
          <input class="form-check-input" type="checkbox" id="refreshLeaderboard" name="refreshLeaderboard">
          <label class="form-check-label" for="refreshLeaderboard">Refresh leaderboard from MineMonitor first (slow)</label>
        </div>
        <div class="form-text mb-2">Leave the override dates blank to use the active period above.</div>
        <button class="btn btn-success btn-sm">Preview</button>
        <button class="btn btn-outline-success btn-sm" formaction="/dashboard/wrapped/demo"
                title="Fake data for every slide — no MineMonitor or real stats needed">
          Demo preview
        </button>
      </form>

      <% if (typeof preview !== 'undefined' && preview) { %>
      <div class="alert alert-light border mt-3 mb-0 small">
        <div class="fw-semibold mb-1">
          Last preview: <%= preview.username %><% if (preview.demo) { %> <span class="badge bg-secondary">demo</span><% } %>
        </div>
        <a href="/dashboard/wrapped/preview" target="_blank" rel="noopener">Open deck</a>
        <div class="mt-1 text-muted">
          For a <strong>PNG</strong> of the 1080×1920 summary card, open the deck and use
          <em>Save summary image</em> (it downloads a <code>.png</code>). The links below
          just render the card in the browser for a quick look.
        </div>
        <div class="mt-1">
          <a href="/dashboard/wrapped/preview/card.svg" target="_blank" rel="noopener">Preview summary card</a>
          <% if (preview.slides && preview.slides.length) { %>
          &nbsp;·&nbsp;
          <details class="d-inline">
            <summary class="d-inline text-muted" style="cursor:pointer;">per-slide cards</summary>
            <span class="d-inline-flex flex-wrap gap-2 ms-1">
              <% preview.slides.forEach(function (k) { %>
                <a href="/dashboard/wrapped/preview/card/s/<%= encodeURIComponent(k) %>.svg" target="_blank" rel="noopener"><%= k %></a>
              <% }) %>
            </span>
          </details>
          <% } %>
        </div>
      </div>
      <% } %>

      <hr>
      <p class="text-muted small mb-1">
        Saved runs are <strong>frozen</strong> at generation time. If MineMonitor was
        connected afterwards, rebuild the rank cache and regenerate affected runs.
      </p>
      <form method="post" action="/dashboard/wrapped/rebuild-leaderboard" class="d-inline">
        <button class="btn btn-outline-secondary btn-sm">Rebuild leaderboard cache</button>
      </form>
      <button type="button" id="mmTestBtn" class="btn btn-outline-secondary btn-sm">Test MineMonitor</button>
      <pre id="mmTestOut" class="small bg-light border rounded p-2 mt-2 mb-0"
           style="display:none; max-height:320px; overflow:auto; white-space:pre-wrap;"></pre>
    </div>
  </div>

  <!-- ── Recent runs ──────────────────────────────────────────────────── -->
  <h5 class="mt-4">Runs this period (<%= period.year %>)</h5>
  <table class="table table-sm">
    <thead><tr><th>User</th><th>Created</th><th>Viewed</th><th>Share link</th><th></th></tr></thead>
    <tbody>
      <% runs.forEach(function (r) { %>
        <tr>
          <td><%= r.username %></td>
          <td><%= moment(r.createdAt).format('MMM D, HH:mm') %></td>
          <td><%= r.viewedAt ? moment(r.viewedAt).format('MMM D, HH:mm') : '—' %></td>
          <td><a href="/wrapped/s/<%= r.shareId %>" target="_blank" rel="noopener"><%= r.shareId %></a></td>
          <td>
            <form method="post" action="/dashboard/wrapped/regenerate" class="d-inline"
                  onsubmit="return confirm('Regenerate <%= r.username %>\'s Wrapped? This overwrites the frozen run.');">
              <input type="hidden" name="username" value="<%= r.username %>">
              <button class="btn btn-outline-secondary btn-sm py-0">Regenerate</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!runs.length) { %>
        <tr><td colspan="5" class="text-muted text-center">No runs generated yet this period.</td></tr>
      <% } %>
    </tbody>
  </table>
</div></div></div>

<script>
(function () {
  var input = document.getElementById('wrappedPreviewUser');
  var box = document.getElementById('wrappedPreviewSuggest');
  if (!input || !box) return;
  var timer = null;

  function hide() { box.style.display = 'none'; box.innerHTML = ''; }

  function render(list) {
    box.innerHTML = '';
    if (!list.length) { hide(); return; }
    list.forEach(function (u) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-1 px-2';
      if (u.avatarUrl) {
        var img = document.createElement('img');
        img.src = u.avatarUrl; img.alt = ''; img.width = 24; img.height = 24;
        img.className = 'rounded'; img.style.objectFit = 'cover';
        b.appendChild(img);
      }
      var s = document.createElement('span');
      s.textContent = u.username; s.className = 'small';
      b.appendChild(s);
      b.addEventListener('click', function () { input.value = u.username; hide(); });
      box.appendChild(b);
    });
    box.style.display = 'block';
  }

  input.addEventListener('input', function () {
    var q = input.value.trim();
    clearTimeout(timer);
    if (q.length < 2) { hide(); return; }
    timer = setTimeout(function () {
      fetch('/dashboard/wrapped/user-search?q=' + encodeURIComponent(q), { credentials: 'include' })
        .then(function (r) { return r.json(); })
        .then(function (d) { render(d.results || []); })
        .catch(hide);
    }, 200);
  });

  document.addEventListener('click', function (e) {
    if (!input.contains(e.target) && !box.contains(e.target)) hide();
  });

  var mmBtn = document.getElementById('mmTestBtn');
  var mmOut = document.getElementById('mmTestOut');
  if (mmBtn && mmOut) {
    mmBtn.addEventListener('click', function () {
      var u = (input.value || '').trim();
      if (!u) { mmOut.style.display = 'block'; mmOut.textContent = 'Enter a username above first.'; return; }
      mmOut.style.display = 'block';
      mmOut.textContent = 'Testing ' + u + ' …';
      fetch('/dashboard/wrapped/minemonitor-test?username=' + encodeURIComponent(u), { credentials: 'include' })
        .then(function (r) { return r.json(); })
        .then(function (d) { mmOut.textContent = JSON.stringify(d, null, 2); })
        .catch(function (e) { mmOut.textContent = 'Request failed: ' + e; });
    });
  }
})();
</script>


<%- include("../../admin/_footer.ejs") %>
