<%- include("../../admin/_head.ejs", { pageTitle }) %>
<%- include("../../admin/_topbar.ejs") %>
<%- include("../../admin/_sidebar.ejs") %>

<%
  const WEEK_NAMES = { 1: "Mon", 2: "Tue", 3: "Wed", 4: "Thu", 5: "Fri", 6: "Sat", 7: "Sun" };
  function scheduleSummary(j) {
    if (j.scheduleType === "once") return j.runAt ? `Once at ${new Date(j.runAt).toISOString()}` : "Once";
    const every = j.recurInterval > 1 ? `every ${j.recurInterval} ` : "every ";
    let unit = { daily: "day", weekly: "week", monthly: "month" }[j.frequency] || j.frequency;
    let when = "";
    if (j.frequency === "weekly" && j.byWeekday) when = " on " + String(j.byWeekday).split(/[,\s]+/).filter(Boolean).map((d) => WEEK_NAMES[d] || d).join(", ");
    if (j.frequency === "monthly" && j.byMonthDay) when = ` on day ${j.byMonthDay}`;
    return `${every}${unit}${when} at ${j.timeOfDay || "00:00"} ${j.timezone}`;
  }
  const STATUS_BADGE = { succeeded: "success", partial: "warning", failed: "danger", missed: "secondary", skipped: "secondary", running: "info" };
%>

<div id="wpcontent">
  <div id="wpbody-content">
    <div class="wrap">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Scheduler</h1>
        <div class="btn-toolbar mb-2 mb-md-0 gap-2">
          <a href="/dashboard/scheduler/create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Create Job</a>
          <%- include("../../partials/documentationLink.ejs", { doclink: "https://anchorlight.dev/docs/products/zander/features/scheduler" }) %>
        </div>
      </div>

      <%- include("../../admin/_notices.ejs") %>

      <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><a class="nav-link active" href="#tab-jobs" data-tab="tab-jobs">Jobs</a></li>
        <li class="nav-item"><a class="nav-link" href="#tab-history" data-tab="tab-history">History</a></li>
        <li class="nav-item"><a class="nav-link" href="#tab-forum" data-tab="tab-forum">Forum (read-only)</a></li>
        <li class="nav-item"><a class="nav-link" href="#tab-ann" data-tab="tab-ann">Announcements (read-only)</a></li>
      </ul>

      <!-- Jobs -->
      <div id="tab-jobs" class="sched-tab">
        <% if (!jobs.length) { %>
          <div class="alert alert-info">No jobs yet. <a href="/dashboard/scheduler/create">Create one.</a></div>
        <% } else { %>
          <table class="table table-sm align-middle">
            <thead><tr><th>Title</th><th>Schedule</th><th>Next run</th><th>Actions</th><th>Last run</th><th></th></tr></thead>
            <tbody>
              <% jobs.forEach(function (j) { %>
                <tr>
                  <td>
                    <a href="/dashboard/scheduler/edit?id=<%= j.id %>"><%= j.title %></a>
                    <%= j.enabled ? "" : " (disabled)" %>
                  </td>
                  <td class="small"><%= scheduleSummary(j) %></td>
                  <td class="small" data-local-date="<%= (j.nextFew && j.nextFew[0]) || "" %>"><%= (j.nextFew && j.nextFew[0]) ? j.nextFew[0] : "-" %></td>
                  <td><% j.actions.forEach(function (a) { %><span class="badge bg-light text-dark border me-1"><%= a.actionType %></span><% }); %></td>
                  <td><% if (j.lastRun) { %><span class="badge bg-<%= STATUS_BADGE[j.lastRun.status] || "secondary" %>"><%= j.lastRun.status %></span><% } else { %><span class="text-muted small">-</span><% } %></td>
                  <td class="text-nowrap">
                    <form method="post" action="/dashboard/scheduler/toggle" class="d-inline">
                      <input type="hidden" name="id" value="<%= j.id %>"><input type="hidden" name="enabled" value="<%= j.enabled ? "0" : "1" %>">
                      <button class="btn btn-sm btn-outline-secondary" title="<%= j.enabled ? "Disable" : "Enable" %>"><i class="fas fa-power-off"></i></button>
                    </form>
                    <a href="/dashboard/scheduler/edit?id=<%= j.id %>" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen"></i></a>
                    <form method="post" action="/dashboard/scheduler/runnow" class="d-inline" onsubmit="return confirm('Run \'<%= j.title %>\' now?');">
                      <input type="hidden" name="id" value="<%= j.id %>"><button class="btn btn-sm btn-outline-warning" title="Run now"><i class="fas fa-play"></i></button>
                    </form>
                    <form method="post" action="/dashboard/scheduler/duplicate" class="d-inline">
                      <input type="hidden" name="id" value="<%= j.id %>"><button class="btn btn-sm btn-outline-secondary" title="Duplicate"><i class="fas fa-copy"></i></button>
                    </form>
                    <form method="post" action="/dashboard/scheduler/delete" class="d-inline" onsubmit="return confirm('Delete this job?');">
                      <input type="hidden" name="id" value="<%= j.id %>"><button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>

      <!-- History -->
      <div id="tab-history" class="sched-tab d-none">
        <% if (!runs.length) { %><div class="alert alert-info">No runs yet.</div><% } else { %>
          <table class="table table-sm align-middle">
            <thead><tr><th>Job</th><th>Due</th><th>Trigger</th><th>Run #</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
              <% runs.forEach(function (run) { const results = Array.isArray(run.results) ? run.results : []; %>
                <tr>
                  <td class="small">#<%= run.jobId %></td>
                  <td class="small" data-local-date="<%= run.dueAt ? new Date(run.dueAt).toISOString() : "" %>"><%= run.dueAt ? new Date(run.dueAt).toISOString() : "" %></td>
                  <td class="small"><%= run.triggerType %></td>
                  <td class="small"><%= run.runNumber == null ? "-" : run.runNumber %></td>
                  <td><span class="badge bg-<%= STATUS_BADGE[run.status] || "secondary" %>"><%= run.status %></span></td>
                  <td class="small">
                    <% results.forEach(function (r) { const tid = r.refs && r.refs.executorTaskId; %>
                      <div>
                        <span class="badge bg-<%= STATUS_BADGE[r.status] || "secondary" %>"><%= r.actionType %>: <span <%= tid ? `data-task-id="${tid}"` : "" %>><%= r.status %></span></span>
                        <% if (r.message) { %><span class="text-muted"><%= String(r.message).slice(0,120) %></span><% } %>
                      </div>
                    <% }); %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>

      <!-- Forum read-only -->
      <div id="tab-forum" class="sched-tab d-none">
        <p class="text-muted small">Forum threads with a publish time. Scheduled here so nothing is double-booked without being visible. Edit in the forum.</p>
        <% if (!forumScheduled.length) { %><div class="alert alert-info">No scheduled forum threads.</div><% } else { %>
          <table class="table table-sm align-middle">
            <thead><tr><th>Thread</th><th>Status</th><th>Publish at</th></tr></thead>
            <tbody>
              <% forumScheduled.forEach(function (d) { %>
                <tr>
                  <td><a href="/forum/thread/<%= d.slug %>"><%= d.title %></a></td>
                  <td class="small"><%= d.status %></td>
                  <td class="small" data-local-date="<%= d.publishAt ? new Date(d.publishAt).toISOString() : "" %>"><%= d.publishAt ? new Date(d.publishAt).toISOString() : "" %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>

      <!-- Announcements read-only -->
      <div id="tab-ann" class="sched-tab d-none">
        <p class="text-muted small">Announcement posts with a future start or end. Edit in the announcements wizard.</p>
        <% if (!futurePosts.length) { %><div class="alert alert-info">No upcoming announcement windows.</div><% } else { %>
          <table class="table table-sm align-middle">
            <thead><tr><th>Post</th><th>Status</th><th>Platforms</th></tr></thead>
            <tbody>
              <% futurePosts.forEach(function (p) { %>
                <tr>
                  <td><a href="/dashboard/announcements/edit?postId=<%= p.postId %>"><%= p.title || "(untitled)" %></a></td>
                  <td class="small"><%= p.status %></td>
                  <td class="small"><% p.platforms.forEach(function (r) { %><span class="badge bg-light text-dark border me-1"><%= r.announcementType %></span><% }); %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>

    </div>
  </div>
  <%- include("../../admin/_footer.ejs") %>
</div>

<script>
  // Tabs
  document.querySelectorAll(".nav-link[data-tab]").forEach(function (link) {
    link.addEventListener("click", function (e) {
      e.preventDefault();
      document.querySelectorAll(".nav-link[data-tab]").forEach((n) => n.classList.remove("active"));
      link.classList.add("active");
      document.querySelectorAll(".sched-tab").forEach((t) => t.classList.toggle("d-none", t.id !== link.dataset.tab));
    });
  });
  // Local times
  document.querySelectorAll("[data-local-date]").forEach(function (el) {
    const iso = el.getAttribute("data-local-date");
    if (!iso) return;
    const d = new Date(iso);
    if (!Number.isNaN(d.getTime())) el.textContent = d.toLocaleString();
  });
  // Poll queued command task status in the history tab.
  (function () {
    const spans = [...document.querySelectorAll("[data-task-id]")];
    if (!spans.length) return;
    async function poll() {
      const ids = spans.map((s) => s.getAttribute("data-task-id")).join(",");
      try {
        const res = await fetch("/dashboard/scheduler/task-status?ids=" + encodeURIComponent(ids));
        const data = await res.json();
        const byId = Object.fromEntries((data.tasks || []).map((t) => [String(t.executorTaskId), t.status]));
        spans.forEach((s) => { const st = byId[s.getAttribute("data-task-id")]; if (st) s.textContent = "queued → " + st; });
      } catch {}
    }
    poll();
    setInterval(poll, 5000);
  })();
</script>
