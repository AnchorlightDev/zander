<%- include("../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: "You must be logged in to use this feature.",
    // Auth / account utility page: never useful in search results.
    pageRobots: "noindex, follow"
}) %>

<%- include("../modules/navigationBar.ejs") %>

<%- include("../partials/miniHeader.ejs", {
  headerTitle: "Sign In Required",
  backgroundImage: globalImage
}) %>

<%
  // Bring them back here after signing in (routes/sessionRoutes.js checks the path is local).
  const _here = req.method === "GET" && req.url && req.url.startsWith("/") && !req.url.startsWith("//") ? req.url : null;
%>
<%- include("../partials/session/statusPage.ejs", {
  image: "/images/session/errorImage.png",
  code: "Sign in required",
  title: "Please sign in to continue",
  message: "You need an account to use this page. Sign in and we'll bring you straight back.",
  actions: [
    { href: _here ? "/login?returnTo=" + encodeURIComponent(_here) : "/login", label: "Sign in", icon: "fa-solid fa-right-to-bracket", primary: true },
    ...(features.web?.register !== false ? [{ href: "/register", label: "Create an account" }] : []),
  ]
}) %>

<%- include("../modules/footer.ejs") %>
