<%- include("../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: "Choose a new password",
    // Auth / account utility page: never useful in search results.
    pageRobots: "noindex, follow"
}) %>

<%- include("../modules/navigationBar.ejs") %>

<%- include("../partials/miniHeader.ejs", {
  headerTitle: "Reset Password",
  backgroundImage: globalImage
}) %>

<section class="section auth-page">
  <div class="container">
    <div class="row align-items-center justify-content-center g-5">
      <div class="col-md-9 col-lg-6 col-xl-5">
        <div class="auth-card">
          <h3 class="auth-title">Choose a new password</h3>
          <p class="auth-subtitle">You'll use it to sign in from now on.</p>

          <% if (req.cookies.alertType) { %>
            <%- include("../partials/alert.ejs", {
              alertType: req.cookies.alertType,
              content: req.cookies.alertContent
            }) %>
          <% } %>

          <form method="post" action="<%= process.env.siteAddress %>/forgot-password/reset" id="resetForm">
            <%- include("../partials/session/passwordField.ejs", {
              id: "password",
              name: "password",
              label: "New password",
              autocomplete: "new-password",
              showRules: true
            }) %>
            <%- include("../partials/session/passwordField.ejs", {
              id: "confirmPassword",
              name: "confirmPassword",
              label: "Confirm new password",
              autocomplete: "new-password"
            }) %>
            <div class="small text-danger mb-3 d-none" id="mismatch" role="alert">The passwords don't match.</div>
            <button type="submit" class="btn btn-primary w-100">Update password</button>
          </form>

          <div class="auth-footer">
            Know your password after all? <a href="/login">Back to sign in</a>
          </div>
        </div>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <img class="floating auth-illustration" src="/images/session/registerImage.png" alt="" draggable="false">
      </div>
    </div>
  </div>
</section>

<script>
  // Catch a typo before the round trip; the server checks this too.
  document.getElementById("resetForm").addEventListener("submit", function (e) {
    var match = document.getElementById("password").value === document.getElementById("confirmPassword").value;
    document.getElementById("mismatch").classList.toggle("d-none", match);
    if (!match) e.preventDefault();
  });
</script>

<%- include("../modules/footer.ejs") %>
