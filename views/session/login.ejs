<%- include("../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: "Login and get involved in the community!",
    // Auth / account utility page: never useful in search results.
    pageRobots: "noindex, follow"
}) %>

<%- include("../modules/navigationBar.ejs") %>

<%- include("../partials/miniHeader.ejs", {
  headerTitle: "Login",
  backgroundImage: globalImage
}) %>

<section class="section auth-page">
  <div class="container">
    <div class="row align-items-center justify-content-center g-5">
      <div class="col-md-9 col-lg-6 col-xl-5">
        <div class="auth-card">
          <h3 class="auth-title">Welcome back</h3>
          <p class="auth-subtitle">Sign in to your <%= config.siteConfiguration.siteName %> account.</p>

          <% if (req.cookies.alertType) { %>
            <%- include("../partials/alert.ejs", {
              alertType: req.cookies.alertType,
              content: req.cookies.alertContent
            }) %>
          <% } %>

          <form method="post" action="<%= process.env.siteAddress %>/login">
            <div class="mb-3">
              <label for="identifier" class="form-label">Username or email</label>
              <input type="text" class="form-control" id="identifier" name="identifier" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
            </div>

            <%- include("../partials/session/passwordField.ejs", {
              id: "password",
              name: "password",
              label: "Password",
              autocomplete: "current-password",
              labelExtra: '<a href="/forgot-password">Forgot password?</a>'
            }) %>

            <div class="mb-4 form-check">
              <input type="checkbox" class="form-check-input" name="rememberMe" id="rememberMe" value="1">
              <label class="form-check-label" for="rememberMe">Remember me</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign in</button>
          </form>

          <% if (discordAuthorizeUrl) { %>
            <div class="auth-divider">or</div>
            <a href="<%= discordAuthorizeUrl %>" class="btn btn-discord w-100">
              <i class="fab fa-discord me-1" aria-hidden="true"></i> Sign in with Discord
            </a>
          <% } %>

          <% if (features.web?.register !== false) { %>
            <div class="auth-footer">
              New here? <a href="/register">Create an account</a>
            </div>
          <% } %>
        </div>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <img class="floating auth-illustration" src="/images/session/loginImage.png" alt="" draggable="false">
      </div>
    </div>
  </div>
</section>

<%- include("../modules/footer.ejs") %>
