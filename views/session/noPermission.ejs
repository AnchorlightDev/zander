<%- include("../modules/header.ejs", {
  pageTitle: pageTitle,
  pageDescription: "Permission Denied",
  pageRobots: "noindex, follow"
}) %>

<%- include("../modules/navigationBar.ejs") %>

<%- include("../partials/miniHeader.ejs", {
  headerTitle: "Access Denied",
  backgroundImage: globalImage
}) %>

<% const _signedIn = Boolean(req.session?.user); %>
<%- include("../partials/session/statusPage.ejs", {
  image: "/images/session/errorImage.png",
  code: "Error 403",
  title: _signedIn ? "You don't have access to this page" : "Please sign in to continue",
  message: _signedIn
    ? "Your account doesn't have permission to view this. If you think it should, ask a staff member."
    : "This page is restricted. Sign in, and if your account has access you'll be able to continue.",
  actions: _signedIn
    ? [{ href: "/", label: "Back to home", icon: "fa-solid fa-house", primary: true }]
    : [
        { href: "/login", label: "Sign in", icon: "fa-solid fa-right-to-bracket", primary: true },
        { href: "/", label: "Back to home" },
      ]
}) %>

<%- include("../modules/footer.ejs") %>
