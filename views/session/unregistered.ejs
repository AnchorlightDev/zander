<%- include("../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: "Register to get involved with the community!",
    // Auth / account utility page: never useful in search results.
    pageRobots: "noindex, follow"
}) %>

<%- include("../modules/navigationBar.ejs") %>

<%- include("../partials/miniHeader.ejs", {
  headerTitle: "Account Confirmation",
  backgroundImage: globalImage
}) %>

<section class="section auth-page">
  <div class="container">
    <div class="row justify-content-center g-5">
      <div class="col-lg-8 col-xl-7">
        <div class="auth-card">
          <h3 class="auth-title">Link your Minecraft account</h3>
          <p class="auth-subtitle">Before you get started, connect the Minecraft account you play with.</p>

          <% if (req.cookies.alertType) { %>
            <%- include("../partials/alert.ejs", {
              alertType: req.cookies.alertType,
              content: req.cookies.alertContent
            }) %>
          <% } %>

          <ol class="link-steps">
            <li>
              <h5>Get your code</h5>
              <p class="mb-2">Join the main server with that account and type <code>/link</code> in chat. It replies with a 6-digit code that lasts 5 minutes; run it again for a fresh one.</p>

              <details>
                <summary class="auth-link">Can't join the main server?</summary>
                <div class="mt-3">
                  <p class="small mb-2">Connect to a verification server instead — it kicks you with your code. Add it in <strong>Minecraft</strong> under Multiplayer → Add Server.</p>
                  <% if (apiData.success == false) { %>
                    <%- include("../partials/alert.ejs", { alertType: "danger", content: apiData.message }) %>
                  <% } else { %>
                    <div class="d-flex flex-column gap-2">
                      <% apiData.data.forEach(function (verifyServer) {
                           var inputId = "srv-" + verifyServer.serverConnectionAddress.replace(/[^a-z0-9]/gi, "");
                      %>
                        <div>
                          <label class="form-label small mb-1" for="<%= inputId %>"><%= verifyServer.displayName %></label>
                          <div class="input-group">
                            <input type="text" class="form-control font-monospace" id="<%= inputId %>" value="<%= verifyServer.serverConnectionAddress %>" readonly>
                            <button type="button" class="btn btn-outline-primary copy-btn" data-target="<%= inputId %>">
                              <i class="fas fa-copy me-1" aria-hidden="true"></i>Copy
                            </button>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </details>
            </li>

            <li>
              <h5>Enter it here</h5>
              <form id="verificationForm" method="post" action="<%= process.env.siteAddress %>/redirect/web/user/link">
                <input type="hidden" name="discordId" value="<%= discordId %>">
                <%- include("../partials/session/otpInput.ejs", { submitId: "submitButton" }) %>
                <button id="submitButton" type="submit" class="btn btn-primary w-100" disabled>Link account</button>
              </form>
            </li>
          </ol>
        </div>
      </div>
      <div class="col-lg-4 d-none d-lg-flex align-items-center justify-content-center">
        <img class="floating auth-illustration" src="/images/session/registerImage.png" alt="" draggable="false">
      </div>
    </div>
  </div>
</section>

<%- include("../modules/footer.ejs") %>

<script>
  document.querySelectorAll(".copy-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var target = document.getElementById(btn.dataset.target);
      if (!target) return;
      var done = function () {
        btn.innerHTML = '<i class="fas fa-check me-1" aria-hidden="true"></i>Copied';
        setTimeout(function () { btn.innerHTML = '<i class="fas fa-copy me-1" aria-hidden="true"></i>Copy'; }, 1500);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(target.value).then(done, function () { target.select(); });
      else { target.select(); document.execCommand("copy"); done(); }
    });
  });
</script>
