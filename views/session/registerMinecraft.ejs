<%- include("../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: "Verify your Minecraft account to finish registration.",
    // Auth / account utility page: never useful in search results.
    pageRobots: "noindex, follow"
}) %>

<%- include("../modules/navigationBar.ejs") %>

<%- include("../partials/miniHeader.ejs", {
  headerTitle: "Link Your Minecraft Account",
  backgroundImage: globalImage
}) %>

<section class="section auth-page">
  <div class="container">
    <div class="row justify-content-center g-5">
      <div class="col-lg-8 col-xl-7">
        <div class="auth-card">
          <h3 class="auth-title">Last step: link Minecraft</h3>
          <p class="auth-subtitle">Prove the Minecraft account is yours with a 6-digit code from the game.</p>

          <% if (req.cookies.alertType) { %>
            <%- include("../partials/alert.ejs", {
              alertType: req.cookies.alertType,
              content: req.cookies.alertContent
            }) %>
          <% } %>

          <% if (pendingUsername) { %>
            <div class="alert alert-info d-flex align-items-center gap-2 mb-4 py-2">
              <i class="fas fa-user-circle" aria-hidden="true"></i>
              <span>Linking <strong><%= pendingUsername %></strong></span>
            </div>
          <% } %>

          <ol class="link-steps">
            <!-- Step 1 -->
            <li>
              <h5>Get your code</h5>
              <p class="mb-2">Join the server as normal and type <code>/link</code> in chat. It replies with your code straight away. Codes last 5 minutes.</p>

              <details class="mb-2">
                <summary class="auth-link">Can't join the main server?</summary>
                <div class="mt-3">
                  <p class="small mb-2">Connect to a verification server instead — it kicks you with your code. Add it in <strong>Minecraft</strong> under Multiplayer → Add Server (it isn't a website).</p>
                  <% if (apiData.success === false) { %>
                    <%- include("../partials/alert.ejs", { alertType: "danger", content: apiData.message }) %>
                  <% } else { %>
                    <div class="d-flex flex-column gap-2">
                      <% apiData.data.forEach(function (verifyServer) {
                           var name = (verifyServer.displayName || "").toLowerCase();
                           var edition = name.includes("bedrock") ? "Bedrock" : name.includes("java") ? "Java" : null;
                           var inputId = "srv-" + verifyServer.serverConnectionAddress.replace(/[^a-z0-9]/gi, "");
                      %>
                        <div>
                          <label class="form-label small mb-1" for="<%= inputId %>">
                            <%= verifyServer.displayName || "Verification server" %>
                            <% if (edition) { %><span class="badge text-bg-light ms-1"><%= edition %></span><% } %>
                          </label>
                          <div class="input-group">
                            <input type="text" class="form-control font-monospace" id="<%= inputId %>" value="<%= verifyServer.serverConnectionAddress %>" readonly>
                            <button type="button" class="btn btn-outline-primary copy-btn" data-target="<%= inputId %>">
                              <i class="fas fa-copy me-1" aria-hidden="true"></i>Copy
                            </button>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </details>

              <div class="mc-chat" aria-label="Example chat message">
                <span style="color:#55FF55;">[<%= config.siteConfiguration.siteName %>]</span>
                <span style="color:#FFFFFF;"> Your verification code is: </span>
                <span style="color:#FFFF55;font-weight:bold;">483920</span>
              </div>
            </li>

            <!-- Step 2 -->
            <li>
              <h5>Enter it here</h5>
              <form id="verificationForm" method="post" action="<%= process.env.siteAddress %>/register/minecraft">
                <%- include("../partials/session/otpInput.ejs", { submitId: "submitButton" }) %>
                <button id="submitButton" type="submit" class="btn btn-primary w-100" disabled>Verify Minecraft account</button>
              </form>
              <p class="small mt-3 mb-0">
                Or, while you're still in game, type <code>/verify 123456</code> with your code. Your account links automatically.
              </p>
            </li>
          </ol>
        </div>
      </div>
      <div class="col-lg-4 d-none d-lg-flex align-items-center justify-content-center">
        <img class="floating auth-illustration" src="/images/session/registerImage.png" alt="" draggable="false">
      </div>
    </div>
  </div>
</section>

<%- include("../modules/footer.ejs") %>

<script>
  document.querySelectorAll(".copy-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var target = document.getElementById(btn.dataset.target);
      if (!target) return;
      var done = function () {
        btn.innerHTML = '<i class="fas fa-check me-1" aria-hidden="true"></i>Copied';
        setTimeout(function () { btn.innerHTML = '<i class="fas fa-copy me-1" aria-hidden="true"></i>Copy'; }, 1500);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(target.value).then(done, function () { target.select(); });
      else { target.select(); document.execCommand("copy"); done(); }
    });
  });
</script>
