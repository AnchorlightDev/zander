<%- include("../modules/header.ejs", {
  pageTitle: pageTitle,
  pageDescription: "Something went wrong.",
  pageRobots: "noindex, follow"
}) %>

<%- include("../modules/navigationBar.ejs") %>

<%- include("../partials/miniHeader.ejs", {
  headerTitle: "Something Went Wrong",
  backgroundImage: globalImage
}) %>

<%
  // A client error (4xx) carries a message meant for the visitor. Anything
  // else is an internal error whose text can expose internals (SQL, paths),
  // so only signed-in staff see it, collapsed.
  const _status = Number(error?.statusCode) || 500;
  const _clientMessage = _status < 500 && error?.message ? error.message : null;
  const _isStaff = Boolean(req.session?.user?.isStaff);
  const _details = _isStaff && !_clientMessage && error
    ? (error.stack || error.message || String(error))
    : null;
  const _esc = (v) => String(v).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const _email = config.siteConfiguration?.email;
  const _discord = config.siteConfiguration?.platforms?.discord;
  const _contact = [
    _email ? `<a class="auth-link" href="mailto:${_esc(_email)}">email the team</a>` : null,
    _discord ? `<a class="auth-link" href="${_esc(_discord)}" target="_blank" rel="noopener noreferrer">open a ticket on Discord</a>` : null,
  ].filter(Boolean).join(" or ");
%>
<%- include("../partials/session/statusPage.ejs", {
  image: "/images/session/errorImage.png",
  code: "Error " + _status,
  title: _clientMessage ? "We couldn't do that" : "Something went wrong on our end",
  message: _clientMessage || "Sorry about that. Please try again in a moment.",
  // Retrying a failed POST would resubmit it, so only offer it for page loads.
  actions: [
    ...(req.method === "GET" && req.url ? [{ href: req.url, label: "Try again", icon: "fa-solid fa-rotate-right", primary: true }] : []),
    { href: "/", label: "Back to home", primary: req.method !== "GET" },
  ],
  note: _contact ? "If it keeps happening, " + _contact + "." : null,
  details: _details
}) %>

<%- include("../modules/footer.ejs") %>
