<%- include("../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: "Verify your password reset code",
    // Auth / account utility page: never useful in search results.
    pageRobots: "noindex, follow"
}) %>

<%- include("../modules/navigationBar.ejs") %>

<%- include("../partials/miniHeader.ejs", {
  headerTitle: "Verify Reset Code",
  backgroundImage: globalImage
}) %>

<section class="section auth-page">
  <div class="container">
    <div class="row align-items-center justify-content-center g-5">
      <div class="col-md-9 col-lg-6 col-xl-5">
        <div class="auth-card">
          <h3 class="auth-title">Check your email</h3>
          <p class="auth-subtitle">
            <% if (username) { %>
              We've sent a code to the email on <strong><%= username %></strong>'s account.
            <% } else { %>
              If an account matches, we've sent it a code.
            <% } %>
            It expires in <%= expiryMinutes %> minutes.
          </p>

          <% if (req.cookies.alertType) { %>
            <%- include("../partials/alert.ejs", {
              alertType: req.cookies.alertType,
              content: req.cookies.alertContent
            }) %>
          <% } %>

          <form method="post" action="<%= process.env.siteAddress %>/forgot-password/verify">
            <div class="mb-4">
              <label for="code" class="form-label">6-digit code</label>
              <input type="text" class="form-control text-center fs-5" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}"
                     maxlength="6" autocomplete="one-time-code" placeholder="••••••" required autofocus>
            </div>
            <button type="submit" class="btn btn-primary w-100">Verify code</button>
          </form>

          <div class="auth-footer">
            No email? Check your spam folder, or <a href="/forgot-password">send a new code</a>.
          </div>
        </div>
      </div>
      <div class="col-lg-5 d-none d-lg-block text-center">
        <img class="floating auth-illustration" src="/images/session/registerImage.png" alt="" draggable="false">
      </div>
    </div>
  </div>
</section>

<%- include("../modules/footer.ejs") %>
