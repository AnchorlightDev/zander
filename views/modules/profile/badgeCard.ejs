<%
  const bg  = badge.backgroundColor || '#6c757d';
  const tc  = badge.textColor       || '#ffffff';
%>
<div class="badge-achievement-card card border-0 shadow-sm h-100" style="border-left: 4px solid <%= bg %> !important;">
  <div class="card-body d-flex align-items-center gap-3 p-3">
    <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center"
         style="background-color: <%= bg %>; width: 48px; height: 48px;">
      <i class="fa-solid fa-trophy" style="color: <%= tc %>; font-size: 1.2rem;"></i>
    </div>
    <div class="flex-grow-1 overflow-hidden">
      <div class="text-uppercase fw-semibold text-muted mb-1" style="font-size: 0.65rem; letter-spacing: 0.08em;">Achievement Unlocked</div>
      <div class="fw-bold text-truncate" style="font-size: 0.95rem;"><%= badge.name %></div>
      <% if (badge.description) { %>
        <div class="text-muted text-truncate" style="font-size: 0.8rem;"><%= badge.description %></div>
      <% } %>
    </div>
  </div>
</div>
