<%- include('../../modules/header.ejs', {
    pageTitle: pageTitle,
    pageDescription: "Support Tickets"
}) %>

<%- include('../../modules/navigationBar.ejs') %>

<%- include('../../partials/miniHeader.ejs', {
    headerTitle: "Support Tickets",
    globalImage,
}) %>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">My Tickets</h2>
        <a href="/support/create" class="btn btn-primary">Create New Ticket</a>
    </div>
    <div class="card">
        <div class="card-body">
            <% if (tickets.length === 0) { %>
                <div class="text-center py-5">
                    <i class="fas fa-ticket-alt text-muted fa-3x mb-3"></i>
                    <h5 class="text-muted">No tickets yet</h5>
                    <p class="text-muted mb-4">You haven't opened any support tickets. If you need help, we're here for you.</p>
                    <a href="/support/create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Open a ticket
                    </a>
                </div>
            <% } else { %>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Ticket ID</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% tickets.forEach(ticket => { %>
                            <tr>
                                <td>#<%= ticket.ticketId %></td>
                                <td><%= ticket.title %></td>
                                <% const statusClass = {
                                    open: "bg-success",
                                    closed: "bg-secondary",
                                    pending: "bg-warning text-dark"
                                }[ticket.status] || "bg-secondary"; %>
                                <td>
                                    <span class="badge rounded-pill <%= statusClass %>"><%= ticket.status %></span>
                                </td>
                                <td><span data-relative-time="<%= new Date(ticket.createdAt).toISOString() %>" data-relative-format="both"></span></td>
                                <td>
                                    <a href="/support/ticket/<%= ticket.ticketId %>" class="btn btn-primary">View</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</div>

<%- include('../../modules/footer.ejs') %>
