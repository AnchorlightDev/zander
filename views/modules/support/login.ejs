<%- include('../../modules/header.ejs', {
    pageTitle: 'Support',
    pageDescription: 'Get help from the CraftingForChrist team.'
}) %>

<%- include('../../modules/navigationBar.ejs') %>

<%- include('../../partials/miniHeader.ejs', {
    headerTitle: 'Support Center',
    globalImage,
}) %>

<section class="section">
  <div class="container">

    <!-- ── Intro ─────────────────────────────────────────────────────── -->
    <div class="row justify-content-center mb-5">
      <div class="col-lg-7 text-center">
        <h2 class="mb-3">How can we help?</h2>
        <p class="text-muted">
          Our team handles support through our ticket system — every request gets its own
          private thread on our Discord so you can track progress and get a real answer.
        </p>
      </div>
    </div>

    <!-- ── What we help with ─────────────────────────────────────────── -->
    <div class="row g-3 mb-5">
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 text-center p-3">
          <i class="fas fa-bug text-primary fa-2x mb-2"></i>
          <h6 class="mb-1">Bug Reports</h6>
          <p class="small text-muted mb-0">Something broken in-game or on the website.</p>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 text-center p-3">
          <i class="fas fa-gavel text-warning fa-2x mb-2"></i>
          <h6 class="mb-1">Ban Appeals</h6>
          <p class="small text-muted mb-0">Dispute a punishment or request a review.</p>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 text-center p-3">
          <i class="fas fa-shopping-cart text-success fa-2x mb-2"></i>
          <h6 class="mb-1">Store &amp; Billing</h6>
          <p class="small text-muted mb-0">Issues with purchases, ranks, or perks.</p>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 text-center p-3">
          <i class="fas fa-user-shield text-danger fa-2x mb-2"></i>
          <h6 class="mb-1">Player Reports</h6>
          <p class="small text-muted mb-0">Report rule-breaking or toxic behaviour.</p>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 text-center p-3">
          <i class="fas fa-tools text-info fa-2x mb-2"></i>
          <h6 class="mb-1">Account Help</h6>
          <p class="small text-muted mb-0">Username changes, linking, or login issues.</p>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100 text-center p-3">
          <i class="fas fa-question-circle text-secondary fa-2x mb-2"></i>
          <h6 class="mb-1">General Questions</h6>
          <p class="small text-muted mb-0">Anything else — we're happy to help.</p>
        </div>
      </div>
    </div>

    <!-- ── How it works ──────────────────────────────────────────────── -->
    <div class="row justify-content-center mb-5">
      <div class="col-lg-9">
        <h4 class="text-center mb-4">How it works</h4>
        <div class="row g-4 text-center">
          <div class="col-md-4">
            <div class="d-flex flex-column align-items-center">
              <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold mb-3"
                   style="width:48px;height:48px;font-size:18px;">1</div>
              <h6>Create an account</h6>
              <p class="text-muted small">
                Register at <a href="/register">/register</a> with your Minecraft username,
                email, and a password. Takes about a minute.
              </p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="d-flex flex-column align-items-center">
              <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold mb-3"
                   style="width:48px;height:48px;font-size:18px;">2</div>
              <h6>Verify your Minecraft account</h6>
              <p class="text-muted small">
                Join a verification server and enter the 6-digit code you receive, or run
                <code>/verify CODE</code> in-game.
              </p>
            </div>
          </div>
          <div class="col-md-4">
            <div class="d-flex flex-column align-items-center">
              <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold mb-3"
                   style="width:48px;height:48px;font-size:18px;">3</div>
              <h6>Submit a ticket</h6>
              <p class="text-muted small">
                Pick a category, describe your issue, and our team will respond as soon as
                possible — right here on the website or in Discord.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── CTA ───────────────────────────────────────────────────────── -->
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card shadow-sm text-center p-4">
          <h4 class="mb-2">Ready to get help?</h4>
          <p class="text-muted mb-4">Sign in to view your tickets or open a new one.</p>
          <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/login?returnTo=/support" class="btn btn-primary px-4">
              <i class="fas fa-sign-in-alt me-1"></i> Sign In
            </a>
            <a href="/register" class="btn btn-outline-primary px-4">
              <i class="fas fa-user-plus me-1"></i> Create Account
            </a>
          </div>
          <p class="text-muted small mt-3 mb-0">
            <i class="fas fa-info-circle me-1"></i>
            A verified Minecraft account is required to open tickets.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<%- include('../../modules/footer.ejs') %>
