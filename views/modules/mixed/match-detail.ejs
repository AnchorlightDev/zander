<%- include("_top.ejs") %>

<a href="/mixed/matches" class="btn btn-sm btn-outline-secondary mb-3">&larr; All matches</a>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card mb-4 mixed-map-detail-card">
      <div class="card-body p-4">
        <h4>Match on <%= match.map_name || match.map_key || "Unknown map" %></h4>
        <p class="text-muted mb-3"><%= match.gamemode || "-" %> - <%= match.status %></p>
        <div class="row">
          <div class="col-6 col-md-3"><small class="text-muted d-block">Started</small><%= match.started_at ? moment(match.started_at).format("lll") : "-" %></div>
          <div class="col-6 col-md-3"><small class="text-muted d-block">Duration</small><%= match.duration_seconds ? Math.round(match.duration_seconds / 60) + "m" : "-" %></div>
          <div class="col-6 col-md-3"><small class="text-muted d-block">Winner</small><%= (match.winners || []).join(", ") || "-" %></div>
          <div class="col-6 col-md-3"><small class="text-muted d-block">Kills</small><%= match.total_kills %></div>
        </div>
        <% if (match.map_key) { %><a href="/mixed/maps/<%= encodeURIComponent(match.map_key) %>" class="btn btn-sm btn-outline-primary mt-3">View map</a><% } %>
      </div>
    </div>

    <h5>Scoreboard</h5>
    <div class="table-responsive mb-4 mixed-table-card">
      <table class="table table-sm" data-mixed-datatable="scoreboard">
        <thead><tr><th>Player</th><th>Team</th><th>K</th><th>D</th><th>A</th><th>Obj</th><th>XP</th></tr></thead>
        <tbody>
          <% match.players.forEach(function(p){ %>
            <tr class="<%= p.won ? 'table-success' : '' %>">
              <td>
                <a href="/mixed/players/<%= p.player_uuid %>" class="d-flex align-items-center gap-2 text-decoration-none">
                  <img src="https://crafatar.com/avatars/<%= p.player_uuid %>?size=24&overlay" width="24" height="24" class="rounded flex-shrink-0" alt="" loading="lazy" onerror="this.style.display='none'">
                  <span><%= p.username || p.player_uuid %></span>
                </a>
              </td>
              <td><%= p.team_name || "-" %></td>
              <td><%= p.kills %></td><td><%= p.deaths %></td><td><%= p.assists %></td>
              <td><%= p.objectives %></td><td><%= p.xp_earned %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (!match.players.length) { %><div class="text-muted text-center py-3">No player rows.</div><% } %>
    </div>
  </div>

  <div class="col-lg-4">
    <h5>Timeline</h5>
    <div class="card mixed-map-detail-card">
      <div class="card-body p-3" style="max-height:560px; overflow:auto;">
        <ul class="list-unstyled mb-0">
          <% timeline.forEach(function(e){ %>
            <li class="border-bottom py-2 small">
              <div class="d-flex justify-content-between gap-2 mb-1">
                <strong><%= e.elapsedLabel || "-" %></strong>
                <span class="text-muted"><%= e.occurredLabel || "" %></span>
              </div>
              <div><%= e.summary %></div>
              <div class="text-muted mt-1"><%= e.event_type %></div>
            </li>
          <% }) %>
          <% if (!timeline.length) { %><li class="text-muted small">No events recorded.</li><% } %>
        </ul>
      </div>
    </div>
    <% if (isAdmin) { %>
      <div class="alert alert-warning small mt-3">Admin view: showing formatted timeline built from <%= events.length %> stored event rows.</div>
    <% } %>
  </div>
</div>

<%- include("_bottom.ejs") %>
