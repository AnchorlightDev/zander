<%- include("_top.ejs") %>

<div class="row g-4">
  <div class="col-lg-7">
    <% if (liveMatch) { %>
      <div class="card shadow-sm border-0 mixed-map-detail-card mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <strong><i class="fas fa-circle text-success me-1" style="font-size:.6rem;"></i> Live now</strong>
          <a href="/mixed/live" class="btn btn-sm btn-outline-success">Watch live</a>
        </div>
        <div class="card-body">
          <h5 class="mb-1"><%= liveMatch.map_name || liveMatch.map_key %></h5>
          <div class="text-muted"><%= liveMatch.server_name %> - <%= liveMatch.gamemode || "-" %> - <%= liveMatch.server_players %> players</div>
        </div>
      </div>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0">Recent matches</h4>
      <a href="/mixed/matches" class="btn btn-sm btn-outline-secondary">View all</a>
    </div>

    <div class="row g-3 mb-4">
      <% if (!recentMatches.length) { %>
        <div class="col-12"><div class="card shadow-sm border-0"><div class="card-body text-muted">No matches recorded yet.</div></div></div>
      <% } %>
      <% recentMatches.forEach(function(m){ %>
        <div class="col-12">
          <a href="/mixed/matches/<%= m.match_id %>" class="mixed-map-link">
            <div class="card shadow-sm border-0 mixed-map-card">
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start gap-3">
                  <div>
                    <h5 class="mb-1 mixed-map-title">Match on <%= m.map_name || m.map_key || "Unknown map" %></h5>
                    <div class="mixed-map-meta mb-0">
                      <span class="mixed-map-mode"><%= m.gamemode || "-" %></span>
                      <span><%= m.started_at ? moment(m.started_at).fromNow() : "" %></span>
                    </div>
                  </div>
                  <div class="text-end small text-muted">
                    <div><%= m.participants_count || 0 %> players</div>
                    <div><%= m.total_kills || 0 %> kills</div>
                  </div>
                </div>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0">Featured maps</h4>
      <a href="/mixed/maps" class="btn btn-sm btn-outline-secondary">View all</a>
    </div>

    <div class="row g-3 mb-4">
      <% featuredMaps.forEach(function(map){ %>
        <div class="col-12">
          <div class="card shadow-sm border-0 mixed-map-card">
            <a href="/mixed/maps/<%= encodeURIComponent(map.map_key) %>" class="mixed-map-link">
              <% if (map.display_image_url) { %>
                <img src="<%= map.display_image_url %>" class="card-img-top mixed-map-image" alt="<%= map.display_name %>">
              <% } else { %>
                <div class="mixed-map-placeholder"></div>
              <% } %>
              <div class="card-body py-3">
                <div class="d-flex justify-content-between align-items-start gap-3">
                  <div>
                    <h5 class="mb-1 mixed-map-title"><%= map.display_name %></h5>
                    <div class="mixed-map-meta mb-0">
                      <span class="mixed-map-mode"><%= map.gamemode || "-" %></span>
                      <span><%= (map.display_authors || []).join(", ") || "Unknown author" %></span>
                    </div>
                  </div>
                  <div class="text-end small text-muted">
                    <div><%= Number(map.average_overall || 0).toFixed(1) %>★</div>
                    <div><%= map.times_played %> plays</div>
                  </div>
                </div>
              </div>
            </a>
          </div>
        </div>
      <% }) %>
    </div>

    <h4>Top players</h4>
    <div class="card shadow-sm border-0 mixed-table-card mb-4">
      <ol class="list-group list-group-numbered list-group-flush">
        <% topLevel.forEach(function(p){ %>
          <li class="list-group-item mixed-list-item d-flex justify-content-between align-items-center">
            <a href="/mixed/players/<%= p.player_uuid %>" class="d-flex align-items-center gap-2 text-decoration-none">
              <img src="https://crafatar.com/avatars/<%= p.player_uuid %>?size=24&overlay" width="24" height="24" class="rounded flex-shrink-0" alt="" loading="lazy" onerror="this.style.display='none'">
              <span><%= p.username || p.player_uuid %></span>
            </a>
            <span class="badge rank-pill">Lvl <%= p.level %></span>
          </li>
        <% }) %>
        <% if (!topLevel.length) { %><li class="list-group-item text-muted">No players yet.</li><% } %>
      </ol>
    </div>
  </div>
</div>

<%- include("_bottom.ejs") %>
