        <img id="pollImageModalImg" src="" alt="" class="img-fluid rounded" style="max-height:80vh;">
      </div>
    </div>
  </div>
</div>
<script>
(function() {
  var modal = document.getElementById('pollImageModal');
  if (!modal) return;
  modal.addEventListener('show.bs.modal', function(e) {
    var trigger = e.relatedTarget;
    if (!trigger) return;
    document.getElementById('pollImageModalImg').src = trigger.dataset.imgSrc || '';
    document.getElementById('pollImageModalImg').alt = trigger.dataset.imgAlt || '';
  });
})();
</script>

