<%- include("../../modules/header.ejs", {
    pageTitle: `${discussion.title} :: ${category ? category.name : 'Forums'}`,
    pageDescription: category && category.description ? category.description : "Forum discussion"
}) %>

<%- include("../../modules/navigationBar.ejs") %>

<%- include("../../partials/miniHeader.ejs", {
  headerTitle: discussion.title,
  backgroundImage: globalImage
}) %>

<% const currentUser = req.session?.user || null; %>
<% const canReportContent = features.report && currentUser; %>
<% const discussionBasePath = `/forums/discussion/${discussion.discussionId}${discussion.slug ? '/' + discussion.slug : ''}`; %>

<div class="container my-5 forums-container">
  <div class="row g-4">
    <div class="col-lg-3">
      <%- include("./partials/sidebar.ejs", {
        categories: categories,
        activeCategory: category
      }) %>
    </div>
    <div class="col-lg-9">
      <% if (req.cookies.alertType) { %>
        <%- include("../../partials/alert.ejs", {
          alertType: req.cookies.alertType,
          content: req.cookies.alertContent
        }) %>
      <% } %>

      <div class="forums-card card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
              <div class="d-flex align-items-center gap-2 mb-2">
                <% if (discussion.isSticky) { %>
                  <span class="forums-badge sticky">Sticky</span>
                <% } %>
                <% if (discussion.isLocked) { %>
                  <span class="forums-badge locked"><i class="fa-solid fa-lock"></i> Locked</span>
                <% } %>
                <% if (discussion.isArchived) { %>
                  <span class="forums-badge archived">Archived</span>
                <% } %>
              </div>
              <div class="text-muted">
                Posted in <a href="/forums/category/<%= category.slug %>"><%= category.name %></a>
                <% if (discussion.createdBy && posts.length) { %>
                  · <span data-relative-time="<%= new Date(discussion.createdAt).toISOString() %>" data-relative-format="datetime"></span>
                <% } %>
              </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <% const canEditDiscussion = canModerate || (currentUserId && currentUserId === discussion.createdBy); %>
              <% if (canEditDiscussion) { %>
                <a class="btn btn-sm btn-outline-secondary" href="/forums/discussion/<%= discussion.discussionId %>/edit"><i class="fa-solid fa-pen"></i> Edit</a>
              <% } %>
              <% if (canLock) { %>
                <form action="/forums/discussion/<%= discussion.discussionId %>/moderate" method="post" class="d-inline">
                  <input type="hidden" name="action" value="<%= discussion.isLocked ? 'unlock' : 'lock' %>">
                  <button type="submit" class="btn btn-sm btn-outline-warning"><i class="fa-solid fa-lock"></i> <%= discussion.isLocked ? 'Unlock' : 'Lock' %></button>
                </form>
              <% } %>
              <% if (canSticky) { %>
                <form action="/forums/discussion/<%= discussion.discussionId %>/moderate" method="post" class="d-inline">
                  <input type="hidden" name="action" value="<%= discussion.isSticky ? 'unsticky' : 'sticky' %>">
                  <button type="submit" class="btn btn-sm btn-outline-info"><i class="fa-solid fa-thumbtack"></i> <%= discussion.isSticky ? 'Unpin' : 'Pin' %></button>
                </form>
              <% } %>
              <% if (canArchive) { %>
                <form action="/forums/discussion/<%= discussion.discussionId %>/moderate" method="post" class="d-inline">
                  <input type="hidden" name="action" value="<%= discussion.isArchived ? 'unarchive' : 'archive' %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-box-archive"></i> <%= discussion.isArchived ? 'Unarchive' : 'Archive' %></button>
                </form>
              <% } %>
              <% if (canModerate && typeof moveCategories !== 'undefined' && moveCategories && moveCategories.length) { %>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#moveDiscussionModal"><i class="fa-solid fa-arrows-up-down-left-right"></i> Move</button>
              <% } %>
              <% if (canEditDiscussion) { %>
                <form action="/forums/discussion/<%= discussion.discussionId %>/delete" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this discussion and all its replies?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i> Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="forums-thread">
        <% posts.forEach(function(post) { %>
          <% const isAuthor = currentUserId && post.user && currentUserId === post.user.userId; %>
          <article id="post-<%= post.postId %>" class="forums-post card shadow-sm mb-4 <%= post.isOriginal ? 'original-post' : '' %>">
            <div class="card-body">
              <div class="forums-post-header">
                <div class="forums-post-author">
                  <% if (post.user) { %>
                    <img src="<%= post.user.avatarUrl %>" alt="<%= post.user.username %> avatar" class="forums-avatar-inline rounded-circle" loading="lazy">
                    <div class="forums-post-author-details">
                      <div class="forums-post-author-line">
                        <a class="forums-post-username" href="/profile/<%= post.user.username %>"><%= post.user.username %></a>
                        <% if (post.user.ranks && post.user.ranks.length) { %>
                          <div class="forums-post-ranks">
                            <% post.user.ranks.forEach(function(rank) { %>
                              <span class="forums-post-rank" style="background-color: <%= rank.badgeColour || '#1f2937' %>; color: <%= rank.textColour || '#ffffff' %>;"><%= rank.displayName %></span>
                            <% }); %>
                          </div>
                        <% } %>
                      </div>
                      <div class="forums-post-date">
                        Posted <span data-relative-time="<%= new Date(post.createdAt).toISOString() %>"></span>
                        <% if (post.updatedAt && new Date(post.updatedAt).getTime() !== new Date(post.createdAt).getTime()) { %>
                          · <span class="edited-indicator" data-edited-time="<%= new Date(post.updatedAt).toISOString() %>">edited</span>
                        <% } %>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="forums-post-author-details"><span class="forums-post-username">Unknown</span></div>
                  <% } %>
                </div>
              </div>
              <div class="forums-post-content">
                <% if (post.replyTo && post.replyTo.user) { %>
                  <a href="#post-<%= post.replyTo.postId %>" class="forums-reply-context">
                    <i class="fa-solid fa-reply" aria-hidden="true"></i>
                    <span>Replying to <strong><%= post.replyTo.user.username %></strong></span>
                    <i class="fa-solid fa-arrow-up-right-from-square forums-reply-context-link" aria-hidden="true"></i>
                  </a>
                <% } %>
                <div class="forums-post-body">
                  <%- post.content %>
                </div>

                <div class="forums-post-actions" aria-label="Post actions">
                  <div class="forums-post-actions-primary">
                      <% if (canReply && post.user) { %>
                        <button type="button" class="forums-post-action forums-reply-action"
                                data-reply-mode="reply" data-post-id="<%= post.postId %>" data-username="<%= post.user.username %>">
                          <i class="fa-solid fa-reply"></i> Reply
                        </button>
                        <button type="button" class="forums-post-action forums-reply-action"
                                data-reply-mode="quote" data-post-id="<%= post.postId %>" data-username="<%= post.user.username %>">
                          <i class="fa-solid fa-quote-left"></i> Quote
                        </button>
                      <% } %>
                  </div>
                  <div class="forums-post-actions-secondary">
                      <% if (canModerate && post.revisions && post.revisions.length) { %>
                        <a class="forums-post-action" href="/forums/post/<%= post.postId %>/revisions"><i class="fa-solid fa-clock-rotate-left"></i> History (<%= post.revisions.length %>)</a>
                      <% } %>
                      <% if (post.isOriginal) { %>
                        <% if (canModerate || (currentUserId && currentUserId === discussion.createdBy)) { %>
                          <a class="forums-post-action" href="/forums/discussion/<%= discussion.discussionId %>/edit"><i class="fa-solid fa-pen"></i> Edit</a>
                        <% } %>
                      <% } else { %>
                        <% if (canModerate || isAuthor) { %>
                          <a class="forums-post-action" href="/forums/post/<%= post.postId %>/edit"><i class="fa-solid fa-pen"></i> Edit</a>
                        <% } %>
                        <% if (canModerate || isAuthor || canDeleteAnyPost) { %>
                          <form action="/forums/post/<%= post.postId %>/delete" method="post" class="d-inline" onsubmit="return confirm('Delete this reply?');">
                            <button type="submit" class="forums-post-action is-danger"><i class="fa-solid fa-trash"></i> Delete</button>
                          </form>
                        <% } %>
                      <% } %>
                      <% if (canReportContent && post.user) { %>
                        <button
                          type="button"
                          class="forums-post-action is-danger forums-report-button"
                          data-bs-toggle="modal"
                          data-bs-target="#reportPostModal"
                          data-post-id="<%= post.postId %>"
                          data-post-type="<%= post.isOriginal ? 'discussion' : 'reply' %>"
                          data-username="<%= post.user.username %>"
                          data-post-url="<%= discussionBasePath %>#post-<%= post.postId %>"
                        >
                          <i class="fa-solid fa-flag"></i> Report
                        </button>
                      <% } %>
                  </div>
                </div>

                  <% if (post.isOriginal && typeof poll !== 'undefined' && poll) { %>
                    <div class="forums-poll mt-4">
                      <div class="forums-poll-header">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                          <h6 class="mb-0"><i class="fa-solid fa-chart-bar me-1"></i>Poll</h6>
                          <span class="forums-poll-badge <%= poll.isOpen ? 'open' : 'closed' %>">
                            <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i>
                            <%= poll.isOpen ? 'Open' : 'Closed' %>
                          </span>
                        </div>
                        <p class="forums-poll-question mt-2 mb-0"><%= poll.question %></p>
                      </div>

                      <% const isPicturePoll = poll.options.some(function(o) { return !!o.imageUrl; }); %>
                      <div class="forums-poll-body">

                        <% if (isPicturePoll) { %>
                          <%/* ── Picture poll results grid ── */%>
                          <div class="forums-poll-pic-grid">
                            <% poll.options.forEach(function(opt) { %>
                              <div class="forums-poll-pic-card <%= opt.votedByViewer ? 'voted' : '' %>">
                                <div class="forums-poll-pic-img-wrap">
                                  <% if (opt.imageUrl) { %>
                                    <img src="<%= opt.imageUrl %>" alt="<%= opt.label %>" class="forums-poll-pic-img">
                                    <button type="button" class="forums-poll-pic-enlarge" data-img-src="<%= opt.imageUrl %>" data-img-alt="<%= opt.label %>" data-bs-toggle="modal" data-bs-target="#pollImageModal" title="Enlarge image"><i class="fa-solid fa-expand"></i></button>
                                  <% } else { %>
                                    <div class="forums-poll-pic-img-placeholder"><i class="fa-regular fa-image"></i></div>
                                  <% } %>
                                  <% if (opt.votedByViewer) { %>
                                    <span class="forums-poll-pic-check"><i class="fa-solid fa-circle-check"></i></span>
                                  <% } %>
                                  <span class="forums-poll-pic-pct-badge"><%= opt.percentage %>%</span>
                                </div>
                                <div class="forums-poll-pic-card-body">
                                  <div class="forums-poll-pic-label"><%= opt.label %></div>
                                  <div class="forums-poll-bar-track" style="margin-bottom:0.3rem;">
                                    <div class="forums-poll-bar-fill <%= opt.votedByViewer ? 'voted' : '' %>"
                                         style="width:<%= opt.percentage %>%"></div>
                                  </div>
                                  <div class="forums-poll-pic-meta">
                                    <span><%= opt.voteCount %> vote<%= opt.voteCount !== 1 ? 's' : '' %></span>
                                    <% if (poll.showVoters && opt.voters && opt.voters.length > 0) { %>
                                      <span class="forums-poll-voters-inline">
                                        <% opt.voters.forEach(function(voter) { %>
                                          <a href="/profile/<%= voter.username %>" title="<%= voter.username %>">
                                            <img src="<%= voter.avatarUrl %>" alt="<%= voter.username %>" class="forums-poll-voter-avatar">
                                          </a>
                                        <% }); %>
                                      </span>
                                    <% } %>
                                  </div>
                                </div>
                              </div>
                            <% }); %>
                          </div>
                        <% } else { %>
                          <%/* ── Standard text poll results ── */%>
                          <% poll.options.forEach(function(opt) { %>
                            <div class="forums-poll-option">
                              <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="forums-poll-option-label-group">
                                  <span class="forums-poll-option-label <%= opt.votedByViewer ? 'voted' : '' %>">
                                    <% if (opt.votedByViewer) { %>
                                      <i class="fa-solid fa-circle-check" style="color:#2f508c;font-size:0.85rem;"></i>
                                    <% } %>
                                    <%= opt.label %>
                                  </span>
                                  <% if (poll.showVoters && opt.voters && opt.voters.length > 0) { %>
                                    <span class="forums-poll-voters-inline">
                                      <% opt.voters.forEach(function(voter) { %>
                                        <a href="/profile/<%= voter.username %>" title="<%= voter.username %>">
                                          <img src="<%= voter.avatarUrl %>" alt="<%= voter.username %>" class="forums-poll-voter-avatar">
                                        </a>
                                      <% }); %>
                                    </span>
                                  <% } %>
                                </div>
                                <span class="forums-poll-bar-pct"><%= opt.voteCount %> · <%= opt.percentage %>%</span>
                              </div>
                              <div class="forums-poll-bar-track">
                                <div class="forums-poll-bar-fill <%= opt.votedByViewer ? 'voted' : '' %>"
                                     style="width:<%= opt.percentage %>%"></div>
                              </div>
                            </div>
                          <% }); %>
                        <% } %>

                        <% if (currentUser && poll.isOpen) { %>
                          <% if (poll.viewerCanVote) { %>
                            <div class="forums-poll-vote-controls">
                              <form action="/forums/discussion/<%= discussion.discussionId %>/poll/vote" method="post">
                                <% if (isPicturePoll) { %>
                                  <p class="small text-muted mb-2">Cast your vote<% if (poll.allowMultiple) { %> — multiple choices allowed<% } %>:</p>
                                  <div class="forums-poll-pic-vote-grid">
                                    <% poll.options.forEach(function(opt) { %>
                                      <label class="forums-poll-pic-vote-card" for="voteOpt-<%= opt.optionId %>">
                                        <input class="forums-poll-pic-vote-input"
                                               type="<%= poll.allowMultiple ? 'checkbox' : 'radio' %>"
                                               name="optionId" value="<%= opt.optionId %>"
                                               id="voteOpt-<%= opt.optionId %>">
                                        <div class="forums-poll-pic-img-wrap">
                                          <% if (opt.imageUrl) { %>
                                            <img src="<%= opt.imageUrl %>" alt="<%= opt.label %>" class="forums-poll-pic-img">
                                            <button type="button" class="forums-poll-pic-enlarge" data-img-src="<%= opt.imageUrl %>" data-img-alt="<%= opt.label %>" data-bs-toggle="modal" data-bs-target="#pollImageModal" title="Enlarge image" onclick="event.preventDefault();event.stopPropagation();"><i class="fa-solid fa-expand"></i></button>
                                          <% } else { %>
                                            <div class="forums-poll-pic-img-placeholder"><i class="fa-regular fa-image"></i></div>
                                          <% } %>
                                          <span class="forums-poll-pic-vote-check-overlay"><i class="fa-solid fa-circle-check"></i></span>
                                        </div>
                                        <div class="forums-poll-pic-vote-label"><%= opt.label %></div>
                                      </label>
                                    <% }); %>
                                  </div>
                                <% } else { %>
                                  <p class="small text-muted mb-2">Cast your vote<% if (poll.allowMultiple) { %> — multiple choices allowed<% } %>:</p>
                                  <% poll.options.forEach(function(opt) { %>
                                    <div class="form-check mb-1">
                                      <input class="form-check-input"
                                             type="<%= poll.allowMultiple ? 'checkbox' : 'radio' %>"
                                             name="optionId" value="<%= opt.optionId %>"
                                             id="voteOpt-<%= opt.optionId %>">
                                      <label class="form-check-label" for="voteOpt-<%= opt.optionId %>"><%= opt.label %></label>
                                    </div>
                                  <% }); %>
                                <% } %>
                                <button type="submit" class="btn btn-main btn-sm mt-2">
                                  <i class="fa-solid fa-check me-1"></i>Submit Vote
                                </button>
                              </form>
                            </div>
                          <% } else if (poll.viewerCanChange) { %>
                            <div class="forums-poll-vote-controls">
                              <form action="/forums/discussion/<%= discussion.discussionId %>/poll/vote/change" method="post">
                                <% if (isPicturePoll) { %>
                                  <p class="small text-muted mb-2">Change your vote<% if (poll.allowMultiple) { %> — multiple choices allowed<% } %>:</p>
                                  <div class="forums-poll-pic-vote-grid">
                                    <% poll.options.forEach(function(opt) { %>
                                      <label class="forums-poll-pic-vote-card" for="changeOpt-<%= opt.optionId %>">
                                        <input class="forums-poll-pic-vote-input"
                                               type="<%= poll.allowMultiple ? 'checkbox' : 'radio' %>"
                                               name="optionId" value="<%= opt.optionId %>"
                                               id="changeOpt-<%= opt.optionId %>"
                                               <%= opt.votedByViewer ? 'checked' : '' %>>
                                        <div class="forums-poll-pic-img-wrap">
                                          <% if (opt.imageUrl) { %>
                                            <img src="<%= opt.imageUrl %>" alt="<%= opt.label %>" class="forums-poll-pic-img">
                                            <button type="button" class="forums-poll-pic-enlarge" data-img-src="<%= opt.imageUrl %>" data-img-alt="<%= opt.label %>" data-bs-toggle="modal" data-bs-target="#pollImageModal" title="Enlarge image" onclick="event.preventDefault();event.stopPropagation();"><i class="fa-solid fa-expand"></i></button>
                                          <% } else { %>
                                            <div class="forums-poll-pic-img-placeholder"><i class="fa-regular fa-image"></i></div>
                                          <% } %>
                                          <span class="forums-poll-pic-vote-check-overlay"><i class="fa-solid fa-circle-check"></i></span>
                                        </div>
                                        <div class="forums-poll-pic-vote-label"><%= opt.label %></div>
                                      </label>
                                    <% }); %>
                                  </div>
                                <% } else { %>
                                  <p class="small text-muted mb-2">Change your vote<% if (poll.allowMultiple) { %> — multiple choices allowed<% } %>:</p>
                                  <% poll.options.forEach(function(opt) { %>
                                    <div class="form-check mb-1">
                                      <input class="form-check-input"
                                             type="<%= poll.allowMultiple ? 'checkbox' : 'radio' %>"
                                             name="optionId" value="<%= opt.optionId %>"
                                             id="changeOpt-<%= opt.optionId %>"
                                             <%= opt.votedByViewer ? 'checked' : '' %>>
                                      <label class="form-check-label" for="changeOpt-<%= opt.optionId %>"><%= opt.label %></label>
                                    </div>
                                  <% }); %>
                                <% } %>
                                <button type="submit" class="btn btn-outline-primary btn-sm mt-2">
                                  <i class="fa-solid fa-rotate-right me-1"></i>Update Vote
                                </button>
                              </form>
                            </div>
                          <% } else if (poll.viewerHasVoted) { %>
                            <div class="forums-poll-vote-controls">
                              <p class="small text-muted mb-0">
                                <i class="fa-solid fa-check me-1 text-success"></i>
                                You have voted.<% if (!poll.allowVoteChange) { %> Vote changes are not allowed for this poll.<% } %>
                              </p>
                            </div>
                          <% } %>
                        <% } else if (!currentUser) { %>
                          <div class="forums-poll-vote-controls">
                            <a href="/login?returnTo=<%= encodeURIComponent(req.url) %>"
                               class="btn btn-outline-primary btn-sm">
                              <i class="fa-solid fa-right-to-bracket me-1"></i>Log in to vote
                            </a>
                          </div>
                        <% } else if (!poll.isOpen) { %>
                          <div class="forums-poll-vote-controls">
                            <p class="small text-muted mb-0">
                              <i class="fa-solid fa-lock me-1"></i>This poll is closed.
                            </p>
                          </div>
                        <% } %>
                      </div>

                      <div class="forums-poll-footer d-flex flex-wrap gap-3">
                        <span>
                          <i class="fa-solid fa-users me-1"></i>
                          <%= poll.totalVotes %> vote<%= poll.totalVotes !== 1 ? 's' : '' %>
                        </span>
                        <% if (poll.allowMultiple) { %>
                          <span><i class="fa-solid fa-list-check me-1"></i>Multiple choices allowed</span>
                        <% } %>
                        <% if (poll.showVoters) { %>
                          <span><i class="fa-solid fa-eye me-1"></i>Voters are public</span>
                        <% } %>
                        <% if (poll.expiresAt) { %>
                          <span>
                            <i class="fa-solid fa-clock me-1"></i>
                            <% if (poll.isOpen) { %>
                              Closes <span data-relative-time="<%= new Date(poll.expiresAt).toISOString() %>" data-relative-format="datetime"></span>
                            <% } else { %>
                              Closed <span data-relative-time="<%= new Date(poll.expiresAt).toISOString() %>" data-relative-format="datetime"></span>
                            <% } %>
                          </span>
                        <% } %>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
          </article>
        <% }); %>
      </div>

      <% if (discussion.isArchived) { %>
        <div class="alert alert-warning"><i class="fa-solid fa-box-archive me-2"></i>This discussion has been archived and can no longer receive new replies.</div>
      <% } else if (discussion.isLocked) { %>
        <div class="alert alert-info"><i class="fa-solid fa-lock me-2"></i>This discussion is locked. New replies are disabled.</div>
      <% } %>

      <% if (canReply) { %>
        <div class="forums-card card shadow-sm mt-4" id="forum-reply-composer">
          <div class="card-body">
            <h5 class="mb-3" id="forum-reply-heading">Post a reply</h5>
            <form action="/forums/discussion/<%= discussion.discussionId %>/<%= discussion.slug %>/reply" method="post">
              <input type="hidden" name="replyToPostId" id="forum-reply-to-post-id" value="">
              <div class="alert alert-light border d-none align-items-center justify-content-between gap-2 py-2 mb-3" id="forum-reply-target">
                <span></span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="forum-reply-target-clear">Cancel</button>
              </div>
              <%- include("../../partials/summerNoteEditor.ejs", {
                editorElementName: "discussionReply",
                editorPOSTElementName: "content",
                editorElementText: ""
              }) %>
              <div class="text-end mt-3">
                <button type="submit" class="btn btn-main">Submit Reply</button>
              </div>
            </form>
          </div>
        </div>
      <% } else if (!currentUser && !discussion.isArchived && !discussion.isLocked) { %>
        <div class="forums-card card shadow-sm mt-4">
          <div class="card-body text-center py-4">
            <i class="fa-solid fa-comments fa-2x text-muted mb-3"></i>
            <h5 class="mb-2">Want to join the conversation?</h5>
            <p class="text-muted mb-3">Sign up or log in to share your thoughts and connect with the community.</p>
            <div class="d-flex justify-content-center gap-2">
              <a href="/login?returnTo=<%= encodeURIComponent(req.url) %>" class="btn btn-main">Log In</a>
              <a href="/register" class="btn btn-outline-secondary">Sign Up</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<% if (canReportContent) { %>
  <div class="modal fade" id="reportPostModal" tabindex="-1" aria-labelledby="reportPostModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form id="reportPostForm" novalidate>
          <div class="modal-header">
            <h5 class="modal-title" id="reportPostModalLabel">Report forum content</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="alert d-none" data-report-feedback role="alert"></div>
            <p class="text-muted small mb-2" data-report-target></p>
            <a class="small text-break d-none" data-report-link target="_blank" rel="noopener"></a>
            <div class="mb-3">
              <label for="reportReasonInput" class="form-label">Reason</label>
              <input
                type="text"
                class="form-control"
                id="reportReasonInput"
                name="reportReason"
                maxlength="100"
                required
              >
              <div class="form-text">Provide a short summary (max 100 characters).</div>
            </div>
            <div class="mb-3">
              <label for="reportEvidenceInput" class="form-label">Additional details (optional)</label>
              <textarea
                class="form-control"
                id="reportEvidenceInput"
                name="reportReasonEvidence"
                rows="4"
                placeholder="Include any supporting details or links."
              ></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">Submit report</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const reportModal = document.getElementById('reportPostModal');
      if (!reportModal) {
        return;
      }

      const reportForm = document.getElementById('reportPostForm');
      const reasonInput = reportForm.querySelector('#reportReasonInput');
      const evidenceInput = reportForm.querySelector('#reportEvidenceInput');
      const feedbackEl = reportForm.querySelector('[data-report-feedback]');
      const targetEl = reportForm.querySelector('[data-report-target]');
      const linkEl = reportForm.querySelector('[data-report-link]');
      const submitButton = reportForm.querySelector('button[type="submit"]');
      const defaultSubmitText = submitButton.textContent;

      const hideFeedback = () => {
        feedbackEl.classList.add('d-none');
        feedbackEl.classList.remove('alert-success', 'alert-danger');
        feedbackEl.textContent = '';
      };

      const showFeedback = (type, message) => {
        feedbackEl.classList.remove('d-none');
        feedbackEl.classList.toggle('alert-success', type === 'success');
        feedbackEl.classList.toggle('alert-danger', type !== 'success');
        feedbackEl.textContent = message;
      };

      reportModal.addEventListener('show.bs.modal', (event) => {
        const trigger = event.relatedTarget;
        hideFeedback();
        reportForm.reset();

        if (!trigger) {
          reportForm.removeAttribute('action');
          targetEl.textContent = '';
          linkEl.classList.add('d-none');
          linkEl.textContent = '';
          linkEl.removeAttribute('href');
          submitButton.disabled = false;
          submitButton.textContent = defaultSubmitText;
          return;
        }

        const postId = trigger.getAttribute('data-post-id');
        const username = trigger.getAttribute('data-username') || 'this user';
        const postType = trigger.getAttribute('data-post-type') || 'post';
        const postUrl = trigger.getAttribute('data-post-url') || '';

        if (!postId) {
          reportForm.removeAttribute('action');
          targetEl.textContent = 'Unable to determine which post to report.';
          linkEl.classList.add('d-none');
          linkEl.textContent = '';
          linkEl.removeAttribute('href');
          submitButton.disabled = true;
          submitButton.textContent = defaultSubmitText;
          return;
        }

        reportForm.setAttribute('action', `/forums/post/${postId}/report`);
        targetEl.textContent = `Reporting ${username}'s ${postType}.`;

        if (postUrl) {
          let absoluteUrl = postUrl;
          try {
            absoluteUrl = new URL(postUrl, window.location.origin).toString();
          } catch (error) {
            console.warn('Unable to resolve post URL', error);
          }

          linkEl.textContent = absoluteUrl;
          linkEl.setAttribute('href', absoluteUrl);
          linkEl.classList.remove('d-none');
        } else {
          linkEl.textContent = '';
          linkEl.removeAttribute('href');
          linkEl.classList.add('d-none');
        }

        submitButton.disabled = false;
        submitButton.textContent = defaultSubmitText;
      });

      reportModal.addEventListener('hidden.bs.modal', () => {
        hideFeedback();
        reportForm.reset();
        reportForm.removeAttribute('action');
        linkEl.textContent = '';
        linkEl.removeAttribute('href');
        linkEl.classList.add('d-none');
        submitButton.disabled = false;
        submitButton.textContent = defaultSubmitText;
      });

      reportForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        hideFeedback();

        const action = reportForm.getAttribute('action');
        if (!action) {
          showFeedback('danger', 'Unable to determine which post to report.');
          return;
        }

        const reason = reasonInput.value.trim();
        const details = evidenceInput.value.trim();

        if (!reason) {
          showFeedback('danger', 'Please provide a reason for your report.');
          reasonInput.focus();
          return;
        }

        submitButton.disabled = true;
        submitButton.textContent = 'Submitting...';

        try {
          const response = await fetch(action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              reportReason: reason,
              reportReasonEvidence: details,
            }),
          });

          const data = await response.json().catch(() => null);

          if (response.ok && data?.success) {
            showFeedback('success', data.message || 'Thanks, your report has been submitted.');
            reportForm.reset();

            setTimeout(() => {
              const modalConstructor = window.bootstrap && window.bootstrap.Modal;
              if (modalConstructor) {
                const modalInstance = modalConstructor.getInstance(reportModal);
                if (modalInstance) {
                  modalInstance.hide();
                }
              }
            }, 1200);
          } else {
            const message =
              data?.message ||
              (response.status === 401
                ? 'You must be logged in to report posts.'
                : 'Unable to submit your report right now. Please try again later.');
            showFeedback('danger', message);
          }
        } catch (error) {
          console.error('Failed to submit forum report', error);
          showFeedback('danger', 'An unexpected error occurred. Please try again later.');
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = defaultSubmitText;
        }
      });
    })();
  </script>
<% } %>

<% if (canModerate && typeof moveCategories !== 'undefined' && moveCategories && moveCategories.length) { %>
<div class="modal fade" id="moveDiscussionModal" tabindex="-1" aria-labelledby="moveDiscussionModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/forums/discussion/<%= discussion.discussionId %>/move" method="post">
        <div class="modal-header">
          <h5 class="modal-title" id="moveDiscussionModalLabel">Move Discussion</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small">Move "<strong><%= discussion.title %></strong>" to a different category.</p>
          <div class="mb-3">
            <label for="newCategoryId" class="form-label">Destination Category</label>
            <select class="form-select" name="newCategoryId" id="newCategoryId" required>
              <option value="" disabled selected>Select a category...</option>
              <% moveCategories.forEach(function(cat) { %>
                <% if (cat.categoryId !== discussion.categoryId) { %>
                  <option value="<%= cat.categoryId %>"><%= cat.parentName ? cat.parentName + ' → ' : '' %><%= cat.name %></option>
                <% } %>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-main">Move Discussion</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<script>
  (() => {
    const composer = document.getElementById('forum-reply-composer');
    const replyToInput = document.getElementById('forum-reply-to-post-id');
    const replyHeading = document.getElementById('forum-reply-heading');
    const replyTarget = document.getElementById('forum-reply-target');
    const replyTargetText = replyTarget?.querySelector('span');
    const replyEditor = document.getElementById('discussionReply');

    const escapeHtml = (value) => String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

    const appendToReplyEditor = (html) => {
      if (!replyEditor) return;
      const $editor = window.jQuery ? window.jQuery(replyEditor) : null;
      if ($editor?.data('summernote')) {
        const existing = $editor.summernote('isEmpty') ? '' : $editor.summernote('code');
        $editor.summernote('code', existing + html);
        $editor.summernote('focus');
      } else {
        replyEditor.value = (replyEditor.value || '') + html;
        replyEditor.focus();
      }
    };

    const clearReplyTarget = () => {
      if (!replyToInput) return;
      replyToInput.value = '';
      replyHeading.textContent = 'Post a reply';
      replyTarget.classList.add('d-none');
      replyTarget.classList.remove('d-flex');
    };

    document.querySelectorAll('.forums-reply-action').forEach((button) => {
      button.addEventListener('click', () => {
        if (!composer || !replyToInput) return;
        const postId = button.dataset.postId;
        const username = button.dataset.username || 'this user';
        const mode = button.dataset.replyMode;
        replyToInput.value = postId;
        replyHeading.textContent = mode === 'quote' ? `Quote ${username}` : `Reply to ${username}`;
        replyTargetText.textContent = `${mode === 'quote' ? 'Quoting' : 'Replying to'} ${username}'s post`;
        replyTarget.classList.remove('d-none');
        replyTarget.classList.add('d-flex');

        if (mode === 'quote') {
          const body = document.querySelector(`#post-${postId} .forums-post-body`);
          const copy = body?.cloneNode(true);
          copy?.querySelectorAll('blockquote, img, iframe, video, table').forEach((element) => element.remove());
          let excerpt = (copy?.innerText || copy?.textContent || '').replace(/\s+/g, ' ').trim();
          if (excerpt.length > 1000) excerpt = excerpt.slice(0, 997).trimEnd() + '...';
          appendToReplyEditor(
            `<blockquote class="forums-quoted-post"><p><strong>${escapeHtml(username)} wrote:</strong></p><p>${escapeHtml(excerpt)}</p></blockquote><p><br></p>`
          );
        } else {
          appendToReplyEditor(`<p><strong>@${escapeHtml(username)}</strong>&nbsp;</p>`);
        }

        composer.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });

    document.getElementById('forum-reply-target-clear')?.addEventListener('click', clearReplyTarget);

    document.querySelectorAll('form[method="post"]:not([data-async])').forEach(form => {
      form.addEventListener('submit', () => {
        const btn = form.querySelector('button[type="submit"]');
        if (!btn) return;
        setTimeout(() => {
          btn.disabled = true;
          btn.dataset.originalText = btn.textContent;
          btn.textContent = 'Submitting…';
        }, 0);
      });
    });

    // Reload when the browser restores this page from the back-forward cache
    // (bfcache). Without this, submitting a form and being redirected back to
    // the same URL can result in the browser displaying the stale cached page
    // (with disabled buttons and old content) instead of the fresh response.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        window.location.reload();
      }
    });
  })();
</script>

<!-- Poll Image Enlarge Modal -->
<div class="modal fade" id="pollImageModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bg-transparent border-0 shadow-none">
      <div class="modal-body p-0 text-center position-relative">
