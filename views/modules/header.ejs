<!DOCTYPE html>
<html lang="en">
<head>

  <!-- Basic Page Needs
  ================================================== -->
  <meta charset="utf-8">

  <!-- Mobile Specific Metas
  ================================================== -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Primary Meta Tags -->
  <title><%= pageTitle %></title>
  <meta name="title" content="<%= pageTitle %>">
  <meta name="description" content="<%= pageDescription %> // <%= config.siteConfiguration.tagline %>">
  <meta name="keywords" content="<%= config.siteConfiguration.keywords %>">
  <meta name="author" content="<%= config.siteConfiguration.siteName %>">
  <meta name="theme-color" content="#2f508c">
  <%# GEO: let search + AI answer engines quote and preview freely unless a page opts out %>
  <meta name="robots" content="<%= typeof pageRobots !== 'undefined' && pageRobots ? pageRobots : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1' %>">
  <link rel="canonical" href="<%= config.siteConfiguration.siteUrl %><%= req.url.split('?')[0] %>">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" href="/images/siteLogo.png">
  <link rel="apple-touch-icon" href="/images/siteLogo.png">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= config.siteConfiguration.siteName %>">
  <meta property="og:url" content="<%= config.siteConfiguration.siteUrl %><%= req.url.split('?')[0] %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %> // <%= config.siteConfiguration.tagline %>">
  <meta property="og:image" content="<%= config.siteConfiguration.siteUrl %>/images/meta-siteLogo.png">
  <meta property="og:image:width" content="264">
  <meta property="og:image:height" content="372">
  <meta property="og:image:alt" content="<%= config.siteConfiguration.siteName %> logo">

  <meta property="og:locale" content="en_AU">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary">
  <meta property="twitter:url" content="<%= config.siteConfiguration.siteUrl %><%= req.url.split('?')[0] %>">
  <meta property="twitter:title" content="<%= pageTitle %>">
  <meta property="twitter:description" content="<%= pageDescription %>">
  <meta property="twitter:image" content="<%= config.siteConfiguration.siteUrl %>/images/meta-siteLogo.png">
  <meta property="twitter:image:alt" content="<%= config.siteConfiguration.siteName %> logo">

  <%# Structured data (JSON-LD). Routes that call lib/seo/jsonLd.buildGraph pass a
      ready, <script>-safe string (or an array of them) as `pageJsonLd`, which
      already carries the Organization + WebSite nodes. Pages that don't opt in
      still get a base Organization + WebSite graph so every URL names the
      site's canonical entity for generative engines. %>
  <% if (typeof pageJsonLd !== 'undefined' && pageJsonLd) { %>
    <% (Array.isArray(pageJsonLd) ? pageJsonLd : [pageJsonLd]).forEach(function (block) { %>
  <script type="application/ld+json"><%- typeof block === 'string' ? block : JSON.stringify(block) %></script>
    <% }) %>
  <% } else { %>
  <script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"<%= config.siteConfiguration.siteUrl %>/#organization","name":<%- JSON.stringify(String(config.siteConfiguration.siteName || '')) %>,"url":"<%= config.siteConfiguration.siteUrl %>","description":<%- JSON.stringify(String(config.siteConfiguration.tagline || '')) %>,"logo":{"@type":"ImageObject","url":"<%= config.siteConfiguration.siteUrl %>/images/siteLogo.png"}<% var _sa = Object.values(config.siteConfiguration.platforms || {}).filter(function (v) { return typeof v === 'string' && /^https?:\/\//i.test(v); }); if (config.siteConfiguration.email) { %>,"email":<%- JSON.stringify(String(config.siteConfiguration.email)) %><% } if (_sa.length) { %>,"sameAs":<%- JSON.stringify(_sa) %><% } %>},{"@type":"WebSite","@id":"<%= config.siteConfiguration.siteUrl %>/#website","name":<%- JSON.stringify(String(config.siteConfiguration.siteName || '')) %>,"url":"<%= config.siteConfiguration.siteUrl %>","inLanguage":"en","publisher":{"@id":"<%= config.siteConfiguration.siteUrl %>/#organization"}}]}</script>
  <% } %>

  <script src="https://code.jquery.com/jquery-3.5.1.min.js" integrity="sha384-ZvpUoO/+PpLXR1lu4jmpXWu80pZlYUAfxl5NsBMWOEPSjUn/6Z/hRTt8+pR6L4N2" crossorigin="anonymous"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>

  <!-- SummerNote -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-bs5.min.css" integrity="sha384-hqv27sxmxAI2L4eughLkUpjS75/Z3/hg9DOWIl0PJWE4B6GJqM2Kx72ZPoQzsUpF" crossorigin="anonymous" />
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-bs5.min.js" integrity="sha384-VuY5PEOHfx/+RyPd+UmHCqDU8d9IM8bhIrXbbli+OpDD0A9G/YaovME4NwAzOyxt" crossorigin="anonymous"></script>

  <!-- DataTable -->
  <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.1/css/jquery.dataTables.css">
  <script defer type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.13.1/js/jquery.dataTables.js"></script>

  <!-- Favicon -->
  <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.ico" />
  <link rel="stylesheet" href="/vendors/slick-carousel/slick/slick.css">
  <link rel="stylesheet" href="/vendors/slick-carousel/slick/slick-theme.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" integrity="sha512-MV7K8+y+gLIBoVD59lQIYicR65iaqukzvf/nwasF0nqhPay5w/9lJmVM2hMDcnK1OnMGCdVK+iQrJ7lzPJQd1w==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= config.siteConfiguration.googleTag %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', "<%= config.siteConfiguration.googleTag %>");
  </script>

  <script defer src="https://cdn.jsdelivr.net/gh/zerodevx/zero-md@2/dist/zero-md.legacy.min.js"></script>
</head>

<body id="top" data-authenticated="<%= req.session?.user ? 'true' : 'false' %>">
