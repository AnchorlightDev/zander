<%#
	Play page hero.

	Deliberately holds nothing but the hero: title, one line of intro and the
	two calls to action.  The join instructions, the server addresses and the
	Discord widget used to be nested inside this <section>, where they
	inherited the page's default dark body text on top of a dark blue overlay
	and were close to unreadable -- `.banner .block` only whitens h1/p/span,
	so the h2, ol, li, code and strong in that block kept their dark colours
	and <code> picked up Bootstrap's pink.  They now live in proper light
	sections in play.ejs, where the default colours are the right ones.
%>
<section class="banner hero-overlay" style="background: url(<%= globalImage %>) no-repeat 50% 50%; overflow: hidden; background-size: cover; background-position: center;">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="block text-center">
					<div class="divider mb-3 mx-auto"></div>
					<span class="text-uppercase text-sm letter-spacing"><%= config.siteConfiguration.tagline %></span>
					<h1 class="mb-3 mt-3"><%= config.siteConfiguration.siteName %></h1>
					<p class="mb-4 mx-auto" style="max-width: 640px;">
						Java and Bedrock are both welcome. Grab the address for your edition and you are two minutes from spawning in.
					</p>
					<div class="d-flex flex-wrap gap-2 justify-content-center">
						<a href="#how-to-join" class="btn btn-main btn-round-full">
							<i class="fas fa-gamepad me-2"></i>How to join
						</a>
						<% if (config.siteConfiguration.platforms && config.siteConfiguration.platforms.discord) { %>
						<a href="<%= config.siteConfiguration.platforms.discord %>" target="_blank" rel="noopener" class="btn btn-solid-white btn-round-full">
							<i class="fab fa-discord me-2"></i>Join our Discord
						</a>
						<% } %>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
