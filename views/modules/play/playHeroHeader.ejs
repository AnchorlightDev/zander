<!-- Slider Start -->
<section class="banner hero-overlay" style="background: url(<%= globalImage %>) no-repeat 50% 50%; overflow: hidden; background-size: cover; background-position: center;">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="block">
					<div class="divider mb-3"></div>
					<span class="text-uppercase text-sm letter-spacing "><%= config.siteConfiguration.tagline %></span>
					<h1 class="mb-3 mt-3"><%= config.siteConfiguration.siteName %></h1>
					<br>

					<%# GEO/SEO: an answer-first "how to join" block rendered in the HTML
					    (not only inside disabled inputs) so search + AI engines can
					    extract the server address and the steps. %>
					<div class="how-to-join text-start mx-auto mb-4" style="max-width: 720px;">
						<h2 class="h4 mb-3">How to join <%= config.siteConfiguration.siteName %></h2>
						<% if (typeof servers !== 'undefined' && servers && servers.length) { %>
						<ul class="list-unstyled mb-3">
							<% servers.forEach(function (srv) { %>
							<li class="mb-1"><strong><%= srv.name %>:</strong> <code><%= srv.address %></code></li>
							<% }) %>
						</ul>
						<% } %>
						<ol class="mb-0">
							<li>Open Minecraft (Java or Bedrock Edition) and choose <em>Multiplayer &rarr; Add Server</em>.</li>
							<li>Enter the server address<% if (typeof servers !== 'undefined' && servers && servers.length) { %> shown above<% } %>.</li>
							<li>Save, then select the server and click <em>Join</em>.</li>
							<% if (config.discord && config.siteConfiguration.platforms && config.siteConfiguration.platforms.discord) { %>
							<li>Optional: join the <a href="<%= config.siteConfiguration.platforms.discord %>">community Discord</a> for help and announcements.</li>
							<% } %>
						</ol>
					</div>

					<div class="container">
						<div class="row">
							<div class="col-lg-12">
								<div class="feature-block d-lg-flex text-center justify-content-center">
									<% if (apiData.success == false) { %>
										<%- include("../../partials/alert.ejs", {
										  alertType: "danger",
										  content: apiData.message
										}) %>
									  <% } else { %>
										<% apiData.data.forEach(function (server) { %>
										  <!-- <%= server.displayName %> Server -->
										  	<div class="feature-item mb-5 mb-lg-0">
												<h4 class="mb-3"><%= server.displayName %></h4>
												<input type="text" class="form-control input-default text-center" value="<%= server.serverConnectionAddress %>" disabled>
											</div>
										<% }) %>
									  <% } %>
								</div>
								<br>

								<div class="text-center">
									<h2 class="mb-3 mt-3">Join the Community Discord</h2>
									<iframe src="https://discord.com/widget?id=<%= config.discord.guildId %>&theme=dark" width="350" height="500" allowtransparency="true" frameborder="0" sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"></iframe>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>