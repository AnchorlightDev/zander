<%- include("../../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: pageDescription
}) %>

<%- include("../../modules/navigationBar.ejs") %>

<%- include("../../partials/miniHeader.ejs", {
  headerTitle: "Webstore",
  backgroundImage: globalImage
}) %>

<section class="section">
  <div class="container">

    <% if (req.cookies.alertType) { %>
    <%- include("../../partials/alert.ejs", {
        alertType: req.cookies.alertType,
        content: req.cookies.alertContent
    }) %>
    <% } %>
    <%# Welcome / login prompt -%>
    <div class="mb-4">
      <% if (loggedIn) { %>
        <h3 class="mb-1">Welcome, <strong><%= username %></strong></h3>
        <p class="text-muted mb-0">
          All purchases are linked to your Minecraft account.
          <a href="/webstore/history" class="ms-2">View purchase history &rarr;</a>
        </p>
      <% } else { %>
        <h3>Webstore</h3>
        <p class="text-muted mb-2">Log in to purchase or gift an item.</p>
        <a href="/login?returnTo=/webstore" class="btn btn-outline-primary btn-sm">Log in to buy</a>
      <% } %>
    </div>

    <%# Product grid -%>
    <div class="row g-4">
      <% if (itemsError) { %>
        <div class="col-12">
          <div class="alert alert-warning">Webstore items are temporarily unavailable. Please try again shortly.</div>
        </div>
      <% } else if (!items || !items.length) { %>
        <div class="col-12">
          <div class="alert alert-info">The webstore is being stocked — check back soon!</div>
        </div>
      <% } %>

      <% items.forEach(function (item) { %>
        <div class="col-lg-4 col-md-6 col-sm-12">
          <div class="card h-100 shadow-sm" id="ws-<%= item.slug %>">
            <% if (item.imageUrl) { %>
              <img src="<%= item.imageUrl %>" alt="<%= item.displayName %>" class="card-img-top" style="height:160px; object-fit:contain; padding:16px;">
            <% } %>
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title mb-0"><%= item.displayName %></h5>
                <span class="badge <%= item.purchaseType === 'subscription' ? 'bg-primary' : 'bg-success' %> ms-2 flex-shrink-0">
                  <%= item.badgeLabel %>
                </span>
              </div>
              <% if (item.description) { %>
                <p class="card-text text-muted flex-grow-1"><%= item.description %></p>
              <% } %>
              <div class="mt-auto">
                <p class="fs-5 fw-bold mb-3">
                  <%= item.priceDisplay %>
                  <% if (item.purchaseType === 'subscription') { %>
                    <small class="text-muted fw-normal fs-6">/ month</small>
                  <% } %>
                </p>
                <% if (loggedIn) { %>
                  <button
                    type="button"
                    class="btn btn-primary btn-sm w-100"
                    data-bs-toggle="modal"
                    data-bs-target="#purchaseModal"
                    data-item-slug="<%= item.slug %>"
                    data-item-name="<%= item.displayName %>"
                    data-item-type="<%= item.purchaseType %>"
                    data-item-action="<%= item.purchaseLabel %>"
                  >
                    <%= item.purchaseLabel %>
                  </button>
                <% } else { %>
                  <a href="/login?returnTo=/webstore" class="btn btn-outline-primary btn-sm w-100">Log in to purchase</a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <%# Purchase / gift modal (shown only when logged in) -%>
    <% if (loggedIn) { %>
      <div class="modal fade" id="purchaseModal" tabindex="-1" aria-labelledby="purchaseModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <form method="post" action="/webstore/checkout" class="modal-content" id="purchaseForm">
            <div class="modal-header">
              <h5 class="modal-title" id="purchaseModalLabel">Complete Purchase</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="itemSlug" id="modalItemSlug">

              <%# Subscription info banner -%>
              <div id="subscriptionNotice" class="alert alert-info d-none mb-3">
                <strong>Subscription:</strong> This is a recurring monthly charge.
                You can cancel at any time from your Stripe customer portal.
              </div>

              <%# Who is this for? -%>
              <div class="mb-3">
                <label class="form-label fw-semibold">Who is this for?</label>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="purchaseFor"
                    id="purchaseForSelf" value="self" checked>
                  <label class="form-check-label" for="purchaseForSelf">
                    My account &mdash; <strong><%= username %></strong>
                  </label>
                </div>
                <div class="form-check" id="giftRadioWrapper">
                  <input class="form-check-input" type="radio" name="purchaseFor"
                    id="purchaseForGift" value="gift">
                  <label class="form-check-label" for="purchaseForGift">
                    Gift to another player
                  </label>
                </div>
              </div>

              <%# Gift recipient input (hidden until "Gift" selected) -%>
              <div id="giftSection" class="d-none">
                <div class="mb-1">
                  <label for="recipientUsername" class="form-label fw-semibold">Recipient Minecraft username</label>
                  <input
                    type="text"
                    name="recipientUsername"
                    id="recipientUsername"
                    class="form-control"
                    placeholder="e.g. Notch"
                    maxlength="16"
                    autocomplete="off"
                  >
                </div>
                <div id="giftSuggestions" class="list-group mt-1 mb-2"></div>
                <small class="text-muted">Enter the exact Minecraft username of the player you want to gift.</small>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary" id="modalSubmitBtn">Continue to Payment</button>
            </div>
          </form>
        </div>
      </div>

      <script>
        (function () {
          const modal = document.getElementById("purchaseModal");
          if (!modal) return;

          const itemSlugInput    = document.getElementById("modalItemSlug");
          const modalLabel       = document.getElementById("purchaseModalLabel");
          const submitBtn        = document.getElementById("modalSubmitBtn");
          const selfRadio        = document.getElementById("purchaseForSelf");
          const giftRadio        = document.getElementById("purchaseForGift");
          const giftSection      = document.getElementById("giftSection");
          const recipientInput   = document.getElementById("recipientUsername");
          const giftSuggestions  = document.getElementById("giftSuggestions");
          const subscriptionNote = document.getElementById("subscriptionNotice");

          // Populate modal when triggered by a product button
          modal.addEventListener("show.bs.modal", function (e) {
            const btn = e.relatedTarget;
            if (!btn) return;

            const slug   = btn.dataset.itemSlug   || "";
            const name   = btn.dataset.itemName   || "item";
            const type   = btn.dataset.itemType   || "one_time";
            const action = btn.dataset.itemAction || "Continue to Payment";

            itemSlugInput.value       = slug;
            modalLabel.textContent    = `Purchase ${name}`;
            submitBtn.textContent     = action;

            // Reset form state
            selfRadio.checked = true;
            giftSection.classList.add("d-none");
            recipientInput.removeAttribute("required");
            recipientInput.value = "";
            clearSuggestions();

            const isSubscription = type === "subscription";

            // Show subscription notice if applicable
            if (subscriptionNote) {
              subscriptionNote.classList.toggle("d-none", !isSubscription);
            }
          });

          // Toggle gift section visibility
          function updateGiftSection() {
            const isGift = giftRadio.checked;
            giftSection.classList.toggle("d-none", !isGift);
            if (isGift) {
              recipientInput.setAttribute("required", "required");
              recipientInput.focus();
            } else {
              recipientInput.removeAttribute("required");
              recipientInput.value = "";
              clearSuggestions();
            }
          }

          selfRadio.addEventListener("change", updateGiftSection);
          giftRadio.addEventListener("change", updateGiftSection);

          // Username typeahead against registered users
          function clearSuggestions() {
            if (giftSuggestions) giftSuggestions.innerHTML = "";
          }

          function renderSuggestions(results) {
            clearSuggestions();
            if (!results || !results.length) return;
            results.forEach(function (user) {
              const btn = document.createElement("button");
              btn.type = "button";
              btn.className = "list-group-item list-group-item-action d-flex align-items-center gap-2 py-2";

              if (user.avatarUrl) {
                const img = document.createElement("img");
                img.src = user.avatarUrl;
                img.alt = user.username;
                img.width = 28;
                img.height = 28;
                img.className = "rounded";
                btn.appendChild(img);
              }

              const label = document.createElement("span");
              label.textContent = user.username;
              btn.appendChild(label);

              btn.addEventListener("click", function () {
                recipientInput.value = user.username;
                clearSuggestions();
              });

              giftSuggestions.appendChild(btn);
            });
          }

          let searchTimeout;
          recipientInput.addEventListener("input", function () {
            clearTimeout(searchTimeout);
            const term = (recipientInput.value || "").trim();
            if (term.length < 2) { clearSuggestions(); return; }
            searchTimeout = setTimeout(async function () {
              try {
                const res = await fetch(`/support/users/search?q=${encodeURIComponent(term)}`);
                if (!res.ok) { clearSuggestions(); return; }
                const data = await res.json();
                renderSuggestions(data.results || []);
              } catch {
                clearSuggestions();
              }
            }, 250);
          });
        })();
      </script>
    <% } %>

  </div>
</section>

<script>
(function () {
  var hash = window.location.hash;
  if (!hash || !hash.startsWith('#ws-')) return;
  var target = document.getElementById(hash.slice(1));
  if (!target) return;
  // Small delay so the page is fully painted before scrolling
  setTimeout(function () {
    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    target.style.transition = 'box-shadow 0.3s ease';
    target.style.boxShadow = '0 0 0 3px var(--bs-primary)';
    setTimeout(function () { target.style.boxShadow = ''; }, 2000);
  }, 200);
})();
</script>

<%- include("../../modules/footer.ejs") %>
