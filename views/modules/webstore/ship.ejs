<%- include("../../modules/header.ejs", {
    pageTitle: pageTitle,
    pageDescription: pageDescription
}) %>

<%- include("../../modules/navigationBar.ejs") %>

<%- include("../../partials/miniHeader.ejs", {
  headerTitle: "Shipping details",
  backgroundImage: globalImage
}) %>

<section class="section">
  <div class="container">

    <% if (req.cookies.alertType) { %>
    <%- include("../../partials/alert.ejs", {
        alertType: req.cookies.alertType,
        content: req.cookies.alertContent
    }) %>
    <% } %>

    <div class="row justify-content-center">
      <div class="col-lg-7">

        <div class="card shadow-sm mb-4">
          <div class="card-body d-flex align-items-center gap-3">
            <% if (item.imageUrl) { %>
              <img src="<%= item.imageUrl %>" alt="<%= item.displayName %>"
                   style="width:64px;height:64px;object-fit:cover;border-radius:.5rem;">
            <% } %>
            <div>
              <h5 class="mb-1"><%= item.displayName %></h5>
              <div class="text-muted"><%= priceLabel %> + shipping</div>
            </div>
          </div>
        </div>

        <p class="text-muted mb-4">
          Enter where you'd like this shipped. We'll calculate the exact shipping
          cost for your address and show the total on the next step before you pay.
        </p>

        <form method="post" action="/webstore/checkout" novalidate>
          <input type="hidden" name="itemSlug" value="<%= item.slug %>">

          <div class="mb-3">
            <label for="shipName" class="form-label">Full name</label>
            <input type="text" class="form-control" id="shipName" name="shipName"
                   value="<%= prefill.name || '' %>" required maxlength="120">
          </div>

          <div class="mb-3">
            <label for="shipEmail" class="form-label">Email</label>
            <input type="email" class="form-control" id="shipEmail" name="shipEmail"
                   value="<%= prefill.email || '' %>" required maxlength="190">
            <div class="form-text">For your order confirmation and shipping updates.</div>
          </div>

          <div class="mb-3">
            <label for="shipAddress1" class="form-label">Address line 1</label>
            <input type="text" class="form-control" id="shipAddress1" name="shipAddress1" required maxlength="190">
          </div>

          <div class="mb-3">
            <label for="shipAddress2" class="form-label">Address line 2 <span class="text-muted">(optional)</span></label>
            <input type="text" class="form-control" id="shipAddress2" name="shipAddress2" maxlength="190">
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="shipCity" class="form-label">City / suburb</label>
              <input type="text" class="form-control" id="shipCity" name="shipCity" required maxlength="120">
            </div>
            <div class="col-md-6 mb-3">
              <label for="shipRegion" class="form-label">State / region</label>
              <input type="text" class="form-control" id="shipRegion" name="shipRegion" maxlength="120">
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="shipZip" class="form-label">Postcode / ZIP</label>
              <input type="text" class="form-control" id="shipZip" name="shipZip" required maxlength="32">
            </div>
            <div class="col-md-6 mb-3">
              <label for="shipCountry" class="form-label">Country</label>
              <input type="text" class="form-control text-uppercase" id="shipCountry" name="shipCountry"
                     list="countryList" required maxlength="2" placeholder="AU"
                     pattern="[A-Za-z]{2}">
              <datalist id="countryList">
                <option value="AU">Australia</option>
                <option value="NZ">New Zealand</option>
                <option value="US">United States</option>
                <option value="GB">United Kingdom</option>
                <option value="CA">Canada</option>
                <option value="IE">Ireland</option>
              </datalist>
              <div class="form-text">Two-letter country code.</div>
            </div>
          </div>

          <div class="mb-4">
            <label for="shipPhone" class="form-label">Phone <span class="text-muted">(optional)</span></label>
            <input type="tel" class="form-control" id="shipPhone" name="shipPhone" maxlength="40">
            <div class="form-text">Some couriers need this for delivery.</div>
          </div>

          <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary">Continue to payment</button>
            <a href="/webstore" class="btn btn-outline-secondary">Back to Webstore</a>
          </div>
        </form>

      </div>
    </div>

  </div>
</section>

<%- include("../../modules/footer.ejs") %>
